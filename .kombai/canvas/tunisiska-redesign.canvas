      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap');\n*{box-sizing:border-box}body{margin:0}.web{font:400 16px Rubik,Arial,sans-serif;color:#101828;background:#f3f5f8;min-height:100vh;overflow:hidden}.shell{width:min(1240px,calc(100% - 64px));margin:auto}.nav{height:76px;background:rgba(255,255,255,.96);border-bottom:1px solid #e2e8f0;display:flex;align-items:center;position:relative;z-index:5}.navin{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:#132b55;font-weight:700;font-size:16px}.brand img{width:44px;height:44px;object-fit:contain;border-radius:12px}.links{display:flex;align-items:center;gap:27px;color:#58677f;font-size:13px}.links a{color:inherit;text-decoration:none}.links a:hover{color:#f2761b}.navstore{background:#132b55;color:#fff;border-radius:12px;padding:10px 16px;text-decoration:none;font-size:13px;font-weight:600}.hero{padding:46px 0 52px;background:radial-gradient(ellipse at 77% 30%,rgba(19,43,85,.08),transparent 38%),linear-gradient(#fff,#f3f5f8)}.hero-grid{min-height:525px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.eyebrow{display:inline-flex;align-items:center;gap:10px;padding:9px 14px;border:1px solid #dce4ef;background:#fff;border-radius:999px;color:#132b55;font-size:12px;font-weight:600}.dot{width:8px;height:8px;background:#f2761b;border-radius:50%;box-shadow:0 0 0 4px #fff2e8}.hero h1{font-size:66px;line-height:1.03;letter-spacing:-.045em;margin:23px 0 18px;max-width:590px}.hero p{color:#58677f;font-size:18px;line-height:1.6;max-width:540px;margin:0}.stores{display:flex;gap:11px;margin-top:28px}.store{display:flex;align-items:center;gap:11px;padding:11px 13px;min-width:190px;min-height:58px;background:#132b55;color:#fff;border-radius:14px;box-shadow:0 7px 16px #132b5520;text-decoration:none}.store .ico{font-size:24px}.store small,.store b{display:block;line-height:1.15}.store small{font-size:10px;color:#d8e1f0}.store b{font-size:14px;margin-top:3px}.browse{display:inline-flex;align-items:center;gap:9px;margin-top:20px;text-decoration:none;color:#132b55;font-weight:600;font-size:14px}.browse i{color:#f2761b;font-style:normal;font-size:20px}.visual{height:545px;position:relative;display:flex;align-items:center;justify-content:center}.halo{position:absolute;width:450px;height:450px;border-radius:50%;background:linear-gradient(145deg,#e6ebf3,#f7f8fb);border:1px solid #e2e8f0}.phone{position:absolute;padding:6px;background:#111827;border:1px solid #fff;border-radius:37px;overflow:hidden;box-shadow:0 24px 45px #12244533;line-height:0}.phone img{width:100%;height:100%;object-fit:cover;border-radius:30px}.phone-main{width:292px;z-index:2;transform:translate(-24px,-4px)}.phone-side{width:180px;z-index:1;transform:translate(143px,71px) rotate(7deg)}.routecard{position:absolute;z-index:3;left:0;bottom:32px;width:278px;padding:13px 15px;background:#fff;border:1px solid #e5eaf1;border-radius:18px;box-shadow:0 15px 32px #10182820}.routebrand{display:flex;align-items:center;gap:9px;color:#58677f;font-size:11px}.routebrand img{width:31px;height:31px;border-radius:8px}.routeway{display:flex;justify-content:space-between;align-items:center;margin-top:10px;color:#101828;font-weight:600;font-size:13px}.routeway em{color:#f2761b;font-style:normal}.routefoot{padding-top:8px;margin-top:8px;border-top:1px solid #edf0f5;color:#58677f;font-size:10px}.strip{display:flex;align-items:center;gap:13px;max-width:590px;padding:15px 17px;background:#fff;border:1px solid #e4e9f0;border-radius:16px;box-shadow:0 9px 24px #1018280e}.strip-icon{display:grid;place-items:center;width:40px;height:40px;background:#fff2e8;color:#f2761b;border-radius:13px;font-size:20px}.strip b{display:block;font-size:13px}.strip small{display:block;margin-top:3px;color:#58677f;font-size:11px}.section{padding:78px 0}.heading{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:28px}.kicker{color:#d76511;text-transform:uppercase;letter-spacing:.08em;font-size:10px;font-weight:700}.heading h2{font-size:38px;letter-spacing:-.035em;margin:9px 0 0}.heading p{max-width:420px;color:#58677f;font-size:14px;line-height:1.6;margin:0}.services{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.service{min-height:210px;background:#fff;border:1px solid #e4e9f0;border-radius:21px;padding:21px;box-shadow:0 7px 20px #10182809}.service-icon{width:44px;height:44px;border-radius:14px;background:#fff2e8;color:#f2761b;display:grid;place-items:center;font-size:20px}.service:nth-child(even) .service-icon{background:#eff3f9;color:#132b55}.service h3{font-size:16px;margin:17px 0 7px}.service p{font-size:12px;color:#58677f;line-height:1.6;margin:0}.screens{background:#fff;border-block:1px solid #e7ecf2}.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:23px}.screen{padding:5px;background:#111827;border-radius:30px;box-shadow:0 17px 32px #132b5520;overflow:hidden;line-height:0}.screen img{width:100%;aspect-ratio:1290/2796;object-fit:cover;border-radius:25px}.caption{text-align:center;font-weight:600;color:#101828;font-size:13px;margin:12px 0 0}.cta{margin:0 0 70px;padding:43px 48px;background:linear-gradient(125deg,#10264d,#1a3768);color:#fff;border-radius:28px;display:flex;align-items:center;justify-content:space-between;gap:35px;box-shadow:0 21px 45px #132b5530}.cta h2{font-size:35px;letter-spacing:-.035em;margin:8px 0}.cta p{color:#d7e0ef;margin:0;font-size:14px}.cta .store{background:#fff;color:#101828;box-shadow:none}.cta .store small{color:#58677f}.foot{border-top:1px solid #e2e8f0;background:#fff;padding:23px 0;color:#58677f;font-size:12px}.footin{display:flex;align-items:center;justify-content:space-between}.footbrand{display:flex;align-items:center;gap:8px;color:#132b55;font-weight:600}.footbrand img{width:30px;height:30px}.foot-links{display:flex;gap:18px}@media(max-width:900px){.links{display:none}.hero-grid{grid-template-columns:1fr .88fr;gap:24px}.hero h1{font-size:52px}.visual{height:470px}.halo{width:350px;height:350px}.phone-main{width:255px}.phone-side{width:152px;transform:translate(120px,64px) rotate(7deg)}.routecard{width:240px}.services{grid-template-columns:repeat(2,1fr)}.gallery{grid-template-columns:repeat(4,minmax(170px,1fr));overflow:auto}.cta{align-items:flex-start;flex-direction:column}}@media(max-width:650px){.shell{width:calc(100% - 34px)}.hero{padding:34px 0 38px}.hero-grid{display:flex;flex-direction:column;align-items:stretch;gap:12px;min-height:0}.hero h1{font-size:43px}.hero p{font-size:15px}.stores{gap:8px}.store{min-width:0;flex:1;padding:9px;gap:7px}.store b{font-size:12px}.store small{font-size:9px}.visual{height:410px;margin-top:0}.halo{width:330px;height:330px}.phone-main{width:230px}.phone-side{width:135px;transform:translate(105px,57px) rotate(7deg)}.routecard{bottom:0;left:0;width:235px}.strip{margin-top:16px}.section{padding:58px 0}.heading{display:block}.heading h2{font-size:31px}.heading p{margin-top:11px}.services{gap:10px}.service{min-height:195px;padding:16px}.service h3{font-size:14px}.service p{font-size:11px}.gallery{grid-template-columns:repeat(4,minmax(63vw,1fr));gap:12px}.cta{padding:25px 20px;border-radius:22px}.cta h2{font-size:29px}.cta .stores{width:100%}.footin{align-items:flex-start;flex-direction:column;gap:14px}}\n</style>\n<div class=\"web\">\n<header class=\"nav\"><div class=\"shell navin\"><a class=\"brand\" href=\"#top\"><img src=\"data:image/png;base64,\" alt=\"Tunisiska Mega logo\"><span>Tunisiska Mega</span></a><nav class=\"links\"><a href=\"#top\">Home</a><a href=\"#services\">Services</a><a href=\"#screens\">The app</a><a href=\"/about\">About</a><a href=\"/contact\">Contact</a></nav><a class=\"navstore\" href=\"#download\">Get the app</a></div></header>\n<section class=\"hero\" id=\"top\"><div class=\"shell hero-grid\"><div><span class=\"eyebrow\"><i class=\"dot\"></i>The route between home and family, made simpler</span><h1>Sweden and Tunisia, closer together.</h1><p>Explore cargo van departures, send a parcel, and discover everyday services in one app.</p><div class=\"stores\"><a class=\"store\" href=\"https://apps.apple.com/tn/app/tunsiska-mega-services/id6765942795\"><span class=\"ico\"></span><span><small>Download on the</small><b>App Store</b></span></a><a class=\"store\" href=\"https://play.google.com/store/apps/details?id=com.alcatrazdev.tunisiskaservices\"><span class=\"ico\">▶</span><span><small>Get it on</small><b>Google Play</b></span></a></div><a class=\"browse\" href=\"#services\">Explore services <i>→</i></a></div><div class=\"visual\"><div class=\"halo\"></div><div class=\"phone phone-main\"><img src=\"data:image/webp;base64,\" alt=\"Real Tunisiska app home screen\"></div><div class=\"phone phone-side\"><img src=\"data:image/webp;base64,\" alt=\"Real Tunisiska trip details screen\"></div><div class=\"routecard\"><div class=\"routebrand\"><img src=\"data:image/png;base64,\" alt=\"\"><span>One connected route</span></div><div class=\"routeway\"><span>SE · Sweden</span><em>↔</em><span>TN · Tunisia</span></div><div class=\"routefoot\">Plan your next cargo van trip</div></div></div></div><div class=\"shell strip\"><div class=\"strip-icon\">↔</div><div><b>Sweden ↔ Tunisia</b><small>Explore trips and services in the app</small></div></div></section>\n<section id=\"services\" class=\"section\"><div class=\"shell\"><div class=\"heading\"><div><span class=\"kicker\">One app, many ways to move</span><h2>Everything you need,<br>one tap away.</h2></div><p>Explore shipping, home services, taxi and container transport with the same clear experience you know from the app.</p></div><div class=\"services\"><article class=\"service\"><span class=\"service-icon\">□</span><h3>Shipping &amp; Delivery</h3><p>Track parcels across the Sweden–Tunisia route.</p></article><article class=\"service\"><span class=\"service-icon\">✦</span><h3>Home Cleaning</h3><p>Find cleaning services for your home or office.</p></article><article class=\"service\"><span class=\"service-icon\">⌖</span><h3>Taxi Services</h3><p>Explore local transportation and airport trips.</p></article><article class=\"service\"><span class=\"service-icon\">▣</span><h3>Container Shipping</h3><p>Explore container shipping options for larger loads.</p></article></div></div></section>\n<section id=\"screens\" class=\"section screens\"><div class=\"shell\"><div class=\"heading\"><div><span class=\"kicker\">Made for the journey</span><h2>A closer look at the app.</h2></div><p>Browse trips, review capacity, and keep up with service updates in a clear, familiar interface.</p></div><div class=\"gallery\"><article><div class=\"screen\"><img src=\"data:image/webp;base64,\" alt=\"Real trip details screen\"></div><div class=\"caption\">Trip details</div></article><article><div class=\"screen\"><img src=\"data:image/webp;base64,\" alt=\"Real departure calendar screen\"></div><div class=\"caption\">Departure dates</div></article><article><div class=\"screen\"><img src=\"data:image/webp;base64,\" alt=\"Real news and updates screen\"></div><div class=\"caption\">News and updates</div></article><article><div class=\"screen\"><img src=\"data:image/webp;base64,\" alt=\"Real announcement feed screen\"></div><div class=\"caption\">App announcements</div></article></div></div></section>\n<section id=\"download\" class=\"shell cta\"><div><span class=\"kicker\" style=\"color:#ffb576\">Start with the app</span><h2>Ready for the next trip?</h2><p>Choose your store and explore the services available on your route.</p></div><div class=\"stores\"><a class=\"store\" href=\"https://apps.apple.com/tn/app/tunsiska-mega-services/id6765942795\"><span class=\"ico\"></span><span><small>Download on the</small><b>App Store</b></span></a><a class=\"store\" href=\"https://play.google.com/store/apps/details?id=com.alcatrazdev.tunisiskaservices\"><span class=\"ico\">▶</span><span><small>Get it on</small><b>Google Play</b></span></a></div></section>\n<footer class=\"foot\"><div class=\"shell footin\"><div class=\"footbrand\"><img src=\"data:image/png;base64,\" alt=\"\">Tunisiska Mega Services</div><div class=\"foot-links\"><a href=\"/privacy\">Privacy</a><a href=\"/terms\">Terms</a><a href=\"/press\">News</a></div><span>Sweden ↔ Tunisia</span></div></footer></div>"
