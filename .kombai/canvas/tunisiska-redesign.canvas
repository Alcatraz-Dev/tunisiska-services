      "html": "\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap');\n*{box-sizing:border-box}body{margin:0}.rk{font-family:Rubik,system-ui,sans-serif;color:#0C1626;-webkit-font-smoothing:antialiased}\n:root{--navy:#132B55;--navy2:#1E3E75;--orange:#F2761B;--ink:#0C1626;--muted:#55627A;--soft:#8A97AC;--line:#E4E9F0;--canvas:#F4F6FA;--surface:#fff;--radius:20px}\n.i{width:18px;height:18px;display:inline-block;vertical-align:middle}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8A97AC}.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:0 2px 8px rgba(6,16,31,.05)}\n</style>\n\n<div class=\"rk\" style=\"width:1280px;min-height:900px;background:#F4F6FA;padding:42px 56px\" data-kid=\"1\" data-name=\"Trip widget canvas board\">\n<header style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:28px\" data-kid=\"1-1\" data-name=\"Widget board header\"><div data-kid=\"auto-10\"><p class=\"eyebrow\" style=\"margin:0\" data-kid=\"auto-11\">TRIP WIDGETS</p><h1 style=\"font-size:31px;letter-spacing:-.7px;margin:8px 0 0\" data-kid=\"auto-12\">Your next trip, one glance away.</h1></div><span style=\"background:#fff;border:1px solid #E4E9F0;border-radius:99px;padding:9px 13px;color:#55627A;font-size:11px;font-weight:600\" data-kid=\"auto-13\">HOME SCREEN CONCEPT</span></header>\n<p style=\"color:#55627A;font-size:14px;line-height:1.6;margin:0 0 28px;max-width:630px\" data-kid=\"auto-14\">A compact and a medium widget use the same Tunisiska route card, navy typography and orange departure accent.</p>\n<div style=\"display:grid;grid-template-columns:390px 1fr;gap:32px;align-items:start\" data-kid=\"auto-15\">\n<div style=\"width:350px;background:#101827;padding:10px;border-radius:40px;box-shadow:0 22px 44px rgba(12,22,38,.16)\" data-kid=\"1-2\" data-name=\"Home Screen device preview\"><div style=\"height:690px;border-radius:32px;background:linear-gradient(160deg,#A6BBD0,#647F99 54%,#334960);padding:20px 17px;overflow:hidden\" data-kid=\"auto-16\"><div style=\"display:flex;justify-content:space-between;color:#fff;font-size:11px;font-weight:600\" data-kid=\"auto-17\"><span data-kid=\"auto-18\">9:41</span><span data-kid=\"auto-19\"><svg width=\"48\" height=\"14\" viewBox=\"0 0 48 14\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M1 12V9h3v3H1Zm5 0V6h3v6H6Zm5 0V3h3v9h-3Z\"/><path d=\"M19 5.2a7.1 7.1 0 0 1 10 0M21.5 7.8a3.6 3.6 0 0 1 5 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"24\" cy=\"10.5\" r=\".9\"/><rect x=\"34\" y=\"3\" width=\"11\" height=\"8\" rx=\"1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><rect x=\"36\" y=\"5\" width=\"7\" height=\"4\"/></svg></span></div><div style=\"text-align:center;color:#fff;margin-top:52px\" data-kid=\"auto-20\"><div style=\"font-size:54px;font-weight:500;letter-spacing:-2px\" data-kid=\"auto-21\">9:41</div><div style=\"font-size:13px;margin-top:8px\" data-kid=\"auto-22\">Saturday, 15 November</div></div><div style=\"margin:58px 0 0;text-align:center;color:rgba(255,255,255,.75);font-size:11px;font-weight:600;letter-spacing:.12em\" data-kid=\"auto-23\">TUNISISKA MEGA</div>\n<div style=\"margin-top:12px;padding:14px;border-radius:21px;background:#fff;box-shadow:0 12px 26px rgba(12,22,38,.16)\" data-kid=\"1-2-1\" data-name=\"Medium trip widget on device\"><div style=\"display:flex;align-items:center;gap:8px\" data-kid=\"auto-24\"><span style=\"width:7px;height:7px;background:#F2761B;border-radius:50%\" data-kid=\"auto-25\"></span><span style=\"font-size:9px;font-weight:700;letter-spacing:.12em;color:#8A97AC\" data-kid=\"auto-26\">NEXT DEPARTURE</span><span style=\"margin-left:auto;font-size:10px;font-weight:700;color:#132B55\" data-kid=\"auto-27\">IN 5 DAYS</span></div><div style=\"font-size:16px;font-weight:700;margin-top:11px\" data-kid=\"auto-28\">Sweden <span style=\"color:#F2761B\" data-kid=\"auto-29\">→</span> Tunisia</div><div style=\"display:flex;align-items:center;gap:5px;margin-top:6px;font-size:10px;color:#55627A\" data-kid=\"auto-30\"><span data-kid=\"auto-31\">Stockholm → Tunis</span><span style=\"margin-left:auto\" data-kid=\"auto-32\">15 Nov · 14:00</span></div><div style=\"height:1px;background:#E4E9F0;margin:11px 0 9px\" data-kid=\"auto-33\"></div><div style=\"display:flex;align-items:center;gap:6px;color:#132B55;font-size:10px;font-weight:600\" data-kid=\"auto-34\"><svg class=\"i\" style=\"width:14px;height:14px\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-35\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg> Cargo van <span style=\"margin-left:auto;color:#8A97AC;font-weight:500\" data-kid=\"auto-36\">24 spaces available</span></div></div>\n<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:14px\" data-kid=\"auto-37\"><div style=\"height:146px;border-radius:21px;background:rgba(255,255,255,.96);padding:14px;box-shadow:0 10px 24px rgba(12,22,38,.12)\" data-kid=\"1-2-2\" data-name=\"Small trip widget on device\"><div style=\"width:30px;height:30px;border-radius:10px;background:#FFF4EC;color:#F2761B;display:grid;place-items:center\" data-kid=\"auto-38\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-39\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><div style=\"font-size:9px;color:#8A97AC;font-weight:700;letter-spacing:.1em;margin-top:10px\" data-kid=\"auto-40\">NEXT TRIP</div><div style=\"font-size:11px;font-weight:700;margin-top:5px\" data-kid=\"auto-41\">15 Nov · 14:00</div><div style=\"font-size:10px;color:#55627A;margin-top:4px\" da