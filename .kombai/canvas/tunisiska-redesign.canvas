      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap');\n*{box-sizing:border-box}body{margin:0}\n.rk{font-family:Rubik,system-ui,sans-serif;color:#0C1626;-webkit-font-smoothing:antialiased}\n:root{--navy:#132B55;--orange:#F2761B;--ink:#0C1626;--muted:#55627A;--line:#E4E9F0;--canvas:#F4F6FA}\n.i{display:inline-block;vertical-align:middle}\n.eyebrow{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8A97AC}\n.card{background:#fff;border:1px solid #E4E9F0;border-radius:18px;box-shadow:0 2px 8px rgba(6,16,31,.05)}\n.wpill{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:8px 12px;background:#fff;border:1px solid #E4E9F0;font-size:11px;font-weight:600;color:#55627A}\n.wpill b{color:#132B55;font-weight:700}\n.spec{display:flex;gap:8px;font-size:11.5px;color:#55627A;line-height:1.45;margin-top:8px}\n.dot{width:5px;height:5px;border-radius:50%;background:#F2761B;flex:0 0 auto;margin-top:6px}\n.chip{font-size:10px;font-weight:700;border-radius:99px;padding:6px 10px;display:inline-block}\n</style>\n<div class=\"rk\" style=\"width:1280px;min-height:990px;background:#F4F6FA;padding:42px 56px\" data-kid=\"1\" data-name=\"Android widget board\">\n\n  <header style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:26px\" data-kid=\"1-1\" data-name=\"Board header\">\n    <div style=\"display:flex;align-items:center;gap:14px\" data-kid=\"1-1-1\">\n      <div style=\"width:42px;height:42px;border-radius:14px;background:#132B55;display:grid;place-items:center;color:#fff\" data-kid=\"1-1-1-1\">\n        <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"6\" y=\"2.5\" width=\"12\" height=\"19\" rx=\"2.5\"/>\n          <path d=\"M9.5 18.5h5\"/>\n        </svg>\n      </div>\n      <div data-kid=\"1-1-1-2\">\n        <div style=\"font-size:18px;font-weight:700\">Android widgets</div>\n        <div style=\"font-size:12px;color:#55627A;margin-top:2px\">Glance / RemoteViews · 2 × 2, 4 × 2 and 4 × 4 with light and dark containers</div>\n      </div>\n    </div>\n    <div style=\"display:flex;gap:8px\" data-kid=\"1-1-2\">\n      <span class=\"wpill\"><b>110</b> dp 2 × 2</span>\n      <span class=\"wpill\"><b>250 × 110</b> dp 4 × 2</span>\n      <span class=\"wpill\"><b>250</b> dp 4 × 4</span>\n      <span class=\"wpill\" style=\"background:#FFF4EC;border-color:#FFE7D4;color:#D65E0A;font-weight:700\">NEW · NOT BUILT YET</span>\n    </div>\n  </header>\n\n  <div style=\"display:grid;grid-template-columns:352px 1fr;gap:34px;align-items:start\" data-kid=\"1-2\">\n\n    <div style=\"width:352px;background:#0E1522;padding:10px;border-radius:34px;box-shadow:0 24px 50px rgba(12,22,38,.18)\" data-kid=\"1-2-1\" data-name=\"Pixel launcher with 4x2 and 2x2 widgets\">\n      <div style=\"height:742px;border-radius:26px;background:linear-gradient(170deg,#2F5A63 0%,#22414C 42%,#152A38 100%);padding:16px 15px;position:relative;overflow:hidden\">\n\n        <div style=\"display:flex;justify-content:space-between;align-items:center;color:#fff;font-size:11px;font-weight:600\" data-kid=\"auto-10\">\n          <span>9:41</span>\n          <div style=\"display:flex;align-items:center;gap:5px;opacity:.9\">\n            <svg width=\"12\" height=\"11\" viewBox=\"0 0 24 22\" fill=\"currentColor\"><path d=\"M2 20h3v2H2zM8 15h3v7H8zM14 10h3v12h-3zM20 4h3v18h-3z\"/></svg>\n            <svg width=\"12\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 16a13 13 0 0 1 18 0M6.5 19.5a8 8 0 0 1 11 0\"/></svg>\n            <svg width=\"17\" height=\"11\" viewBox=\"0 0 24 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><rect x=\"1\" y=\"2\" width=\"18\" height=\"10\" rx=\"2.4\"/><rect x=\"3\" y=\"4\" width=\"12\" height=\"6\" fill=\"currentColor\" stroke=\"none\"/></svg>\n          </div>\n        </div>\n\n        <div style=\"margin-top:10px;font-size:10px;color:rgba(255,255,255,.78);font-weight:600\" data-kid=\"auto-11\">Sat, 15 Nov</div>\n\n        <div style=\"height:126px;border-radius:28px;background:linear-gradient(150deg,#1E4278,#132B55 58%,#0E2040);padding:14px 15px;color:#fff;margin-top:10px;box-shadow:0 10px 22px rgba(6,16,31,.28);display:flex;gap:12px\" data-kid=\"1-2-1-1\" data-name=\"Android 4x2 widget\">\n          <div style=\"flex:1;display:flex;flex-direction:column\">\n            <div style=\"display:flex;align-items:center;gap:6px\" data-kid=\"auto-12\">\n              <span style=\"width:6px;height:6px;border-radius:50%;background:#F2761B\"></span>\n              <span style=\"font-size:8px;font-weight:700;letter-spacing:.12em;color:#A9BAD2\">NEXT DEPARTURE</span>\n            </div>\n            <div style=\"font-size:15px;font-weight:700;margin-top:9px;line-height:1.2\" data-kid=\"auto-13\">Stockholm <span style=\"color:#F2761B\">→</span> Tunis</div>\n            <div style=\"font-size:9px;color:#C7D3E6;margin-top:5px\" data-kid=\"auto-14\">15 Nov · 14:00 · Cargo van</div>\n            <div style=\"display:flex;align-items:center;gap:7px;margin-top:auto\" data-kid=\"auto-15\">\n              <div style=\"flex:1;height:4px;border-radius:4px;background:rgba(255,255,255,.16);position:relative\">\n                <div style=\"position:absolute;left:0;top:0;bottom:0;width:79%;border-radius:4px;background:#F2761B\"></div>\n              </div>\n              <span style=\"font-size:8.5px;font-weight:600;color:#C7D3E6\">19/24</span>\n            </div>\n          </div>\n          <div style=\"width:52px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px\" data-kid=\"auto-16\">\n            <div style=\"width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.1);border:2.5px solid #F2761B;display:grid;place-items:center\">\n              <div style=\"text-align:center\">\n                <div style=\"font-size:14px;font-weight:800;line-height:1\">05</div>\n                <div style=\"font-size:6px;font-weight:700;letter-spacing:.08em;color:#A9BAD2\">DAYS</div>\n              </div>\n            </div>\n            <span style=\"font-size:7.5px;font-weight:700;color:#FFB27A\">TRACK</span>\n          </div>\n        </div>\n\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px\" data-kid=\"1-2-1-2\" data-name=\"Android 2x2 widget and app icons\">\n          <div style=\"height:126px;border-radius:28px;background:#FFFFFF;padding:13px;color:#0C1626;box-shadow:0 10px 22px rgba(6,16,31,.18);display:flex;flex-direction:column\" data-kid=\"1-2-1-2-1\" data-name=\"Android 2x2 widget — light\">\n            <div style=\"display:flex;align-items:center;gap:5px\">\n              <span style=\"width:6px;height:6px;border-radius:50%;background:#F2761B\"></span>\n              <span style=\"font-size:7.5px;font-weight:700;letter-spacing:.1em;color:#8A97AC\">NEXT</span>\n            </div>\n            <div style=\"font-size:26px;font-weight:800;color:#132B55;line-height:1;margin-top:12px\" data-kid=\"auto-17\">15</div>\n            <div style=\"font-size:9px;font-weight:600;color:#55627A;margin-top:2px\">Nov · 14:00</div>\n            <div style=\"font-size:8.5px;color:#8A97AC;margin-top:auto\">Stockholm → Tunis</div>\n          </div>\n          <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:start\" data-kid=\"1-2-1-2-2\">\n            <div style=\"height:58px;border-radius:18px;background:rgba(255,255,255,.94);display:grid;place-items:center;color:#132B55;box-shadow:0 6px 14px rgba(6,16,31,.14)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg>\n            </div>\n            <div style=\"height:58px;border-radius:18px;background:rgba(255,255,255,.94);display:grid;place-items:center;color:#F2761B;box-shadow:0 6px 14px rgba(6,16,31,.14)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"3\"/><path d=\"M8 8h8M8 12h8M8 16h5\"/></svg>\n            </div>\n            <div style=\"height:58px;border-radius:18px;background:rgba(255,255,255,.94);display:grid;place-items:center;color:#17865B;box-shadow:0 6px 14px rgba(6,16,31,.14)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M4 12h16M12 4v16\"/></svg>\n            </div>\n            <div style=\"height:58px;border-radius:18px;background:rgba(255,255,255,.94);display:grid;place-items:center;color:#8A97AC;box-shadow:0 6px 14px rgba(6,16,31,.14)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"3.4\"/><path d=\"M4.5 20a7.5 7.5 0 0 1 15 0\"/></svg>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"margin-top:12px;height:88px;border-radius:26px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);display:flex;justify-content:space-evenly;align-items:center;color:rgba(255,255,255,.9)\" data-kid=\"1-2-1-3\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z\"/></svg>\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 9h18\"/></svg>\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M4 5h16v14H4zM8 9h8M8 13h8\"/></svg>\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/></svg>\n        </div>\n\n        <div style=\"position:absolute;bottom:12px;left:50%;transform:translateX(-50%);width:96px;height:4px;border-radius:9px;background:rgba(255,255,255,.85)\" data-kid=\"auto-18\"></div>\n      </div>\n    </div>\n\n    <div style=\"display:flex;flex-direction:column;gap:14px\" data-kid=\"1-3\">\n\n      <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px\" data-kid=\"1-3-1\">\n        <div class=\"card\" style=\"padding:16px\" data-kid=\"1-3-1-1\">\n          <p class=\"eyebrow\" style=\"margin:0\">2 × 2</p>\n          <h3 style=\"font-size:16px;margin:6px 0 0\">Glance card</h3>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Day of the month, time, route</span></div>\n          <div style=\"font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;color:#8A97AC;margin-top:9px\">minWidth 110dp<br/>minHeight 110dp</div>\n        </div>\n        <div class=\"card\" style=\"padding:16px\" data-kid=\"1-3-1-2\">\n          <p class=\"eyebrow\" style=\"margin:0\">4 × 2</p>\n          <h3 style=\"font-size:16px;margin:6px 0 0\">Route + countdown</h3>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Route, date, capacity, countdown ring</span></div>\n          <div style=\"font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;color:#8A97AC;margin-top:9px\">minWidth 250dp<br/>minHeight 110dp</div>\n        </div>\n        <div class=\"card\" style=\"padding:16px\" data-kid=\"1-3-1-3\">\n          <p class=\"eyebrow\" style=\"margin:0\">4 × 4</p>\n          <h3 style=\"font-size:16px;margin:6px 0 0\">Departure briefing</h3>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Timeline, capacity, two actions</span></div>\n          <div style=\"font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;color:#8A97AC;margin-top:9px\">minWidth 250dp<br/>minHeight 250dp</div>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-2\" data-name=\"Light and dark containers\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:13px\">\n          <div>\n            <p class=\"eyebrow\" style=\"margin:0\">THEMES</p>\n            <h3 style=\"font-size:17px;margin:7px 0 0\">One layout, two containers</h3>\n          </div>\n          <span style=\"font-size:10px;font-weight:600;color:#55627A;background:#F4F6FA;border:1px solid #E4E9F0;border-radius:99px;padding:5px 9px\">Material You aware</span>\n        </div>\n        <div style=\"display:flex;gap:14px\" data-kid=\"1-3-2-1\">\n          <div style=\"flex:1;height:118px;border-radius:26px;background:#FFFFFF;border:1px solid #E4E9F0;padding:13px;display:flex;flex-direction:column;color:#0C1626\">\n            <div style=\"display:flex;align-items:center;gap:6px\">\n              <span style=\"width:6px;height:6px;border-radius:50%;background:#F2761B\"></span>\n              <span style=\"font-size:8px;font-weight:700;letter-spacing:.1em;color:#8A97AC\">NEXT DEPARTURE</span>\n              <span style=\"margin-left:auto;font-size:8px;font-weight:700;color:#D65E0A;background:#FFF4EC;border-radius:99px;padding:3px 7px\">IN 5 DAYS</span>\n            </div>\n            <div style=\"font-size:13px;font-weight:700;margin-top:9px\">Stockholm <span style=\"color:#F2761B\">→</span> Tunis</div>\n            <div style=\"font-size:9px;color:#55627A;margin-top:4px\">15 Nov · 14:00 · Cargo van</div>\n            <div style=\"height:4px;border-radius:4px;background:#E4E9F0;margin-top:auto;position:relative\">\n              <div style=\"position:absolute;left:0;top:0;bottom:0;width:79%;border-radius:4px;background:#F2761B\"></div>\n            </div>\n          </div>\n          <div style=\"flex:1;height:118px;border-radius:26px;background:linear-gradient(150deg,#1B3B6B,#132B55 60%,#0E2040);padding:13px;display:flex;flex-direction:column;color:#fff\">\n            <div style=\"display:flex;align-items:center;gap:6px\">\n              <span style=\"width:6px;height:6px;border-radius:50%;background:#F2761B\"></span>\n              <span style=\"font-size:8px;font-weight:700;letter-spacing:.1em;color:#A9BAD2\">NEXT DEPARTURE</span>\n              <span style=\"margin-left:auto;font-size:8px;font-weight:700;color:#FFB27A;background:rgba(242,118,27,.18);border:1px solid rgba(242,118,27,.28);border-radius:99px;padding:3px 7px\">IN 5 DAYS</span>\n            </div>\n            <div style=\"font-size:13px;font-weight:700;margin-top:9px\">Stockholm <span style=\"color:#F2761B\">→</span> Tunis</div>\n            <div style=\"font-size:9px;color:#C7D3E6;margin-top:4px\">15 Nov · 14:00 · Cargo van</div>\n            <div style=\"height:4px;border-radius:4px;background:rgba(255,255,255,.16);margin-top:auto;position:relative\">\n              <div style=\"position:absolute;left:0;top:0;bottom:0;width:79%;border-radius:4px;background:#F2761B\"></div>\n            </div>\n          </div>\n        </div>\n        <div class=\"spec\"><span class=\"dot\"></span><span>Light uses a white surface with navy type; dark keeps the brand navy field. Dynamic colour tints only the accents.</span></div>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:1.15fr 1fr;gap:14px\" data-kid=\"1-3-3\">\n        <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-3-1\" data-name=\"Android behaviour rules\">\n          <p class=\"eyebrow\" style=\"margin:0\">ANDROID RULES</p>\n          <div style=\"display:flex;flex-wrap:wrap;gap:7px;margin-top:11px\">\n            <span class=\"chip\" style=\"color:#132B55;background:#EEF2F8;border:1px solid #DCE4EF\">updatePeriodMillis 30 min</span>\n            <span class=\"chip\" style=\"color:#132B55;background:#EEF2F8;border:1px solid #DCE4EF\">resizeMode both</span>\n            <span class=\"chip\" style=\"color:#132B55;background:#EEF2F8;border:1px solid #DCE4EF\">48 dp tap targets</span>\n            <span class=\"chip\" style=\"color:#132B55;background:#EEF2F8;border:1px solid #DCE4EF\">previewLayout</span>\n            <span class=\"chip\" style=\"color:#132B55;background:#EEF2F8;border:1px solid #DCE4EF\">RTL via layoutDirection</span>\n          </div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>No custom views: RemoteViews-safe text, bars and icons only.</span></div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Refresh on resume + WorkManager after a booking changes.</span></div>\n        </div>\n        <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-3-2\" data-name=\"Android states\">\n          <p class=\"eyebrow\" style=\"margin:0\">STATES</p>\n          <div style=\"display:flex;flex-wrap:wrap;gap:7px;margin-top:11px\">\n            <span class=\"chip\" style=\"color:#17865B;background:#E7F5EE;border:1px solid #BFE5D1\">Scheduled</span>\n            <span class=\"chip\" style=\"color:#D65E0A;background:#FFF4EC;border:1px solid #FFE7D4\">Departing soon</span>\n            <span class=\"chip\" style=\"color:#B23036;background:#FBEDEE;border:1px solid #F3CDD0\">Full</span>\n            <span class=\"chip\" style=\"color:#55627A;background:#F4F6FA;border:1px solid #E4E9F0\">Cancelled</span>\n          </div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Empty state: logo, “Open the app for departures”, tap opens Trips.</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"display:flex;justify-content:space-between;border-top:1px solid #E4E9F0;margin-top:26px;padding-top:14px;font-size:10px;color:#8A97AC\" data-kid=\"1-4\">\n    <span>Android widgets · brand navy or white surface, 28 dp corners, orange cargo accent · Rubik with Roboto fallback</span>\n    <span style=\"font-weight:700;letter-spacing:.08em\">TUNISISKA MEGA TRANSPORT</span>\n  </div>\n</div>\n",
