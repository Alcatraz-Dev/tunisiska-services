      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .rk{font-family:'Rubik',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;}\n</style>\n<div class=\"rk w-full max-w-[393px] mx-auto min-h-[852px] bg-[#F7F9FC] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"flex items-center justify-between px-7 pt-3.5 pb-1\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.2px] text-[#0C1626]\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"status bar clock time\" data-reason=\"clock text normally replaced with current system time on reload\">9:41</span>\n<div class=\"flex items-center gap-1.5 text-[#0C1626] text-[15px] leading-none\" data-kid=\"1-1-2\" data-name=\"status bar indicator group\">\n<i class=\"ti ti-antenna-bars-5\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\"></i>\n<i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\" data-name=\"wi-fi internet icon\"></i>\n<i class=\"ti ti-battery-3\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<header class=\"flex items-center gap-1 px-4 pt-2\" data-kid=\"1-2\" data-name=\"screen header bar\">\n<button aria-label=\"Back\" class=\"-ml-1 flex h-10 w-10 items-center justify-center rounded-full text-[22px] text-[#0C1626] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-2-1\" data-name=\"back navigation button\" type=\"button\">\n<i class=\"ti ti-chevron-left\" data-kid=\"1-2-1-1\" data-name=\"left chevron back arrow icon\"></i>\n</button>\n<h1 class=\"flex-1 text-[20px] font-bold leading-[26px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-2-2\" data-name=\"screen title heading\">Trip Schedule</h1>\n<button aria-label=\"Open departure calendar\" class=\"flex h-10 w-10 items-center justify-center rounded-full border border-[#E4E9F0] bg-white text-[19px] text-[#132B55] shadow-[0_6px_16px_-12px_rgba(12,22,38,0.5)] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-2-3\" data-name=\"open departure calendar button\" type=\"button\">\n<i class=\"ti ti-calendar\" data-kid=\"1-2-3-1\" data-name=\"calendar icon\"></i>\n</button>\n</header>\n<div aria-label=\"Trip period\" class=\"mt-4 flex gap-2 px-5\" data-kid=\"1-3\" data-name=\"trip period filter tab list\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"h-10 rounded-full bg-[#132B55] px-5 text-[13.5px] font-semibold text-white shadow-[0_10px_22px_-14px_rgba(19,43,85,0.95)] transition-colors duration-200\" data-kid=\"1-3-1\" data-name=\"upcoming trips filter tab (active)\" role=\"tab\" type=\"button\">Upcoming</button>\n<button aria-selected=\"false\" class=\"h-10 rounded-full border border-[#E4E9F0] bg-white px-5 text-[13.5px] font-medium text-[#55627A] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-3-2\" data-name=\"past trips filter tab\" role=\"tab\" type=\"button\">Past</button>\n<button aria-selected=\"false\" class=\"h-10 rounded-full border border-[#E4E9F0] bg-white px-5 text-[13.5px] font-medium text-[#55627A] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-3-3\" data-name=\"all trips filter tab\" role=\"tab\" type=\"button\">All</button>\n</div>\n<div class=\"mt-4 space-y-3 px-5\" data-kid=\"1-4\" data-name=\"trip list container\">\n<article class=\"overflow-hidden rounded-[20px] border border-[#E4E9F0] bg-white shadow-[0_18px_34px_-24px_rgba(12,22,38,0.55)] transition-transform duration-200 ease-out hover:-translate-y-0.5\" data-kid=\"1-4-1\" data-name=\"outbound trip card\">\n<div class=\"relative\" data-kid=\"1-4-1-1\" data-name=\"trip card image area\">\n<img alt=\"Ferry at the Stockholm terminal, photo by Efrem Efre on Pexels\" class=\"h-[158px] w-full object-cover\" data-kid=\"1-4-1-1-1\" data-name=\"destination ferry photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33252265/pexels-photo-33252265.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n<span class=\"absolute right-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[12px] font-semibold leading-[15px] text-[#0C1626] shadow-[0_6px_14px_-8px_rgba(12,22,38,0.6)] backdrop-blur\" data-kid=\"1-4-1-1-2\" data-name=\"departure date-time badge\">15 Nov · 14:00</span>\n</div>\n<div class=\"flex items-center gap-3 px-4 py-3.5\" data-kid=\"1-4-1-2\" data-name=\"trip card details row\">\n<div class=\"flex-1\" data-kid=\"1-4-1-2-1\" data-name=\"trip route info block\">\n<p class=\"text-[17px] font-bold leading-[22px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-4-1-2-1-1\" data-name=\"route country heading\">Sweden → Tunisia</p>\n<p class=\"mt-1 flex items-center gap-1.5 text-[13px] leading-[17px] text-[#55627A]\" data-kid=\"1-4-1-2-1-2\" data-name=\"route city detail row\">\n<i class=\"ti ti-map-pin text-[14px] text-[#AEB9C9]\" data-kid=\"1-4-1-2-1-2-1\" data-name=\"map pin location icon\"></i>\n            Stockholm → Tunis\n          </p>\n</div>\n<span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#F2F5FA] text-[16px] text-[#132B55]\" data-kid=\"1-4-1-2-2\" data-name=\"trip card expand action button\">\n<i class=\"ti ti-chevron-right\" data-kid=\"1-4-1-2-2-1\" data-name=\"right chevron arrow icon\"></i>\n</span>\n</div>\n</article>\n<article class=\"overflow-hidden rounded-[20px] border border-[#E4E9F0] bg-white shadow-[0_18px_34px_-24px_rgba(12,22,38,0.55)] transition-transform duration-200 ease-out hover:-translate-y-0.5\" data-kid=\"1-4-2\" data-name=\"return trip card\">\n<div class=\"relative\" data-kid=\"1-4-2-1\" data-name=\"trip card image area\">\n<img alt=\"White and blue houses above the sea in Sidi Bou Said, photo by Halima Bouchouicha on Unsplash\" class=\"h-[158px] w-full object-cover\" data-kid=\"1-4-2-1-1\" data-name=\"destination sea town photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1633936478473-e75c1252cccf?auto=format&amp;w=800&amp;q=80&amp;fit=crop\"/>\n<span class=\"absolute right-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[12px] font-semibold leading-[15px] text-[#0C1626] shadow-[0_6px_14px_-8px_rgba(12,22,38,0.6)] backdrop-blur\" data-kid=\"1-4-2-1-2\" data-name=\"departure date-time badge\">22 Nov · 16:00</span>\n</div>\n<div class=\"flex items-center gap-3 px-4 py-3.5\" data-kid=\"1-4-2-2\" data-name=\"trip card details row\">\n<div class=\"flex-1\" data-kid=\"1-4-2-2-1\" data-name=\"trip route info block\">\n<p class=\"text-[17px] font-bold leading-[22px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-4-2-2-1-1\" data-name=\"route country heading\">Tunisia → Sweden</p>\n<p class=\"mt-1 flex items-center gap-1.5 text-[13px] leading-[17px] text-[#55627A]\" data-kid=\"1-4-2-2-1-2\" data-name=\"route city detail row\">\n<i class=\"ti ti-map-pin text-[14px] text-[#AEB9C9]\" data-kid=\"1-4-2-2-1-2-1\" data-name=\"map pin location icon\"></i>\n            Tunis → Stockholm\n          </p>\n</div>\n<span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#F2F5FA] text-[16px] text-[#132B55]\" data-kid=\"1-4-2-2-2\" data-name=\"trip card expand action button\">\n<i class=\"ti ti-chevron-right\" data-kid=\"1-4-2-2-2-1\" data-name=\"right chevron arrow icon\"></i>\n</span>\n</div>\n</article>\n</div>\n<div class=\"mx-5 mt-4 flex items-start gap-3 rounded-[16px] bg-[#F2F5FA] p-4\" data-kid=\"1-5\" data-name=\"informational disclaimer banner\">\n<i class=\"ti ti-info-circle mt-0.5 text-[18px] leading-none text-[#132B55]\" data-kid=\"1-5-1\" data-name=\"info circle icon\"></i>\n<p class=\"text-[12.5px] leading-[18px] text-[#55627A]\" data-kid=\"1-5-2\" data-name=\"disclaimer notice text\">Timetable is subject to changes. Stay updated via the app.</p>\n</div>\n<div class=\"pb-8\" data-kid=\"1-6\" data-name=\"bottom spacing spacer\"></div>\n</div>",
