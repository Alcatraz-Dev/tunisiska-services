olute bottom-[30px] left-[14px] top-9 w-0 border-l border-dashed border-[#D3DBE6]\" data-kid=\"1-5-1-1\" data-name=\"timeline dashed connector line\"></span>\n<p class=\"mb-2 text-[10.5px] font-bold uppercase tracking-[0.7px] text-[#8A97AC]\" data-kid=\"1-5-1-2\" data-name=\"timeline month label\">November</p>\n<!-- next departure -->\n<div class=\"relative\" data-kid=\"1-5-1-3\" data-name=\"featured next departure card container\">\n<span class=\"absolute -left-[35px] top-8 z-10 size-[13px] rounded-full border-[3px] border-[#F4F6FA] bg-[#F2761B]\" data-kid=\"1-5-1-3-1\" data-name=\"active timeline dot indicator\"></span>\n<div class=\"overflow-hidden rounded-[22px] bg-[#0B1B33] shadow-[0_12px_26px_rgba(6,16,31,0.22)]\" data-kid=\"1-5-1-3-2\" data-name=\"featured departure card\">\n<div class=\"relative h-[96px] overflow-hidden\" data-kid=\"1-5-1-3-2-1\" data-name=\"card hero image area\">\n<svg class=\"absolute inset-0 h-full w-full\" data-kid=\"1-5-1-3-2-1-1\" data-name=\"night sea voyage illustrated background\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 24 320 146\">\n<defs>\n<lineargradient id=\"sky-lead\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#132B55\"></stop>\n<stop offset=\"0.55\" stop-color=\"#0B1B33\"></stop>\n<stop offset=\"1\" stop-color=\"#06101F\"></stop>\n</lineargradient>\n</defs>\n<rect fill=\"url(#sky-lead)\" height=\"200\" width=\"320\"></rect>\n<circle cx=\"248\" cy=\"46\" fill=\"#FF8534\" opacity=\"0.16\" r=\"26\"></circle>\n<circle cx=\"248\" cy=\"46\" fill=\"#FF8534\" opacity=\"0.22\" r=\"15\"></circle>\n<path d=\"M64 128 C 120 40, 200 40, 256 116\" fill=\"none\" stroke=\"#FFFFFF\" stroke-linecap=\"round\" stroke-opacity=\"0.55\" stroke-width=\"3\"></path>\n<path d=\"M64 128 C 120 40, 200 40, 256 116\" fill=\"none\" opacity=\"0.85\" stroke=\"#FF8534\" stroke-dasharray=\"8 10\" stroke-linecap=\"round\" stroke-width=\"2\"></path>\n<circle cx=\"64\" cy=\"128\" fill=\"#FFFFFF\" r=\"15\"></circle>\n<circle cx=\"64\" cy=\"128\" fill=\"#132B55\" r=\"8\"></circle>\n<circle cx=\"256\" cy=\"116\" fill=\"#FF8534\" r=\"15\"></circle>\n<circle cx=\"256\" cy=\"116\" fill=\"#06101F\" r=\"7\"></circle>\n<rect fill=\"#06101F\" height=\"50\" opacity=\"0.7\" width=\"320\" y=\"150\"></rect>\n</svg>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#0B1B33] via-transparent to-transparent\" data-kid=\"1-5-1-3-2-1-2\" data-name=\"hero bottom fade gradient overlay\"></div>\n<div class=\"absolute left-3 top-3 rounded-full bg-white/94 px-2.5 py-[5px] text-[11px] font-bold text-[#0B1B33]\" data-kid=\"1-5-1-3-2-1-3\" data-name=\"departure date-time badge\">Fri 13 Nov · 09:15</div>\n<div class=\"absolute right-3 top-3 rounded-full border border-[#FFE7D4] bg-[#FFF4EC] px-2.5 py-[4px] text-[9px] font-bold uppercase tracking-[0.6px] text-[#AC4707]\" data-kid=\"1-5-1-3-2-1-4\" data-name=\"vessel type tag\">Container ship</div>\n</div>\n<div class=\"px-3.5 pb-3.5 pt-2.5\" data-kid=\"1-5-1-3-2-2\" data-name=\"card body content\">\n<div class=\"flex items-center justify-between gap-3\" data-kid=\"1-5-1-3-2-2-1\" data-name=\"card body row\">\n<div class=\"min-w-0\" data-kid=\"1-5-1-3-2-2-1-1\" data-name=\"route details group\">\n<p class=\"text-[16px] font-bold leading-tight text-white\" data-kid=\"1-5-1-3-2-2-1-1-1\" data-name=\"route title\">Tunisia → Sweden</p>\n<p class=\"mt-1 flex items-center gap-1 text-[12px] text-[#AEBAD0]\" data-kid=\"1-5-1-3-2-2-1-1-2\" data-name=\"port-of-call caption\"><i class=\"ph ph-map-pin text-[11px] text-[#6A85B4]\" data-kid=\"1-5-1-3-2-2-1-1-2-1\" data-name=\"map pin icon\"></i>Tunis → Stockholm</p>\n</div>\n<div class=\"flex shrink-0 items-center gap-2 rounded-[14px] border border-white/15 bg-[#162133] px-2.5 py-1.5\" data-kid=\"1-5-1-3-2-2-1-2\" data-name=\"seats available widget\">\n<svg class=\"size-[26px] -rotate-90\" data-kid=\"1-5-1-3-2-2-1-2-1\" data-name=\"seats progress ring chart\" viewbox=\"0 0 30 30\">\n<circle cx=\"15\" cy=\"15\" fill=\"none\" r=\"