# WhatsApp gateway (Baileys bridge) — no Meta app, no tokens, no webhook.
# Copy to .env and fill in.
# Comma-separated owner numbers allowed to publish without using the panel.
WHATSAPP_ADMIN_NUMBERS=
# Optional: shown in the panel when no session is linked yet.
WHATSAPP_BUSINESS_NUMBER=
# Optional: where the linked session lives (defaults to ./baileys-auth, git-ignored).
WHATSAPP_AUTH_DIR=
# Optional: set to "false" to run the API without starting the WhatsApp session.
WHATSAPP_BRIDGE_ENABLED=
# Optional: gateway port (default 4100) — keep it free of other apps.
WHATSAPP_GATEWAY_PORT=
