      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .rk{font-family:'Rubik',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;}\n</style>\n<div class=\"rk w-full max-w-[393px] mx-auto min-h-[852px] bg-[#F7F9FC] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"mobile app screen container\">\n<div class=\"flex items-center justify-between px-7 pt-3.5 pb-1\" data-kid=\"1-1\" data-name=\"status bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-1-1\" data-name=\"device clock time\">9:41</span>\n<div class=\"flex items-center gap-1.5 text-[#0C1626] text-[15px] leading-none\" data-kid=\"1-1-2\" data-name=\"status bar icons group\">\n<i class=\"ti ti-antenna-bars-5\" data-kid=\"1-1-2-1\" data-name=\"mobile signal strength icon\"></i>\n<i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi connectivity icon\"></i>\n<i class=\"ti ti-battery-3\" data-kid=\"1-1-2-3\" data-name=\"battery status icon\"></i>\n</div>\n</div>\n<header class=\"flex items-center gap-1 px-4 pt-2\" data-kid=\"1-2\" data-name=\"app header with back button\">\n<button aria-label=\"Back\" class=\"-ml-1 flex h-10 w-10 items-center justify-center rounded-full text-[22px] text-[#0C1626] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-2-1\" data-name=\"back navigation button\" type=\"button\">\n<i class=\"ti ti-chevron-left\" data-kid=\"1-2-1-1\" data-name=\"left chevron icon\"></i>\n</button>\n<h1 class=\"flex-1 text-[20px] font-bold leading-[26px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-2-2\" data-name=\"screen title false\">Select Date</h1>\n</header>\n<section class=\"mx-5 mt-3 rounded-[20px] border border-[#E4E9F0] bg-white p-4 shadow-[0_18px_34px_-26px_rgba(12,22,38,0.5)]\" data-kid=\"1-3\" data-name=\"calendar card section\">\n<div class=\"flex items-center justify-between px-1\" data-kid=\"1-3-1\" data-name=\"calendar month navigation row\">\n<button aria-label=\"Previous month\" class=\"flex h-9 w-9 items-center justify-center rounded-full text-[18px] text-[#55627A] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-3-1-1\" data-name=\"previous month button\" type=\"button\">\n<i class=\"ti ti-chevron-left\" data-kid=\"1-3-1-1-1\" data-name=\"left chevron icon\"></i>\n</button>\n<p class=\"text-[16px] font-bold leading-[21px] tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-3-1-2\" data-name=\"calendar month and year label\">November 2025</p>\n<button aria-label=\"Next month\" class=\"flex h-9 w-9 items-center justify-center rounded-full text-[18px] text-[#55627A] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-3-1-3\" data-name=\"next month button\" type=\"button\">\n<i class=\"ti ti-chevron-right\" data-kid=\"1-3-1-3-1\" data-name=\"right chevron icon\"></i>\n</button>\n</div>\n<div class=\"mt-3 grid grid-cols-7 gap-y-1 text-center\" data-kid=\"1-3-2\" data-name=\"calendar weekday header row\">\n<span class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#AEB9C9]\" data-kid=\"1-3-2-1\" data-name=\"Monday day-of-week label\">Mon</span>\n<span class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#AEB9C9]\" data-kid=\"1-3-2-2\" data-name=\"Tuesday day-of-week label\">Tue</span>\n<span class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#AEB9C9]\" data-kid=\"1-3-2-3\" data-name=\"Wednesday day-of-week label\">Wed</span>\n<span class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#AEB9C9]\" data-kid=\"1-3-2-4\" data-name=\"Thursday day-of-week label\">Thu</span>\n<span class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#AEB9C9]\" data-kid=\"1-3-2-5\" data-name=\"Friday day-of-week label\">Fri</span>\n<span class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#AEB9C9]\" data-kid=\"1-3-2-6\" data-name=\"Saturday day-of-week label\">Sat</span>\n<span class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[#AEB9C9]\" data-kid=\"1-3-2-7\" data-name=\"Sunday day-of-week label\">Sun</span>\n</div>\n<div class=\"mt-1.5 grid grid-cols-7 gap-y-1\" data-kid=\"1-3-3\" data-name=\"calendar date grid\">\n<span class=\"h-11\" data-kid=\"1-3-3-1\" data-name=\"empty calendar cell\"></span><span class=\"h-11\" data-kid=\"1-3-3-2\" data-name=\"empty calendar cell\"></span><span class=\"h-11\" data-kid=\"1-3-3-3\" data-name=\"empty calendar cell\"></span><span class=\"h-11\" data-kid=\"1-3-3-4\" data-name=\"empty calendar cell\"></span><span class=\"h-11\" data-kid=\"1-3-3-5\" data-name=\"empty calendar cell\"></span>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-6\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-6-1\" data-name=\"calendar day number text\">1</span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-7\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-7-1\" data-name=\"calendar day number text\">2</span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-8\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-8-1\" data-name=\"calendar day number text\">3</span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-9\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-9-1\" data-name=\"calendar day number text\">4</span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-10\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-10-1\" data-name=\"calendar day number text\">5</span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-11\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-11-1\" data-name=\"calendar day number text\">6</span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-12\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-12-1\" data-name=\"calendar day number text\">7</span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-13\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-13-1\" data-name=\"calendar day number text\">8</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-13-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-14\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-14-1\" data-name=\"calendar day number text\">9</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-14-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-15\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-15-1\" data-name=\"calendar day number text\">10</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-15-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-16\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-16-1\" data-name=\"calendar day number text\">11</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-16-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-17\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-17-1\" data-name=\"calendar day number text\">12</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-17-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-18\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-18-1\" data-name=\"calendar day number text\">13</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-18-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-19\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-19-1\" data-name=\"calendar day number text\">14</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-19-2\" data-name=\"day indicator dot\"></span></button>\n<button aria-pressed=\"true\" class=\"flex h-11 flex-col items-center justify-center gap-[3px]\" data-kid=\"1-3-3-20\" data-name=\"selected calendar day button\" type=\"button\">\n<span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#F2761B] text-[13.5px] font-semibold text-white shadow-[0_10px_20px_-10px_rgba(242,118,27,0.9)]\" data-kid=\"1-3-3-20-1\" data-name=\"selected day number badge\">15</span>\n<span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-20-2\" data-name=\"day indicator dot\"></span>\n</button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-21\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-21-1\" data-name=\"calendar day number text\">16</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-21-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-22\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-22-1\" data-name=\"calendar day number text\">17</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-22-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-23\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-23-1\" data-name=\"calendar day number text\">18</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-23-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-24\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-24-1\" data-name=\"calendar day number text\">19</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-24-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-25\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-25-1\" data-name=\"calendar day number text\">20</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-25-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-26\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-26-1\" data-name=\"calendar day number text\">21</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-26-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] font-medium text-[#0C1626]\" data-kid=\"1-3-3-27\" data-name=\"calendar day button with event dot\" type=\"button\"><span data-kid=\"1-3-3-27-1\" data-name=\"calendar day number text\">22</span><span class=\"h-[3px] w-[3px] rounded-full bg-[#F2761B]\" data-kid=\"1-3-3-27-2\" data-name=\"event indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-28\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-28-1\" data-name=\"calendar day number text\">23</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-28-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-29\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-29-1\" data-name=\"calendar day number text\">24</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-29-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-30\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-30-1\" data-name=\"calendar day number text\">25</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-30-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-31\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-31-1\" data-name=\"calendar day number text\">26</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-31-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-32\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-32-1\" data-name=\"calendar day number text\">27</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-32-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-33\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-33-1\" data-name=\"calendar day number text\">28</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-33-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-34\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-34-1\" data-name=\"calendar day number text\">29</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-34-2\" data-name=\"day indicator dot\"></span></button>\n<button class=\"flex h-11 flex-col items-center justify-center gap-[3px] text-[13.5px] text-[#0C1626]\" data-kid=\"1-3-3-35\" data-name=\"calendar day button\" type=\"button\"><span data-kid=\"1-3-3-35-1\" data-name=\"calendar day number text\">30</span><span class=\"h-[3px] w-[3px] rounded-full bg-transparent\" data-kid=\"1-3-3-35-2\" data-name=\"day indicator dot\"></span></button>\n</div>\n</section>\n<div class=\"mt-5 flex items-baseline justify-between px-5\" data-kid=\"1-4\" data-name=\"selected date summary row\">\n<h2 class=\"text-[15px] font-bold leading-[20px] tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-4-1\" data-name=\"selected date headline\">Monday, 2 November</h2>\n<span class=\"text-[11.5px] leading-[15px] text-[#8A97AC]\" data-kid=\"1-4-2\" data-name=\"departure count caption\">1 departure</span>\n</div>\n<div class=\"mt-2.5 space-y-2.5 px-5\" data-kid=\"1-5\" data-name=\"selected date departures\">\n<button class=\"w-full rounded-[20px] border border-[#E4E9F0] bg-white p-4 text-left shadow-[0_14px_30px_-26px_rgba(12,22,38,.45)]\" data-kid=\"1-5-1\" data-name=\"departure card with capacity summary\" type=\"button\">\n<div class=\"flex items-start gap-3.5\">\n<div class=\"w-[58px] shrink-0\"><p class=\"text-[20px] font-extrabold leading-[24px] tracking-[-.4px] text-[#0C1626]\">12:00</p><p class=\"mt-1 text-[11px] text-[#8A97AC]\">2 Nov</p></div>\n<div class=\"min-w-0 flex-1\"><div class=\"flex items-center justify-between gap-2\"><h2 class=\"truncate text-[17px] font-bold leading-[22px] text-[#0C1626]\">Tunis → Stockholm</h2><span class=\"rounded-full bg-[#FFF4EC] px-2 py-1 text-[10px] font-bold text-[#D65E0A]\">100%</span></div><span class=\"mt-2 inline-flex rounded-[8px] bg-[#132B55] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white\">Cargo Van</span></div>\n</div>\n<div class=\"mt-4 border-t border-[#EDF1F6] pt-3.5\">\n<div class=\"flex items-end justify-between gap-2\"><div><p class=\"text-[11px] font-medium text-[#8A97AC]\">Cargo capacity</p><div class=\"mt-1 flex items-baseline gap-1.5\"><strong class=\"text-[20px] font-extrabold leading-6 text-[#0C1626]\">1,000</strong><span class=\"text-[12px] text-[#55627A]\">spaces available</span></div></div><span class=\"pb-0.5 text-[12px] text-[#8A97AC]\">1,000 total</span></div>\n<div class=\"mt-3 h-[6px] overflow-hidden rounded-full bg-[#F2F5FA]\"><span class=\"block h-full w-full rounded-full bg-[#F2761B]\"></span></div>\n<div class=\"mt-2 flex items-center justify-between text-[11px]\"><span class=\"text-[#8A97AC]\">0 booked</span><span class=\"font-semibold text-[#F2761B]\">100% available</span></div>\n</div>\n</button>\n</div>\n<div class=\"pb-8\" data-kid=\"1-6\" data-name=\"bottom spacing spacer\"></div>\n</div>",
