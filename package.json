{
  "name": "clerk-expo-quickstart",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "dev": "expo start",
    "server": "node server.mjs",
    "server:dev": "nodemon server.mjs",
    "server:check": "curl -s http://localhost:3000|| echo 'Server not running'",
    "whatsapp:test": "node scripts/whatsapp-self-test.mjs",
    "expo-only": "expo start",
    "server-only": "node server.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "node scripts/build-web.mjs",
    "web:deploy": "npm run web:build && npx vercel deploy --prod --yes dist --project tunisiska-services-web --scope alcatrazdevs-projects",
    "deploy": "vercel --prod",
    "seed:trips": "node scripts/seed-test-trips.mjs",
    "delete:trips": "node scripts/delete-test-trips.mjs",
    "seed:news": "node scripts/seed-test-news.mjs",
    "delete:news": "node scripts/delete-test-news.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
