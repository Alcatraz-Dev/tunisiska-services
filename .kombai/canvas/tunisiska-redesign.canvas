      "id": "var_56274e756ea6",
      "contentHeight": 1000,
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap');\n*{box-sizing:border-box}body{margin:0}.press{min-height:100vh;background:#f3f5f8;color:#101828;font:400 16px Rubik,Arial,sans-serif}.pressnav{height:76px;background:#fff;border-bottom:1px solid #e2e8f0;display:flex;align-items:center}.pressshell{width:min(1080px,calc(100% - 64px));margin:auto}.pressnavin{display:flex;align-items:center;justify-content:space-between}.pressbrand{display:flex;align-items:center;gap:10px;color:#132b55;font-size:15px;font-weight:700}.pressbrand img{width:42px;height:42px}.presshome{padding:10px 15px;border-radius:12px;background:#132b55;color:white;text-decoration:none;font-size:12px;font-weight:600}.pressmain{padding:40px 0 80px}.back{display:inline-flex;align-items:center;gap:8px;padding:10px 13px;margin-bottom:27px;color:#132b55;background:#fff;border:1px solid #e3e9f1;border-radius:999px;text-decoration:none;font-size:12px;font-weight:600}.back i{color:#f2761b;font-style:normal}.kicker{display:flex;align-items:center;gap:7px;color:#d76511;text-transform:uppercase;letter-spacing:.08em;font-size:10px;font-weight:700}.press h1{font-size:48px;letter-spacing:-.04em;line-height:1.1;margin:10px 0 9px}.press p{color:#58677f;line-height:1.6}.subtitle{max-width:670px;margin:0 0 30px;font-size:15px}.empty{min-height:265px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px;background:#fff;border:1px solid #e4e9f0;border-radius:24px;box-shadow:0 8px 24px #10182809}.emptyicon{width:56px;height:56px;display:grid;place-items:center;margin-bottom:16px;background:#fff2e8;color:#f2761b;border-radius:17px;font-size:24px}.empty h2{margin:0 0 7px;font-size:19px}.empty p{max-width:440px;margin:0;font-size:13px}.contact{display:flex;align-items:center;gap:13px;margin-top:19px;padding:16px 18px;background:#fff;border:1px solid #e4e9f0;border-radius:17px}.contacticon{width:40px;height:40px;display:grid;place-items:center;border-radius:13px;background:#eff3f9;color:#132b55}.contact p{flex:1;margin:0;font-size:12px}.pressfoot{border-top:1px solid #e2e8f0;background:#fff;padding:23px 0;color:#58677f;font-size:11px}@media(max-width:600px){.pressshell{width:calc(100% - 36px)}.pressmain{padding-top:25px}.press h1{font-size:36px}.subtitle{font-size:14px}.empty{min-height:235px;padding:24px}.contact{padding:13px}.contact p{font-size:11px}}\n</style>\n<div class=\"press\"><header class=\"pressnav\"><div class=\"pressshell pressnavin\"><div class=\"pressbrand\"><img src=\"data:image/png;base64,\" alt=\"\">Tunisiska Mega</div><a class=\"presshome\" href=\"/\">Home</a></div></header><main class=\"pressmain\"><div class=\"pressshell\"><a class=\"back\" href=\"/\"><i>←</i>Home</a><span class=\"kicker\">▤　Press &amp; Media</span><h1>Press &amp; Media</h1><p class=\"subtitle\">Latest news, updates and media resources about Tunisiska Mega Services.</p><section class=\"empty\"><span class=\"emptyicon\">▤</span><h2>Press releases</h2><p>No press releases are available right now. Check back for updates from the Tunisiska team.</p></section><aside class=\"contact\"><span class=\"contacticon\">✉</span><p>For media enquiries, contact press@tunsiska.com</p><span>→</span></aside></div></main><footer class=\"pressfoot\"><div class=\"pressshell\">Tunisiska Mega Services　·　Sweden ↔ Tunisia</div></footer></div>"
    },
    "var_d9492617230f": {
      "type": "variant",
      "label": "Landing Pages — full app-matched site (web)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 38322,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "comments": [],
      "created": "2026-11-02T20:07:15.157Z",
      "modified": "2026-11-02T20:18:03.263Z",
      "id": "var_d9492617230f",
      "contentHeight": 2916,
      "html": "<style>\n*{box-sizing:border-box}body{margin:0}.site{min-height:100vh;background:#f3f5f8;color:#101828;font:400 15px Rubik,Arial,sans-serif;--n:#132b55;--o:#f2761b;--m:#58677f;--l:#e2e8f0}header{height:72px;background:#fff;border-bottom:1px solid var(--l);display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,32px)}.brand{display:flex;align-items:center;gap:10px;color:var(--n);font-weight:700}.brand img{width:42px;height:42px;object-fit:contain}.nav{display:flex;align-items:center;gap:25px;color:var(--m);font-size:12px}.nav strong{padding:10px 14px;color:white;background:var(--n);border-radius:11px}.hero{display:grid;grid-template-columns:1fr .92fr;align-items:center;gap:5vw;max-width:1160px;min-height:590px;margin:auto;padding:56px 32px}.hero h1{max-width:600px;margin:0 0 17px;font-size:62px;line-height:1.03;letter-spacing:-.04em}.hero p{max-width:520px;color:var(--m);font-size:17px;line-height:1.65}.badges{display:flex;gap:10px;margin-top:26px}.badges span{padding:12px 16px;color:#fff;background:var(--n);border-radius:12px;font-size:12px;font-weight:600}.phones{position:relative;height:510px;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse,#e1e8f1,transparent 67%)}.phone{width:218px;padding:5px;background:#101828;border:3px solid white;border-radius:30px;box-shadow:0 18px 40px #132b5520;overflow:hidden}.phone img{display:block;width:100%;height:auto;border-radius:23px}.phone.second{width:148px;margin:190px 0 0 -30px;transform:rotate(7deg)}section{padding:66px max(5vw,32px)}.section-head{max-width:1160px;margin:0 auto 28px}.section-head h2{margin:0 0 8px;font-size:34px;letter-spacing:-.025em}.section-head p{margin:0;color:var(--m);line-height:1.6}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:1160px;margin:auto}.service{min-height:178px;padding:19px;background:#fff;border:1px solid var(--l);border-radius:18px}.icon{width:42px;height:42px;display:grid;place-items:center;color:var(--o);background:#fff2e8;border-radius:13px;font-size:19px}.service h3{margin:16px 0 6px;font-size:16px}.service p{margin:0;color:var(--m);font-size:12px;line-height:1.5}.showcase{background:#fff;border-block:1px solid var(--l)}.shots{display:flex;align-items:start;justify-content:center;gap:28px;max-width:1100px;margin:auto}.shot{width:190px;text-align:center}.shot .phone{width:100%;margin:0}.shot b{display:block;margin-top:12px;font-size:12px}.pages{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;max-width:1160px;margin:auto}.page{padding:20px;background:#fff;border:1px solid var(--l);border-radius:17px}.page strong{display:block;margin-bottom:7px}.page span{color:var(--m);font-size:12px;line-height:1.5}.admin{max-width:1160px;margin:auto;padding:24px;background:#fff;border:1px solid var(--l);border-radius:20px;box-shadow:0 10px 26px #1018280b}.adminbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:19px}.adminbar b{font-size:20px}.adminbar span{padding:9px 13px;color:#fff;background:var(--n);border-radius:10px;font-size:11px}.adminbody{display:grid;grid-template-columns:190px 1fr;gap:16px}.side,.panel{padding:16px;background:#f8fafc;border:1px solid var(--l);border-radius:14px}.side p{padding:9px;color:var(--m);font-size:11px}.side p:first-child{color:var(--n);background:#eaf0f8;border-radius:8px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.metric{padding:14px;background:white;border:1px solid var(--l);border-radius:11px}.metric small{display:block;color:var(--m);font-size:10px}.metric b{display:block;margin-top:8px;font-size:18px}.setting{height:36px;margin-top:11px;background:#fff;border:1px solid var(--l);border-radius:9px}.cta{display:flex;align-items:center;justify-content:space-between;gap:24px;max-width:1160px;margin:auto;padding:32px;color:#fff;background:var(--n);border-radius:22px}.cta h2{margin:0 0 8px;font-size:27px}.cta p{margin:0;color:#d9e2f1;font-size:13px}.cta .badges{margin:0}.cta .badges span{color:var(--n);background:#fff}@media(max-width:800px){.nav{display:none}.hero{grid-template-columns:1fr;padding-top:44px}.hero h1{font-size:44px}.phones{height:440px}.service-grid{grid-template-columns:repeat(2,1fr)}.shots{overflow:auto;justify-content:flex-start;padding:0 32px}.shot{flex:0 0 185px}.pages{grid-template-columns:1fr}.adminbody{grid-template-columns:1fr}.side{display:none}.cta{display:block}.cta .badges{margin-top:18px}}@media(max-width:470px){header{padding:0 18px}.hero{padding:36px 18px}.hero h1{font-size:39px}.phones{height:390px}.phone{width:190px}.phone.second{width:130px}.service-grid{gap:9px}section{padding:50px 18px}.section-head h2{font-size:28px}}\n</style>\n<div class=\"site\"><header><div class=\"brand\"><img src=\"data:image/png;base64,\" alt=\"Tunisiska logo\">Tunisiska Mega Services</div><nav class=\"nav\"><span>Home</span><span>Services</span><span>About</span><span>News</span><strong>Download app</strong></nav></header><section class=\"hero\"><div><h1>Move between Sweden and Tunisia with ease.</h1><p>Trips, cargo space and everyday services in one familiar app, designed around the route between two homes.</p><div class=\"badges\"><span>Download on the App Store</span><span>Get it on Google Play</span></div></div><div class=\"phones\"><div class=\"phone\"><img src=\"data:image/webp;base64,\" alt=\"Real app home screen\"></div><div class=\"phone second\"><img src=\"data:image/webp;base64,\" alt=\"Real app trip screen\"></div></div></section><section><div class=\"section-head\"><h2>Services for the whole journey</h2><p>Find the right support before, during and after your trip.</p></div><div class=\"service-grid\"><article class=\"service\"><i class=\"icon\">▣</i><h3>Shipping</h3><p>Parcel delivery and cargo space between Tunisia and Sweden.</p></article><article class=\"service\"><i class=\"icon\">✦</i><h3>Moving</h3><p>Help with moving and cleaning services.</p></article><article class=\"service\"><i class=\"icon\">⌖</i><h3>Taxi</h3><p>Arrange airport and local transport.</p></article><article class=\"service\"><i class=\"icon\">□</i><h3>Container shipping</h3><p>Plan larger cargo with a clear booking flow.</p></article></div></section><section class=\"showcase\"><div class=\"section-head\"><h2>The real app, at a glance</h2><p>Captured from the app screens: trip details, capacity calendar and news.</p></div><div class=\"shots\"><article class=\"shot\"><div class=\"phone\"><img src=\"data:image/webp;base64,\" alt=\"Real trip details screenshot\"></div><b>Trip details</b></article><article class=\"shot\"><div class=\"phone\"><img src=\"data:image/webp;base64,\" alt=\"Real capacity screen screenshot\"></div><b>Cargo capacity</b></article><article class=\"shot\"><div class=\"phone\"><img src=\"data:image/webp;base64,\" alt=\"Real news screen screenshot\"></div><b>News and updates</b></article></div></section><section><div class=\"section-head\"><h2>Everything around the app</h2><p>Consistent, readable pages for customers and the team that maintains the site.</p></div><div class=\"pages\"><article class=\"page\"><strong>About & contact</strong><span>Route-first story, real app preview and clear contact details.</span></article><article class=\"page\"><strong>Services & careers</strong><span>Practical service details, current app screens and a simple jobs list.</span></article><article class=\"page\"><strong>Terms & privacy</strong><span>Readable legal content on the same calm zinc surface.</span></article></div></section><section><div class=\"section-head\"><h2>Admin controls the live site</h2><p>Edit translated copy, page visibility, store links and real app screenshots; the public pages update from these saved settings.</p></div><div class=\"admin\"><div class=\"adminbar\"><b>Website settings</b><span>Save changes</span></div><div class=\"adminbody\"><aside class=\"side\"><p>General settings</p><p>Home sections · visible</p><p>Services · localized copy</p><p>Careers · open roles</p><p>News · press releases</p><p>Store links</p><p>Live app screenshots</p></aside><div class=\"panel\"><div class=\"metrics\"><div class=\"metric\"><small>Live copy</small><b>EN · SV · AR</b></div><div class=\"metric\"><small>Sections</small><b>Show / hide</b></div><div class=\"metric\"><small>App screens</small><b>Gallery managed</b></div></div><div class=\"setting\"></div><div class=\"setting\"></div><div class=\"setting\"></div></div></div></div></section><section><div class=\"cta\"><div><h2>Keep both sides close.</h2><p>Get the app and plan your next trip between Tunisia and Sweden.</p></div><div class=\"badges\"><span>App Store</span><span>Google Play</span></div></div></section></div>"
    },
    "var_b5a419d728c2": {
      "type": "variant",
      "label": "iOS widgets — small, medium, large + Lock Screen",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 39788,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap');\n*{box-sizing:border-box}body{margin:0}\n.rk{font-family:Rubik,system-ui,sans-serif;color:#0C1626;-webkit-font-smoothing:antialiased}\n:root{--navy:#132B55;--orange:#F2761B;--ink:#0C1626;--muted:#55627A;--soft:#8A97AC;--line:#E4E9F0;--canvas:#F4F6FA}\n.i{display:inline-block;vertical-align:middle}\n.eyebrow{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8A97AC}\n.card{background:#fff;border:1px solid #E4E9F0;border-radius:18px;box-shadow:0 2px 8px rgba(6,16,31,.05)}\n.wpill{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:8px 12px;background:#fff;border:1px solid #E4E9F0;font-size:11px;font-weight:600;color:#55627A}\n.wpill b{color:#132B55;font-weight:700}\n.spec{display:flex;gap:8px;font-size:11.5px;color:#55627A;line-height:1.45;margin-top:8px}\n.dot{width:5px;height:5px;border-radius:50%;background:#F2761B;flex:0 0 auto;margin-top:6px}\n.iw{color:#fff}\n</style>\n<div class=\"rk\" style=\"width:1280px;min-height:990px;background:#F4F6FA;padding:42px 56px\" data-kid=\"1\" data-name=\"iOS widget families board\">\n\n  <header style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:26px\" data-kid=\"1-1\" data-name=\"Board header\">\n    <div style=\"display:flex;align-items:center;gap:14px\" data-kid=\"1-1-1\">\n      <div style=\"width:42px;height:42px;border-radius:14px;background:#132B55;display:grid;place-items:center;color:#fff\" data-kid=\"1-1-1-1\">\n        <svg class=\"i\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/>\n          <rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/>\n        </svg>\n      </div>\n      <div data-kid=\"1-1-1-2\">\n        <div style=\"font-size:18px;font-weight:700\">iOS widgets</div>\n        <div style=\"font-size:12px;color:#55627A;margin-top:2px\">WidgetKit · home screen small / medium / large and Lock Screen accessories</div>\n      </div>\n    </div>\n    <div style=\"display:flex;gap:8px\" data-kid=\"1-1-2\">\n      <span class=\"wpill\"><b>158</b> pt small</span>\n      <span class=\"wpill\"><b>338</b> pt medium</span>\n      <span class=\"wpill\"><b>338 × 354</b> pt large</span>\n      <span class=\"wpill\" style=\"background:#FFF4EC;border-color:#FFE7D4;color:#D65E0A;font-weight:700\">DESIGN REVIEW</span>\n    </div>\n  </header>\n\n  <div style=\"display:grid;grid-template-columns:352px 1fr;gap:34px;align-items:start\" data-kid=\"1-2\">\n\n    <div style=\"width:352px;background:#0E1522;padding:10px;border-radius:42px;box-shadow:0 24px 50px rgba(12,22,38,.18)\" data-kid=\"1-2-1\" data-name=\"iPhone home screen with all widget sizes\">\n      <div style=\"height:742px;border-radius:34px;background:linear-gradient(165deg,#B3C6D8 0%,#6E88A2 46%,#2A3F56 100%);padding:16px 14px;position:relative;overflow:hidden\">\n\n        <div style=\"display:flex;justify-content:space-between;align-items:center;color:#fff;font-size:11px;font-weight:600\" data-kid=\"auto-10\">\n          <span>9:41</span>\n          <svg width=\"46\" height=\"13\" viewBox=\"0 0 48 14\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M1 12V9h3v3H1Zm5 0V6h3v6H6Zm5 0V3h3v9h-3Z\"/>\n            <path d=\"M19 5.2a7.1 7.1 0 0 1 10 0M21.5 7.8a3.6 3.6 0 0 1 5 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n            <circle cx=\"24\" cy=\"10.5\" r=\".9\"/>\n            <rect x=\"34\" y=\"3\" width=\"11\" height=\"8\" rx=\"1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/>\n            <rect x=\"36\" y=\"5\" width=\"7\" height=\"4\"/>\n          </svg>\n        </div>\n        <div style=\"margin-top:6px;font-size:10px;color:rgba(255,255,255,.8);font-weight:600\" data-kid=\"auto-11\">Saturday, 15 November</div>\n\n        <div style=\"display:grid;grid-template-columns:122px 1fr;gap:10px;margin-top:12px\" data-kid=\"1-2-1-1\" data-name=\"Small widget and app icons row\">\n\n          <div style=\"height:122px;border-radius:22px;background:linear-gradient(150deg,#1E4278,#132B55 56%,#0E2040);padding:12px 12px 11px;color:#fff;display:flex;flex-direction:column;box-shadow:0 10px 22px rgba(6,16,31,.24)\" data-kid=\"1-2-1-1-1\" data-name=\"Small widget — systemSmall\">\n            <div style=\"display:flex;align-items:center;gap:5px\" data-kid=\"auto-12\">\n              <span style=\"width:6px;height:6px;border-radius:50%;background:#F2761B\"></span>\n              <span style=\"font-size:7.5px;font-weight:700;letter-spacing:.1em;color:#A9BAD2\">NEXT TRIP</span>\n            </div>\n            <div style=\"margin-top:auto;font-size:19px;font-weight:700;line-height:1.05\" data-kid=\"auto-13\">15 Nov</div>\n            <div style=\"font-size:9px;color:#C7D3E6;margin-top:3px\" data-kid=\"auto-14\">14:00 · Cargo van</div>\n            <div style=\"font-size:8px;color:#9FB2CC;margin-top:6px\" data-kid=\"auto-15\">Stockholm → Tunis</div>\n            <div style=\"height:3px;border-radius:4px;background:rgba(255,255,255,.16);margin-top:6px;position:relative\" data-kid=\"auto-16\">\n              <div style=\"position:absolute;left:0;top:0;bottom:0;width:79%;border-radius:4px;background:#F2761B\"></div>\n            </div>\n          </div>\n\n          <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:start\" data-kid=\"1-2-1-1-2\">\n            <div style=\"height:56px;border-radius:15px;background:linear-gradient(150deg,#F6A65E,#EE7A1E);display:grid;place-items:center;color:#fff;box-shadow:0 6px 14px rgba(6,16,31,.14)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2\"/><circle cx=\"7\" cy=\"17\" r=\"1.4\"/><circle cx=\"17\" cy=\"17\" r=\"1.4\"/></svg>\n            </div>\n            <div style=\"height:56px;border-radius:15px;background:rgba(255,255,255,.92);display:grid;place-items:center;color:#132B55;box-shadow:0 6px 14px rgba(6,16,31,.12)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M4 7h16v10H4z\"/><path d=\"M8 11h8\"/></svg>\n            </div>\n            <div style=\"height:56px;border-radius:15px;background:rgba(255,255,255,.92);display:grid;place-items:center;color:#17865B;box-shadow:0 6px 14px rgba(6,16,31,.12)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n            </div>\n            <div style=\"height:56px;border-radius:15px;background:rgba(255,255,255,.92);display:grid;place-items:center;color:#8A97AC;box-shadow:0 6px 14px rgba(6,16,31,.12)\">\n              <svg class=\"i\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"3.4\"/><path d=\"M4.5 20a7.5 7.5 0 0 1 15 0\"/></svg>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"height:122px;border-radius:22px;background:linear-gradient(150deg,#1E4278,#132B55 58%,#0E2040);padding:13px 14px;color:#fff;margin-top:10px;box-shadow:0 10px 22px rgba(6,16,31,.24);display:flex;flex-direction:column\" data-kid=\"1-2-1-2\" data-name=\"Medium widget — systemMedium\">\n          <div style=\"display:flex;align-items:center;gap:6px\" data-kid=\"auto-17\">\n            <span style=\"width:6px;height:6px;border-radius:50%;background:#F2761B\"></span>\n            <span style=\"font-size:8px;font-weight:700;letter-spacing:.12em;color:#A9BAD2\">NEXT DEPARTURE</span>\n            <span style=\"margin-left:auto;font-size:8.5px;font-weight:700;color:#FFB27A;background:rgba(242,118,27,.18);border:1px solid rgba(242,118,27,.28);border-radius:99px;padding:3px 7px\" data-kid=\"auto-18\">IN 5 DAYS</span>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:8px;margin-top:11px\" data-kid=\"auto-19\">\n            <span style=\"font-size:13px;font-weight:700\">Stockholm</span>\n            <div style=\"flex:1;height:1px;border-top:1.5px dashed rgba(255,255,255,.38);position:relative\" data-kid=\"auto-20\">\n              <span style=\"position:absolute;left:50%;top:-9px;transform:translateX(-50%);width:17px;height:17px;border-radius:50%;background:#0F2244;display:grid;place-items:center;color:#F2761B\">\n                <svg class=\"i\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><circle cx=\"7\" cy=\"17\" r=\"1.6\"/><circle cx=\"17\" cy=\"17\" r=\"1.6\"/></svg>\n              </span>\n            </div>\n            <span style=\"font-size:13px;font-weight:700\">Tunis</span>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:6px;margin-top:9px;font-size:9px;color:#C7D3E6\" data-kid=\"auto-21\">\n            <span>15 Nov · 14:00</span><span style=\"opacity:.5\">•</span><span>Cargo van</span>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:7px;margin-top:auto\" data-kid=\"auto-22\">\n            <div style=\"flex:1;height:3px;border-radius:4px;background:rgba(255,255,255,.16);position:relative\">\n              <div style=\"position:absolute;left:0;top:0;bottom:0;width:79%;border-radius:4px;background:#F2761B\"></div>\n            </div>\n            <span style=\"font-size:8.5px;font-weight:600;color:#C7D3E6\">19 of 24 spaces</span>\n          </div>\n        </div>\n\n        <div style=\"height:262px;border-radius:24px;background:linear-gradient(155deg,#1E4278,#132B55 52%,#0C1B36);padding:16px;color:#fff;margin-top:10px;box-shadow:0 12px 26px rgba(6,16,31,.26);display:flex;flex-direction:column\" data-kid=\"1-2-1-3\" data-name=\"Large widget — systemLarge\">\n          <div style=\"display:flex;align-items:center;gap:7px\" data-kid=\"auto-23\">\n            <span style=\"width:22px;height:22px;border-radius:8px;background:rgba(242,118,27,.18);color:#F2761B;display:grid;place-items:center\">\n              <svg class=\"i\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><circle cx=\"7\" cy=\"17\" r=\"1.6\"/><circle cx=\"17\" cy=\"17\" r=\"1.6\"/></svg>\n            </span>\n            <span style=\"font-size:8px;font-weight:700;letter-spacing:.12em;color:#A9BAD2\">NEXT DEPARTURE</span>\n            <span style=\"margin-left:auto;font-size:8.5px;font-weight:600;color:#9FB2CC\">Tunisiska Mega</span>\n          </div>\n          <div style=\"display:flex;align-items:flex-end;gap:8px;margin-top:12px\" data-kid=\"auto-24\">\n            <span style=\"font-size:34px;font-weight:800;line-height:.9\">05</span>\n            <span style=\"font-size:10px;font-weight:600;color:#FFB27A;padding-bottom:3px\">days</span>\n            <span style=\"margin-left:auto;font-size:9px;color:#C7D3E6;text-align:right;line-height:1.4\">15 Nov<br/>14:00</span>\n          </div>\n          <div style=\"height:1px;background:rgba(255,255,255,.14);margin:13px 0 11px\" data-kid=\"auto-25\"></div>\n          <div style=\"display:flex;flex-direction:column;gap:9px\" data-kid=\"auto-26\">\n            <div style=\"display:flex;align-items:center;gap:8px\">\n              <span style=\"width:17px;height:17px;border-radius:50%;background:#F2761B;display:grid;place-items:center;color:#132B55;font-size:8px;font-weight:800\">A</span>\n              <div style=\"flex:1\">\n                <div style=\"font-size:9.5px;font-weight:700\">Stockholm</div>\n                <div style=\"font-size:8px;color:#9FB2CC\">Sundbyberg · 14 Nov 18:00</div>\n              </div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:8px\">\n              <span style=\"width:17px;height:17px;border-radius:50%;background:rgba(255,255,255,.16);display:grid;place-items:center;color:#fff;font-size:8px;font-weight:800\">B</span>\n              <div style=\"flex:1\">\n                <div style=\"font-size:9.5px;font-weight:700\">Tunis</div>\n                <div style=\"font-size:8px;color:#9FB2CC\">Collection point · 17 Nov 09:00</div>\n              </div>\n            </div>\n          </div>\n          <div style=\"display:flex;gap:6px;margin-top:auto\" data-kid=\"auto-27\">\n            <span style=\"flex:1;text-align:center;font-size:8.5px;font-weight:700;color:#132B55;background:#F2761B;border-radius:99px;padding:7px 0\">View trip</span>\n            <span style=\"flex:1;text-align:center;font-size:8.5px;font-weight:700;color:#fff;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.18);border-radius:99px;padding:7px 0\">Track parcel</span>\n          </div>\n        </div>\n\n        <div style=\"position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:6px\" data-kid=\"auto-28\">\n          <span style=\"width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.9)\"></span>\n          <span style=\"width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.4)\"></span>\n        </div>\n      </div>\n    </div>\n\n    <div style=\"display:flex;flex-direction:column;gap:14px\" data-kid=\"1-3\">\n\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px\" data-kid=\"1-3-1\">\n        <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-1-1\" data-name=\"Small widget anatomy\">\n          <div style=\"display:flex;justify-content:space-between;align-items:flex-start\">\n            <div>\n              <p class=\"eyebrow\" style=\"margin:0\">SMALL · 2 × 2</p>\n              <h3 style=\"font-size:17px;margin:7px 0 0\">Countdown card</h3>\n            </div>\n            <span style=\"font-size:10px;font-weight:700;color:#132B55;background:#EEF2F8;border-radius:99px;padding:5px 9px\">158 pt</span>\n          </div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Date and time lead — <b style=\"color:#132B55\">15 Nov</b>, 14:00</span></div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Vehicle line: Cargo van, 24 spaces</span></div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Orange cargo bar 19 / 24 filled</span></div>\n        </div>\n\n        <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-1-2\" data-name=\"Medium widget anatomy\">\n          <div style=\"display:flex;justify-content:space-between;align-items:flex-start\">\n            <div>\n              <p class=\"eyebrow\" style=\"margin:0\">MEDIUM · 4 × 2</p>\n              <h3 style=\"font-size:17px;margin:7px 0 0\">Route and capacity</h3>\n            </div>\n            <span style=\"font-size:10px;font-weight:700;color:#132B55;background:#EEF2F8;border-radius:99px;padding:5px 9px\">338 pt</span>\n          </div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Stockholm → Tunis with dashed transit line</span></div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Countdown pill + date, time, vehicle meta</span></div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Capacity bar with “19 of 24 spaces”</span></div>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-2\" data-name=\"Large widget anatomy\">\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-start\">\n          <div>\n            <p class=\"eyebrow\" style=\"margin:0\">LARGE · 4 × 4</p>\n            <h3 style=\"font-size:17px;margin:7px 0 0\">Departure briefing</h3>\n          </div>\n          <span style=\"font-size:10px;font-weight:700;color:#132B55;background:#EEF2F8;border-radius:99px;padding:5px 9px\">338 × 354 pt</span>\n        </div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:0 26px;margin-top:4px\">\n          <div>\n            <div class=\"spec\"><span class=\"dot\"></span><span>Countdown days + departure date and time</span></div>\n            <div class=\"spec\"><span class=\"dot\"></span><span>Origin collection point and destination point</span></div>\n          </div>\n          <div>\n            <div class=\"spec\"><span class=\"dot\"></span><span>Two deep links: <b style=\"color:#132B55\">View trip</b> · Track parcel</span></div>\n            <div class=\"spec\"><span class=\"dot\"></span><span>Keeps the same navy field as Live Activity</span></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-3\" data-name=\"Lock Screen accessories\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:13px\">\n          <div>\n            <p class=\"eyebrow\" style=\"margin:0\">LOCK SCREEN · iOS 16+</p>\n            <h3 style=\"font-size:17px;margin:7px 0 0\">Accessory families</h3>\n          </div>\n          <span style=\"font-size:10px;font-weight:600;color:#55627A;background:#F4F6FA;border:1px solid #E4E9F0;border-radius:99px;padding:5px 9px\">monochrome-safe tints</span>\n        </div>\n        <div style=\"display:flex;gap:14px;background:linear-gradient(140deg,#51687F,#22364C);border-radius:16px;padding:14px\" data-kid=\"1-3-3-1\">\n          <div style=\"text-align:center\" data-kid=\"1-3-3-1-1\">\n            <div style=\"width:72px;height:72px;border-radius:36px;background:rgba(255,255,255,.14);display:grid;place-items:center;position:relative\">\n              <div style=\"position:absolute;inset:7px;border-radius:50%;border:3px solid rgba(255,255,255,.28);border-top-color:#F2761B;border-right-color:#F2761B;transform:rotate(-25deg)\"></div>\n              <div style=\"text-align:center;color:#fff\">\n                <div style=\"font-size:16px;font-weight:800;line-height:1\">05</div>\n                <div style=\"font-size:6.5px;font-weight:700;letter-spacing:.08em;opacity:.8\">DAYS</div>\n              </div>\n            </div>\n            <div style=\"font-size:9px;color:rgba(255,255,255,.75);margin-top:7px;font-weight:600\">accessoryCircular</div>\n          </div>\n          <div style=\"text-align:center\" data-kid=\"1-3-3-1-2\">\n            <div style=\"width:168px;height:72px;border-radius:14px;background:rgba(255,255,255,.14);padding:10px 11px;color:#fff;text-align:left\">\n              <div style=\"font-size:6.5px;font-weight:700;letter-spacing:.1em;color:rgba(255,255,255,.7)\">NEXT DEPARTURE</div>\n              <div style=\"font-size:11px;font-weight:700;margin-top:4px\">15 Nov · 14:00</div>\n              <div style=\"font-size:8px;color:rgba(255,255,255,.78);margin-top:3px\">Stockholm → Tunis</div>\n            </div>\n            <div style=\"font-size:9px;color:rgba(255,255,255,.75);margin-top:7px;font-weight:600\">accessoryRectangular</div>\n          </div>\n          <div style=\"text-align:center\" data-kid=\"1-3-3-1-3\">\n            <div style=\"width:168px;height:72px;border-radius:14px;background:rgba(255,255,255,.14);padding:0 12px;display:flex;align-items:center;color:#fff\">\n              <span style=\"font-size:9.5px;font-weight:600\">Tunisiska · 15 Nov in 5 days</span>\n            </div>\n            <div style=\"font-size:9px;color:rgba(255,255,255,.75);margin-top:7px;font-weight:600\">accessoryInline</div>\n          </div>\n        </div>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:1.05fr 1fr;gap:14px\" data-kid=\"1-3-4\">\n        <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-4-1\" data-name=\"Widget states\">\n          <p class=\"eyebrow\" style=\"margin:0\">STATES TO BUILD</p>\n          <div style=\"display:flex;flex-wrap:wrap;gap:7px;margin-top:11px\">\n            <span style=\"font-size:10px;font-weight:700;color:#17865B;background:#E7F5EE;border:1px solid #BFE5D1;border-radius:99px;padding:6px 10px\">Scheduled</span>\n            <span style=\"font-size:10px;font-weight:700;color:#D65E0A;background:#FFF4EC;border:1px solid #FFE7D4;border-radius:99px;padding:6px 10px\">Departing soon</span>\n            <span style=\"font-size:10px;font-weight:700;color:#B23036;background:#FBEDEE;border:1px solid #F3CDD0;border-radius:99px;padding:6px 10px\">Full</span>\n            <span style=\"font-size:10px;font-weight:700;color:#55627A;background:#F4F6FA;border:1px solid #E4E9F0;border-radius:99px;padding:6px 10px\">Cancelled</span>\n            <span style=\"font-size:10px;font-weight:700;color:#55627A;background:#F4F6FA;border:1px solid #E4E9F0;border-radius:99px;padding:6px 10px\">No departures</span>\n          </div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Empty state keeps the logo and one line: “Open the app for departures”.</span></div>\n        </div>\n        <div class=\"card\" style=\"padding:17px\" data-kid=\"1-3-4-2\" data-name=\"Data contract\">\n          <p class=\"eyebrow\" style=\"margin:0\">DATA CONTRACT</p>\n          <div style=\"font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10.5px;line-height:1.7;color:#55627A;margin-top:10px\">\n            route · origin · destination<br/>\n            vehicle · date · capacity · available<br/>\n            language · tripId → deep link\n          </div>\n          <div class=\"spec\"><span class=\"dot\"></span><span>Same payload as the Live Activity · refresh every 30 min</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"display:flex;justify-content:space-between;border-top:1px solid #E4E9F0;margin-top:26px;padding-top:14px;font-size:10px;color:#8A97AC\" data-kid=\"1-4\">\n    <span>iOS widgets · navy container background, orange cargo accent, Rubik with SF fallback · Arabic keeps LTR layout</span>\n    <span style=\"font-weight:700;letter-spacing:.08em\">TUNISISKA MEGA TRANSPORT</span>\n  </div>\n</div>\n",
