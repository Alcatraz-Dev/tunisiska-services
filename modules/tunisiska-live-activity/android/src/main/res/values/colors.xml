<?xml version="1.0" encoding="utf-8"?>
<!--
  Home Screen widget palette — light container.

  The canvas keeps one layout and swaps the container: light hosts get a white
  surface with navy type, dark hosts keep the brand navy field (values-night).
  Status pills keep the app's success / warning / danger language, so state is
  never carried by colour alone.
-->
