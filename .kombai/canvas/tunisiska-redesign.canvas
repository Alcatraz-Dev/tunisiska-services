e text-[21px] text-[#8A97AC]\" data-kid=\"1-6-1-1-1\" data-name=\"home icon\"></i>\n<span class=\"text-[10px] font-semibold text-[#8A97AC]\" data-kid=\"1-6-1-1-2\" data-name=\"home tab label\">Home</span>\n</button>\n<div class=\"relative flex flex-col items-center\" data-kid=\"1-6-1-2\" data-name=\"trips tab (active)\">\n<span class=\"absolute -top-0.5 h-[26px] w-[44px] rounded-full bg-[#F2761B]/15\" data-kid=\"1-6-1-2-1\" data-name=\"active tab pill highlight\"></span>\n<i class=\"ph-fill ph-calendar-blank relative text-[21px] text-[#F2761B]\" data-kid=\"1-6-1-2-2\" data-name=\"active calendar icon\"></i>\n<span class=\"mt-1 text-[10px] font-bold text-[#F2761B]\" data-kid=\"1-6-1-2-3\" data-name=\"active trips tab label\">Trips</span>\n</div>\n<button class=\"flex flex-col items-center gap-1 py-1\" data-kid=\"1-6-1-3\" data-name=\"news tab button\">\n<i class=\"ph ph-newspaper text-[21px] text-[#8A97AC]\" data-kid=\"1-6-1-3-1\" data-name=\"news icon\"></i>\n<span class=\"text-[10px] font-semibold text-[#8A97AC]\" data-kid=\"1-6-1-3-2\" data-name=\"news tab label\">News</span>\n</button>\n<button class=\"flex flex-col items-center gap-1 py-1\" data-kid=\"1-6-1-4\" data-name=\"profile tab button\">\n<i class=\"ph ph-user text-[21px] text-[#8A97AC]\" data-kid=\"1-6-1-4-1\" data-name=\"user icon\"></i>\n<span class=\"text-[10px] font-semibold text-[#8A97AC]\" data-kid=\"1-6-1-4-2\" data-name=\"profile tab label\">Profile</span>\n</button>\n</div>\n</div>\n</div>\n",
