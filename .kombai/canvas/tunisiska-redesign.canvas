t:43px;margin-top:10px;background:#fff;border:1px solid #E4E9F0;border-radius:10px;display:flex;align-items:center;gap:8px;padding:6px 8px}.phone-calendar{width:28px;height:28px;border-radius:8px;background:#F2F5FA;color:#132B55;display:grid;place-items:center}.phone-calendar i{font-size:15px}.phone-next>span:nth-child(2){display:flex;flex-direction:column;gap:2px;flex:1}.phone-next small{font-size:7px;color:#606F87}.phone-next strong{font-size:9px;color:#0C1626}.phone-next>i{font-size:13px;color:#8A97AC}.phone-tabbar{position:absolute;bottom:0;left:0;right:0;height:45px;border-top:1px solid #E4E9F0;background:#fff;display:flex;align-items:center;justify-content:space-around}.phone-tabbar span{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:7px;color:#606F87}.phone-tabbar i{font-size:13px}.phone-tabbar .active{color:#F2761B;font-weight:700}.phone-float{position:absolute;z-index:2;left:0;bottom:78px;width:228px;min-height:72px;padding:12px;border-radius:15px;background:#fff;color:#0C1626;display:flex;align-items:center;gap:10px;box-shadow:0 10px 28px rgba(6,16,31,.18)}.float-icon{width:38px;height:38px;border-radius:11px;background:#FFF1E7;color:#E45D08;display:grid;place-items:center;font-size:18px}.phone-float>span:nth-child(2){display:flex;flex-direction:column;gap:4px;flex:1}.phone-float strong{font-size:11px}.phone-float small{font-size:9px;color:#55627A}.phone-float>i{font-size:14px;color:#606F87}.phone-caption{position:absolute;right:46px;bottom:2px;color:#CFD8E8;font-size:10px;font-weight:600;letter-spacing:.02em}.hero-download{margin-top:26px}.hero-secondary{display:inline-flex;align-items:center;gap:7px;margin-top:18px;color:#E4E9F0;font-size:13px;font-weight:600}.hero-secondary:hover{color:#fff}\n</style><div class=\"tm\" style=\"width:1440px;min-height:100vh;background:#F4F6FA\"><div id=\"top\"><header class=\"site-head\"><div class=\"shell head-inner\"><a class=\"brand\" href=\"#top\"><img class=\"brand-logo\" src=\"data:image/png;base64,\" alt=\"Tunisiska Mega logo\"/><span><strong>Tunisiska Mega</strong><small>Transport</small></span></a><nav class=\"nav\"><a href=\"#trips\">Trips</a><a href=\"#services\">Services</a><a href=\"#how\">How it works</a><a href=\"#contact\">Contact</a></nav><div class=\"head-actions\"><span class=\"lang\">EN&nbsp;⌄</span><a class=\"btn btn-navy\" href=\"#download\">Get the app&nbsp; <i class=\"ti ti-arrow-up-right\"></i></a></div></div></header></div><main>\n<section class=\"page-hero\"><div class=\"shell page-hero-grid\"><div><h1>Choose a direction.<br>Find your departure.</h1><p>Browse scheduled cargo van trips between Sweden and Tunisia. Select a date and review trip details in the app.</p><div class=\"actions\"><a class=\"btn btn-orange\" href=\"#directions\">Explore directions <i class=\"ti ti-arrow-down\"></i></a><a class=\"btn btn-outline\" href=\"#download\">Open the app</a></div><div class=\"hero-download\"><div class=\"store-badges\" aria-label=\"Download the app\"><a class=\"store-badge\" href=\"https://apps.apple.com/tn/app/tunsiska-mega-services/id6765942795\" aria-label=\"Download Tunisiska Mega on the App Store\"><i class=\"ti ti-brand-apple\" aria-hidden=\"true\"></i><span><small>Download on the</small><strong>App Store</strong></span></a><a class=\"store-badge\" href=\"https://play.google.com/store/apps/details?id=com.alcatrazdev.tunisiskaservices\" aria-label=\"Get Tunisiska Mega on Google Play\"><i class=\"ti ti-brand-google-play\" aria-hidden=\"true\"></i><span><small>Get it on</small><strong>Google Play</strong></span></a></div></div></div><div class=\"route-graphic\"><div class=\"route-stop\"><i class=\"route-dot\"></i> Stockholm, Sweden</div><div class=\"route-track\"></div><div class=\"route-stop\"><i class=\"route-dot\"></i> Tunis, Tunisia</div><div style=\"display:flex;justify-content:space-between;color:#CFD8E8;font-size:12px;margin-top:24px;padding-top:17px;border-top:1px solid rgba(255,255,255,.17)\"><span><i class=\"ti ti-truck-delivery\" style=\"color:#F2761B;margin-right:7px\"></i>Cargo van</span><span>Two directions</span></div></div></div></section>\n<section class=\"section\" id=\"directions\"><div class=\"shell\"><div class=\"section-head\"><div><h2>Departures in both directions</h2><p class=\"section-lede\">Choose your route, then view dates and capacity in the app.</p></div></div><div class=\"route-grid\"><a class=\"route-tile\" href=\"#download\"><div><div class=\"route-label\">DIRECTION 01 · CARGO VAN</div><div class=\"route-name\">Sweden <span style=\"color:#F2761B\">→</span> Tunisia</div><div class=\"route-cities\">Stockholm → Tunis · Check scheduled dates in app</div></div><span class=\"round-arrow\"><i class=\"ti ti-arrow-right\"></i></span></a><a class=\"route-tile\" href=\"#download\"><div><div class=\"route-label\">DIRECTION 02 · CARGO VAN</div><div class=\"route-name\">Tunisia <span style=\"color:#F2761B\">→</span> Sweden</div><div class=\"route-cities\">Tunis → Stockholm · Check scheduled dates in app</div></div><span class=\"round-arrow\"><i class=\"ti ti-arrow-right\"></i></span></a></div></div></section>\n<section class=\"section section-white\"><div class=\"shell info-row\"><div class=\"info-copy\"><h2>A clear view of every trip.</h2><p>Each departure includes its route, time, vehicle type, and cargo capacity. Review the current information before you book.</p><ul class=\"feature-list\"><li><i class=\"ti ti-circle-check\"></i><span>Compare both travel directions.</span></li><li><i class=\"ti ti-circle-check\"></i><span>Review departure details and available capacity.</span></li><li><i class=\"ti ti-circle-check\"></i><span>Continue to parcel delivery or shipment tracking.</span></li></ul><a class=\"btn btn-navy\" href=\"#download\" style=\"margin-top:24px\">View trips in the app <i class=\"ti ti-arrow-up-right\"></i></a></div><div class=\"capacity-panel\"><h3>Cargo van capacity</h3><p>Capacity and remaining space are shown on each scheduled departure in the app.</p><div class=\"capacity-visual\"><div class=\"capacity-grid\"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div></div><div style=\"display:flex;align-items:center;justify-content:space-between;margin-top:14px;font-size:12px\"><span style=\"color:#F9A36B\">Capacity shown per departure</span><i class=\"ti ti-box\" style=\"color:#F9A36B;font-size:18px\"></i></div></div></div></section>\n<section class=\"section\"><div class=\"shell\"><div class=\"section-head\"><div><h2>What happens next</h2><p class=\"section-lede\">Choose the departure first, then handle the details in one place.</p></div></div><div class=\"process\"><div class=\"process-item\"><h3>Select your route</h3><p>Choose Sweden to Tunisia or Tunisia to Sweden.</p></div><div class=\"process-item\"><h3>Review the schedule</h3><p>Check departure date, time, and capacity in the app.</p></div><div class=\"process-item\"><h3>Plan your shipment</h3><p>Open parcel or container shipping when you need cargo delivery.</p></div></div><div class=\"cta-band\" id=\"download\" style=\"margin-top:48px\"><div><h2>See the current schedule.</h2><p>Departure dates and capacity can change; check the latest details in the app.</p></div><div class=\"store-badges\" aria-label=\"Download the app\"><a class=\"store-badge\" href=\"https://apps.apple.com/tn/app/tunsiska-mega-services/id6765942795\" aria-label=\"Download Tunisiska Mega on the App Store\"><i class=\"ti ti-brand-apple\" aria-hidden=\"true\"></i><span><small>Download on the</small><strong>App Store</strong></span></a><a class=\"store-badge\" href=\"https://play.google.com/store/apps/details?id=com.alcatrazdev.tunisiskaservices\" aria-label=\"Get Tunisiska Mega on Google Play\"><i class=\"ti ti-brand-google-play\" aria-hidden=\"true\"></i><span><small>Get it on</small><strong>Google Play</strong></span></a></div></div></div></section>\n</main><footer class=\"site-foot\" id=\"contact\"><div class=\"shell\"><div class=\"foot-top\"><div class=\"foot-brand\"><a class=\"brand\" href=\"#top\"><img class=\"brand-logo-footer\" src=\"data:image/png;base64,\" alt=\"Tunisiska Mega logo\"/><span><strong style=\"color:#fff\">Tunisiska Mega</strong><small style=\"color:#C7D3E6\">Transport</small></span></a><p>Explore trips and services between Sweden and Tunisia, then manage your booking in the app.</p></div><div class=\"foot-links\"><div><strong>Explore</strong><a href=\"#trips\">Trips</a><a href=\"#services\">Services</a><a href=\"#download\">Get the app</a></div><div><strong>Information</strong><a href=\"#contact\">Contact</a><a href=\"#\">Privacy policy</a><a href=\"#\">Terms of service</a></div></div></div><div class=\"foot-bottom\"><span>© 2026 Tunisiska Mega Transport</span><span>Sweden&nbsp; ↔ &nbsp;Tunisia</span></div></div></footer></div>"
    },
