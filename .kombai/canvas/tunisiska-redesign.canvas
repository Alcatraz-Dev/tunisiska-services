      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .rk{font-family:'Rubik',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;}\n</style>\n<div class=\"rk w-full max-w-[393px] mx-auto min-h-[852px] bg-[#F7F9FC] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"mobile profile screen container\">\n<div class=\"flex items-center justify-between px-7 pt-3.5 pb-1\" data-kid=\"1-1\" data-name=\"status bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-1-1\" data-name=\"status bar clock text\">9:41</span>\n<div class=\"flex items-center gap-1.5 text-[#0C1626] text-[15px] leading-none\" data-kid=\"1-1-2\" data-name=\"status bar connectivity icons\">\n<i class=\"ti ti-antenna-bars-5\" data-kid=\"1-1-2-1\" data-name=\"antenna bars signal icon\"></i>\n<i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\"></i>\n<i class=\"ti ti-battery-3\" data-kid=\"1-1-2-3\" data-name=\"battery icon\"></i>\n</div>\n</div>\n<header class=\"flex items-center gap-1 px-4 pt-2\" data-kid=\"1-2\" data-name=\"top app bar with back title and settings\">\n<button aria-label=\"Back\" class=\"-ml-1 flex h-10 w-10 items-center justify-center rounded-full text-[22px] text-[#0C1626] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-2-1\" data-name=\"back navigation button\" type=\"button\">\n<i class=\"ti ti-chevron-left\" data-kid=\"1-2-1-1\" data-name=\"left chevron back icon\"></i>\n</button>\n<h1 class=\"flex-1 text-[20px] font-bold leading-[26px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-2-2\" data-name='page title \"Your Profile\"'>Your Profile</h1>\n<button aria-label=\"Settings\" class=\"flex h-10 w-10 items-center justify-center rounded-full text-[20px] text-[#132B55] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-2-3\" data-name=\"settings navigation button\" type=\"button\">\n<i class=\"ti ti-settings\" data-kid=\"1-2-3-1\"></i>\n</button>\n</header>\n<div class=\"mt-4 flex flex-col items-center\" data-kid=\"1-3\" data-name=\"profile identity section\">\n<div class=\"relative\" data-kid=\"1-3-1\" data-name=\"avatar wrapper with badge\">\n<div class=\"flex h-[92px] w-[92px] items-center justify-center rounded-full bg-[#132B55] text-[26px] font-bold tracking-[1px] text-white shadow-[0_18px_34px_-20px_rgba(19,43,85,0.95)] ring-[5px] ring-white\" data-kid=\"1-3-1-1\" data-name=\"avatar initials circle\">\n        TT\n      </div>\n<span class=\"absolute bottom-0 right-0 flex h-7 w-7 items-center justify-center rounded-full border-[2.5px] border-[#F7F9FC] bg-[#F2761B] text-[13px] text-white\" data-kid=\"1-3-1-2\" data-name=\"delivery status badge\">\n<i class=\"ti ti-truck\" data-kid=\"1-3-1-2-1\" data-name=\"truck delivery icon\"></i>\n</span>\n</div>\n<p class=\"mt-3.5 text-[17px] font-bold leading-[22px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-3-2\" data-name=\"company name headline\">Tunisiska Mega Transport</p>\n<p class=\"mt-1 flex items-center gap-1.5 text-[12.5px] font-semibold leading-[16px] text-[#F2761B]\" data-kid=\"1-3-3\" data-name=\"premium member status line\">\n<i class=\"ti ti-crown text-[15px]\" data-kid=\"1-3-3-1\" data-name=\"crown premium icon\"></i>\n      Premium Member\n    </p>\n</div>\n<div class=\"mx-5 mt-6 overflow-hidden rounded-[20px] border border-[#E4E9F0] bg-white shadow-[0_18px_34px_-28px_rgba(12,22,38,0.5)]\" data-kid=\"1-4\" data-name=\"main profile menu card\">\n<a class=\"flex items-center gap-3.5 border-b border-[#EDF1F6] px-4 py-[15px] transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-4-1\" data-name=\"My Shipments menu item\" href=\"#\">\n<i class=\"ti ti-package text-[19px] leading-none text-[#132B55]\" data-kid=\"1-4-1-1\" data-name=\"package icon\"></i>\n<span class=\"flex-1 text-[14px] font-medium leading-[19px] text-[#0C1626]\" data-kid=\"1-4-1-2\" data-name='menu item label \"My Shipments\"'>My Shipments</span>\n<i class=\"ti ti-chevron-right text-[17px] text-[#AEB9C9]\" data-kid=\"1-4-1-3\" data-name=\"right chevron affordance icon\"></i>\n</a>\n<a class=\"flex items-center gap-3.5 border-b border-[#EDF1F6] px-4 py-[15px] transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-4-2\" data-name=\"My Trips menu item\" href=\"#\">\n<i class=\"ti ti-calendar text-[19px] leading-none text-[#132B55]\" data-kid=\"1-4-2-1\" data-name=\"calendar icon\"></i>\n<span class=\"flex-1 text-[14px] font-medium leading-[19px] text-[#0C1626]\" data-kid=\"1-4-2-2\" data-name='menu item label \"My Trips\"'>My Trips</span>\n<i class=\"ti ti-chevron-right text-[17px] text-[#AEB9C9]\" data-kid=\"1-4-2-3\" data-name=\"right chevron affordance icon\"></i>\n</a>\n<a class=\"flex items-center gap-3.5 border-b border-[#EDF1F6] px-4 py-[15px] transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-4-3\" data-name=\"Notifications menu item with count\" href=\"#\">\n<i class=\"ti ti-bell text-[19px] leading-none text-[#132B55]\" data-kid=\"1-4-3-1\" data-name=\"bell icon\"></i>\n<span class=\"flex-1 text-[14px] font-medium leading-[19px] text-[#0C1626]\" data-kid=\"1-4-3-2\" data-name='menu item label \"Notifications\"'>Notifications</span>\n<span class=\"flex h-[19px] min-w-[19px] items-center justify-center rounded-full bg-[#F2761B] px-1.5 text-[11px] font-semibold leading-none text-white\" data-kid=\"1-4-3-3\" data-name=\"notification count badge\">2</span>\n<i class=\"ti ti-chevron-right text-[17px] text-[#AEB9C9]\" data-kid=\"1-4-3-4\" data-name=\"right chevron affordance icon\"></i>\n</a>\n<a class=\"flex items-center gap-3.5 border-b border-[#EDF1F6] px-4 py-[15px] transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-4-4\" data-name=\"Language menu item\" href=\"#\">\n<i class=\"ti ti-language text-[19px] leading-none text-[#132B55]\" data-kid=\"1-4-4-1\" data-name=\"language icon\"></i>\n<span class=\"flex-1 text-[14px] font-medium leading-[19px] text-[#0C1626]\" data-kid=\"1-4-4-2\" data-name='menu item label \"Language\"'>Language</span>\n<span class=\"text-[12.5px] leading-[16px] text-[#8A97AC]\" data-kid=\"1-4-4-3\" data-name='current language value \"English\"'>English</span>\n<i class=\"ti ti-chevron-right text-[17px] text-[#AEB9C9]\" data-kid=\"1-4-4-4\" data-name=\"right chevron affordance icon\"></i>\n</a>\n<a class=\"flex items-center gap-3.5 px-4 py-[15px] transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-4-5\" data-name=\"Help &amp; Support menu item\" href=\"#\">\n<i class=\"ti ti-headset text-[19px] leading-none text-[#132B55]\" data-kid=\"1-4-5-1\" data-name=\"headset support icon\"></i>\n<span class=\"flex-1 text-[14px] font-medium leading-[19px] text-[#0C1626]\" data-kid=\"1-4-5-2\" data-name='menu item label \"Help &amp; Support\"'>Help &amp; Support</span>\n<i class=\"ti ti-chevron-right text-[17px] text-[#AEB9C9]\" data-kid=\"1-4-5-3\" data-name=\"right chevron affordance icon\"></i>\n</a>\n</div>\n<div class=\"mx-5 mt-3 overflow-hidden rounded-[20px] border border-[#E4E9F0] bg-white\" data-kid=\"1-5\" data-name=\"appearance settings card\">\n<a class=\"flex items-center gap-3.5 px-4 py-[15px] transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-5-1\" data-name=\"Appearance menu item\" href=\"#\">\n<i class=\"ti ti-settings text-[19px] leading-none text-[#132B55]\" data-kid=\"1-5-1-1\" data-name=\"appearance settings icon\"></i>\n<span class=\"flex-1 text-[14px] font-medium leading-[19px] text-[#0C1626]\" data-kid=\"1-5-1-2\" data-name='menu item label \"Appearance\"'>Appearance</span>\n<span class=\"text-[12.5px] leading-[16px] text-[#8A97AC]\" data-kid=\"1-5-1-3\" data-name='current theme value \"Light\"'>Light</span>\n<i class=\"ti ti-chevron-right text-[17px] text-[#AEB9C9]\" data-kid=\"1-5-1-4\" data-name=\"right chevron affordance icon\"></i>\n</a>\n</div>\n<div class=\"px-5 pt-4\" data-kid=\"1-6\" data-name=\"sign out action area\">\n<button class=\"h-11 w-full rounded-full border border-[#E4E9F0] bg-white text-[13.5px] font-medium text-[#55627A] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-6-1\" data-name=\"sign out button\" type=\"button\">Sign out</button>\n</div>\n<div class=\"pb-8\" data-kid=\"1-7\" data-name=\"bottom spacing spacer\"></div>\n</div>",
