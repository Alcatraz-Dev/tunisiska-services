      "html": "<div class=\"flex min-h-[844px] w-full flex-col bg-[#F4F6FA] text-[#0C1626] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Rubik',ui-sans-serif,system-ui,sans-serif\">\n<style>@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');</style>\n<style>@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");</style>\n<style>@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css\");</style>\n<!-- status bar -->\n<div class=\"flex items-center justify-between px-5 pb-1 pt-3.5\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span class=\"text-[15px] font-bold tracking-[-0.2px]\" data-kid=\"1-1-1\" data-name=\"status bar clock time\">9:41</span>\n<div class=\"flex items-center gap-1.5\" data-kid=\"1-1-2\" data-name=\"status bar right-side icons\">\n<span class=\"flex items-end gap-[2px]\" data-kid=\"1-1-2-1\" data-name=\"cellular signal bars icon\">\n<span class=\"h-[4px] w-[3px] rounded-[1px] bg-[#0C1626]\" data-kid=\"1-1-2-1-1\" data-name=\"signal bar\"></span>\n<span class=\"h-[6px] w-[3px] rounded-[1px] bg-[#0C1626]\" data-kid=\"1-1-2-1-2\" data-name=\"signal bar\"></span>\n<span class=\"h-[8px] w-[3px] rounded-[1px] bg-[#0C1626]\" data-kid=\"1-1-2-1-3\" data-name=\"signal bar\"></span>\n<span class=\"h-[10px] w-[3px] rounded-[1px] bg-[#0C1626]/25\" data-kid=\"1-1-2-1-4\" data-name=\"inactive signal bar\"></span>\n</span>\n<i class=\"ph ph-wifi-high text-[15px] text-[#0C1626]\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\"></i>\n<span class=\"ml-0.5 flex h-[11px] w-[23px] items-center rounded-[3px] border border-[#0C1626]/30 p-[1.5px]\" data-kid=\"1-1-2-3\" data-name=\"battery indicator outline\">\n<span class=\"block h-full w-[72%] rounded-[1.5px] bg-[#0C1626]\" data-kid=\"1-1-2-3-1\" data-name=\"battery level fill\"></span>\n</span>\n</div>\n</div>\n<!-- header -->\n<div class=\"px-5 pt-1.5\" data-kid=\"1-2\" data-name=\"page header block\">\n<div class=\"flex items-start justify-between\" data-kid=\"1-2-1\" data-name=\"header row\">\n<div data-kid=\"1-2-1-1\" data-name=\"header title group\">\n<h1 class=\"text-[26px] font-extrabold leading-[33px] tracking-[-0.4px]\" data-kid=\"1-2-1-1-1\" data-name=\"page title heading\">Trips</h1>\n<p class=\"mt-0.5 text-[12.5px] font-semibold text-[#55627A]\" data-kid=\"1-2-1-1-2\" data-name=\"subtitle route text\">Tunisia → Sweden</p>\n</div>\n<button class=\"grid size-11 place-items-center rounded-full border border-[#E4E9F0] bg-white text-[#0C1626]\" data-kid=\"1-2-1-2\" data-name=\"calendar action button\">\n<i class=\"ph ph-calendar-blank text-[19px]\" data-kid=\"1-2-1-2-1\" data-name=\"calendar icon\"></i>\n</button>\n</div>\n</div>\n<!-- direction traveller -->\n<div class=\"mt-3 px-5\" data-kid=\"1-3\" data-name=\"direction traveller section\">\n<button class=\"flex h-[64px] w-full items-center justify-between rounded-[14px] border border-[#E4EAF4] bg-[#F2F5FA] px-3.5\" data-kid=\"1-3-1\" data-name=\"route direction selector button\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-3-1-1\" data-name=\"origin endpoint group\">\n<svg class=\"h-[13px] w-5 overflow-hidden rounded-[2px]\" data-kid=\"1-3-1-1-1\" data-name=\"Tunisia flag icon\" viewbox=\"0 0 16 10\">\n<rect fill=\"#E70013\" height=\"10\" width=\"16\"></rect>\n<circle cx=\"8.4\" cy=\"5\" fill=\"#FFFFFF\" r=\"3.1\"></circle>\n<circle cx=\"9.2\" cy=\"5\" fill=\"#E70013\" r=\"2.5\"></circle>\n<circle cx=\"9.7\" cy=\"5\" fill=\"#E70013\" r=\"0.5\"></circle>\n</svg>\n<span class=\"text-[12.5px] font-bold text-[#132B55]\" data-kid=\"1-3-1-1-2\" data-name=\"origin country name\">Tunisia</span>\n</div>\n<div class=\"relative mx-2 h-[18px] flex-1\" data-kid=\"1-3-1-2\" data-name=\"route path track container\">\n<svg class=\"absolute inset-0 h-full w-full\" data-kid=\"1-3-1-2-1\" data-name=\"dashed travel route line icon\" preserveaspectratio=\"none\"