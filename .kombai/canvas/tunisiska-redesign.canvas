      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap');\n*{box-sizing:border-box}body{margin:0}.newsapp{width:393px;height:852px;overflow:hidden;background:#f4f6fa;color:#0c1626;font-family:Rubik,Arial,sans-serif;position:relative}.status{height:58px;padding:17px 27px 0;display:flex;justify-content:space-between;align-items:flex-start;font-size:13px;font-weight:600}.status-icons{color:#101828;font-size:12px;letter-spacing:4px}.head{display:flex;align-items:center;gap:15px;padding:16px 18px 20px}.back{width:48px;height:48px;flex:0 0 auto;display:grid;place-items:center;border-radius:50%;background:#fff;border:1px solid #e1e7ef;color:#132b55;box-shadow:0 6px 16px #1018280c;font-size:26px;text-decoration:none}.headcopy{min-width:0}.headcopy h1{font-size:25px;letter-spacing:-.03em;margin:0;font-weight:700}.headcopy p{font-size:12px;color:#58677f;margin:4px 0 0}.scroll{height:calc(100% - 190px);overflow:hidden;padding:0 18px 14px;display:grid;align-content:start;gap:13px}.featured{background:#fff;border:1px solid #e4e9f0;border-radius:21px;overflow:hidden;box-shadow:0 9px 24px #1018280b}.featured img{width:100%;height:165px;object-fit:cover;display:block}.featurebody{padding:16px}.eyebrow{font-size:10px;color:#d76511;letter-spacing:.07em;text-transform:uppercase;font-weight:700}.featurebody h2{font-size:18px;margin:7px 0 6px;line-height:1.25}.featurebody p{font-size:12px;line-height:1.5;color:#58677f;margin:0}.timestamp{font-size:10px;color:#8a97ac;margin-top:10px}.compact{display:flex;align-items:flex-start;gap:12px;padding:15px;background:#fff;border:1px solid #e4e9f0;border-radius:18px;box-shadow:0 7px 18px #10182809}.compacticon{width:39px;height:39px;flex:0 0 auto;display:grid;place-items:center;border-radius:13px;background:#eff3f9;color:#132b55;font-size:18px}.compact h3{font-size:14px;margin:1px 0 5px}.compact p{font-size:11px;line-height:1.45;color:#58677f;margin:0}.bottom{position:absolute;bottom:0;left:0;width:100%;height:82px;background:#fff;border-top:1px solid #e3e8ef;display:flex;align-items:center;justify-content:space-around;padding:0 8px 6px}.tab{display:grid;justify-items:center;gap:4px;color:#8a97ac;font-size:10px;font-weight:600}.tab i{font-style:normal;font-size:19px}.tab.active{color:#f2761b}.tab.active i{display:grid;place-items:center;width:54px;height:27px;border-radius:999px;background:#fff0e4}\n</style>\n<div class=\"newsapp\"><div class=\"status\"><span>19:38</span><span class=\"status-icons\">••••　◆　▰</span></div><header class=\"head\"><a class=\"back\" href=\"#home\" aria-label=\"Back\">‹</a><div class=\"headcopy\"><h1>News</h1><p>The latest from Tunisiska</p></div></header><main class=\"scroll\"><article class=\"featured\"><img src=\"data:image/webp;base64,\" alt=\"Real image from the Tunisiska news screen\"><div class=\"featurebody\"><span class=\"eyebrow\">Service update</span><h2>Plan your next move</h2><p>Browse services and plan the details for your journey between Sweden and Tunisia.</p><div class=\"timestamp\">A recent update</div></div></article><article class=\"compact\"><span class=\"compacticon\">◷</span><div><h3>Departure information</h3><p>Review upcoming trips and cargo capacity in the app.</p><div class=\"timestamp\">Route updates</div></div></article></main><nav class=\"bottom\"><span class=\"tab\"><i>⌂</i>Home</span><span class=\"tab\"><i>▦</i>Trips</span><span class=\"tab active\"><i>▤</i>News</span><span class=\"tab\"><i>○</i>Profile</span></nav></div>",
