      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n*{box-sizing:border-box}body{margin:0}.tm{font-family:Rubik,system-ui,sans-serif;color:#0C1626;background:#F4F6FA;-webkit-font-smoothing:antialiased;--navy:#132B55;--navy-dark:#0B1B33;--orange:#F2761B;--ink:#0C1626;--muted:#55627A;--soft:#606F87;--line:#E4E9F0;--surface:#fff;--ground:#F4F6FA;--r:18px}\n.tm a{color:inherit;text-decoration:none}.shell{width:min(1200px,calc(100% - 64px));margin:auto}.site-head{height:82px;display:flex;align-items:center;background:#fff;border-bottom:1px solid var(--line)}.head-inner{display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:12px;min-width:245px}.brand-mark{height:42px;width:42px;border-radius:13px;background:#132B55;color:#FFFFFF;display:grid;place-items:center;font-size:21px}.brand strong{display:block;font-size:16px;line-height:1.1;font-weight:800}.brand small{display:block;margin-top:4px;color:var(--muted);font-size:12px}.nav{display:flex;align-items:center;gap:32px;color:#34435D;font-size:14px;font-weight:600}.nav a:hover{color:var(--orange)}.head-actions{display:flex;align-items:center;gap:12px}.lang{font-size:13px;color:var(--muted);padding:10px}.btn{height:48px;border:0;border-radius:12px;padding:0 20px;display:inline-flex;align-items:center;justify-content:center;gap:9px;font:700 14px Rubik, sans-serif;cursor:pointer}.btn-orange{background:#F2761B;color:#0C1626}.btn-navy{background:#132B55;color:#FFFFFF}.btn-white{background:#fff;color:var(--navy)}.btn-outline{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.54)}.hero{background:var(--navy-dark);color:white;position:relative;overflow:hidden}.hero-grid{min-height:510px;display:grid;grid-template-columns:1.04fr .96fr;align-items:center;gap:56px;padding-top:54px;padding-bottom:72px}.hero-copy{position:relative;z-index:1}.route-line{display:flex;align-items:center;gap:10px;color:#CFD8E8;font-size:13px;font-weight:600;margin-bottom:22px}.route-line i{color:var(--orange);font-size:17px}.hero h1{font-size:54px;line-height:1.05;letter-spacing:-1.7px;margin:0 0 20px;max-width:620px;font-weight:800}.hero p{font-size:18px;line-height:1.6;color:#D4DCE9;max-width:570px;margin:0}.actions{display:flex;gap:12px;margin-top:28px}.hero-photo{height:370px;position:relative;border-radius:24px;overflow:hidden;border:1px solid rgba(255,255,255,.2);background:#223A5D}.hero-photo img{width:100%;height:100%;object-fit:cover;display:block}.photo-cap{position:absolute;left:18px;bottom:18px;padding:12px 15px;border-radius:13px;background:#fff;color:var(--ink);font-size:13px;font-weight:700;box-shadow:0 10px 30px rgba(0,0,0,.15)}.photo-cap span{display:block;font-size:12px;color:var(--muted);font-weight:500;margin-top:4px}.search-wrap{position:relative;margin-top:-35px;z-index:2}.search-panel{display:grid;grid-template-columns:1fr 1fr 1fr auto;align-items:end;gap:14px;padding:20px;background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:none}.field label{display:block;color:var(--soft);font-size:12px;font-weight:700;margin:0 0 8px 3px}.select{height:48px;width:100%;border:1px solid var(--line);border-radius:11px;background:#F8FAFC;color:var(--ink);font:600 14px Rubik,sans-serif;padding:0 13px}.section{padding:82px 0}.section-white{background:#fff}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:30px}.section h2{font-size:34px;line-height:1.16;letter-spacing:-.8px;margin:0;font-weight:800}.section-lede{font-size:15px;line-height:1.55;color:var(--muted);max-width:560px;margin:10px 0 0}.text-link{display:inline-flex;align-items:center;gap:8px;color:var(--navy);font-weight:700;font-size:14px}.route-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.route-tile{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px}.route-tile:nth-child(2){background:#F0F4FA}.route-label{font-size:12px;color:var(--soft);font-weight:600;margin-bottom:9px}.route-name{font-size:23px;font-weight:800;letter-spacing:-.4px}.route-cities{font-size:14px;color:var(--muted);margin-top:6px}.round-arrow{width:44px;height:44px;border-radius:50%;background:#132B55;color:#FFFFFF;display:grid;place-items:center;font-size:20px}.service-layout{display:grid;grid-template-columns:.7fr 1.3fr;gap:70px;align-items:start}.service-intro{position:sticky;top:35px}.service-list{display:grid;grid-template-columns:1fr 1fr;column-gap:26px}.service-row{padding:20px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:42px 1fr 20px;gap:14px;align-items:start}.service-icon{width:38px;height:38px;border-radius:12px;background:#FFF1E7;color:var(--orange);display:grid;place-items:center;font-size:18px}.service-row h3{font-size:16px;margin:1px 0 7px;font-weight:700}.service-row p{font-size:13px;line-height:1.5;color:var(--muted);margin:0}.service-row .go{color:var(--soft);margin-top:4px}.process{display:grid;grid-template-columns:repeat(3,1fr);gap:36px}.process-item{border-top:2px solid var(--navy);padding-top:20px}.process-item .num{color:var(--orange);font-size:12px;font-weight:800}.process-item h3{font-size:18px;margin:11px 0 8px}.process-item p{margin:0;color:var(--muted);font-size:14px;line-height:1.55}.cta-band{background:var(--navy);color:#fff;border-radius:22px;padding:36px 40px;display:flex;align-items:center;justify-content:space-between;gap:28px}.cta-band h2{font-size:28px;margin:0 0 8px;letter-spacing:-.6px}.cta-band p{font-size:14px;color:#D4DCE9;margin:0;line-height:1.5}.site-foot{background:#0B1B33;color:#fff;padding:48px 0 28px}.foot-top{display:flex;justify-content:space-between;gap:50px;padding-bottom:34px;border-bottom:1px solid rgba(255,255,255,.15)}.foot-brand{max-width:310px}