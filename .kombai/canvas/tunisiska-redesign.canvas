d{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.capacity-grid span{height:19px;border:1px dashed var(--orange);border-radius:5px;background:rgba(242,118,27,.08)}.service-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.detail-feature{background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px}.detail-feature h3{font-size:18px;margin:15px 0 8px}.detail-feature p{font-size:14px;line-height:1.55;color:var(--muted);margin:0}.faq{display:grid;grid-template-columns:.7fr 1.3fr;gap:60px}.faq-item{padding:19px 0;border-top:1px solid var(--line)}.faq-item h3{font-size:15px;margin:0 0 8px}.faq-item p{font-size:13px;line-height:1.55;color:var(--muted);margin:0}\n@media(max-width:850px){.app-preview{height:470px}.phone-shell{width:252px;height:452px}.phone-float{left:calc(50% - 215px);bottom:70px}.phone-caption{right:calc(50% - 180px)}.shell{width:min(100% - 36px,680px)}.site-head{height:70px}.brand{min-width:0}.nav{display:none}.head-actions{gap:4px}.lang{display:none}.hero-grid{grid-template-columns:1fr;gap:28px;padding:52px 0 70px}.hero h1{font-size:42px}.hero-photo{height:260px}.search-panel{grid-template-columns:1fr 1fr}.search-panel .btn{grid-column:1/-1}.section{padding:58px 0}.section-head{align-items:start;flex-direction:column}.service-layout,.page-hero-grid,.info-row,.faq{grid-template-columns:1fr;gap:32px}.service-intro{position:static}.service-list{grid-template-columns:1fr}.process{grid-template-columns:1fr;gap:24px}.route-grid{grid-template-columns:1fr}.page-hero{padding:52px 0 42px}.page-hero h1{font-size:38px}.cta-band{align-items:start;flex-direction:column;padding:28px}.foot-top{flex-direction:column}.foot-links{gap:36px}.foot-bottom{gap:12px;flex-direction:column}.service-detail-grid{grid-template-columns:1fr}}\n@media(max-width:480px){.app-preview{height:410px}.phone-shell{width:226px;height:392px;border-radius:32px}.phone-screen{border-radius:24px;padding:0 10px}.phone-welcome{height:100px}.phone-welcome strong{f