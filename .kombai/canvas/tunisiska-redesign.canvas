    "var_e2ce7957e140": {
      "type": "variant",
      "label": "Track Your Shipment — progress and stages",
      "parentId": "var_b44e3e56ccc4",
      "themeId": null,
      "rect": {
        "x": 5312,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .rk{font-family:'Rubik',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;}\n</style>\n<div class=\"rk w-full max-w-[393px] mx-auto min-h-[852px] bg-[#F7F9FC] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"flex items-center justify-between px-7 pt-3.5 pb-1\" data-kid=\"1-1\" data-name=\"mobile status bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-1-1\" data-name=\"clock time display\">9:41</span>\n<div class=\"flex items-center gap-1.5 text-[#0C1626] text-[15px] leading-none\" data-kid=\"1-1-2\" data-name=\"connection status indicators group\">\n<i class=\"ti ti-antenna-bars-5\" data-kid=\"1-1-2-1\" data-name=\"antenna signal bars icon\"></i>\n<i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi connection icon\"></i>\n<i class=\"ti ti-battery-3\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<header class=\"flex items-center gap-1 px-4 pt-2\" data-kid=\"1-2\" data-name=\"app header with navigation\">\n<button aria-label=\"Back\" class=\"-ml-1 flex h-10 w-10 items-center justify-center rounded-full text-[22px] text-[#0C1626] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-2-1\" data-name=\"back navigation button\" type=\"button\">\n<i class=\"ti ti-chevron-left\" data-kid=\"1-2-1-1\" data-name=\"back chevron left icon\"></i>\n</button>\n<h1 class=\"flex-1 text-[20px] font-bold leading-[26px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-2-2\" data-name=\"header title text\">Track Your Shipment</h1>\n</header>\n<div class=\"relative mx-auto mt-8 h-[178px] w-[178px]\" data-kid=\"1-3\" data-name=\"shipment status progress ring container\">\n<svg aria-hidden=\"true\" class=\"absolute inset-0 -rotate-90\" data-kid=\"1-3-1\" data-name=\"progress ring background track\" viewbox=\"0 0 178 178\">\n<circle cx=\"89\" cy=\"89\" fill=\"none\" r=\"81\" stroke=\"#EDF1F6\" stroke-width=\"10\"></circle>\n<circle cx=\"89\" cy=\"89\" fill=\"none\" r=\"81\" stroke=\"#F2761B\" stroke-dasharray=\"509\" stroke-dashoffset=\"176\" stroke-linecap=\"round\" stroke-width=\"10\"></circle>\n</svg>\n<div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"1-3-2\" data-name=\"center icon wrapper\">\n<div class=\"flex h-[104px] w-[104px] items-center justify-center rounded-full bg-[#FFF4EC] text-[42px] text-[#F2761B]\" data-kid=\"1-3-2-1\" data-name=\"package icon badge\">\n<i class=\"ti ti-package\" data-kid=\"1-3-2-1-1\" data-name=\"package box icon\"></i>\n</div>\n</div>\n</div>\n<p class=\"mt-7 text-center text-[22px] font-bold leading-[28px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-4\" data-name=\"shipment status headline\">In Transit</p>\n<p class=\"mx-auto mt-1.5 max-w-[240px] text-center text-[13.5px] leading-[19px] text-[#55627A]\" data-kid=\"1-5\" data-name=\"shipment status description text\">Your package is on the way to Tunis.</p>\n<div class=\"relative mx-5 mt-9\" data-kid=\"1-6\" data-name=\"shuttle tracking progress bar\">\n<div class=\"absolute left-[12.5%] right-[12.5%] top-[12px] h-[2px] bg-[#E4E9F0]\" data-kid=\"1-6-1\" data-name=\"progress line background\">\n<div class=\"h-full w-[62%] rounded-full bg-[#132B55]\" data-kid=\"1-6-1-1\" data-name=\"progress line indicator\"></div>\n</div>\n<div class=\"relative grid grid-cols-4\" data-kid=\"1-6-2\" data-name=\"shuttle tracking timeline steps\">\n<div class=\"flex flex-col items-center gap-2\" data-kid=\"1-6-2-1\" data-name=\"completed step (Booked)\">\n<span class=\"flex h-[24px] w-[24px] items-center justify-center rounded-full bg-[#132B55] text-[12px] text-white\" data-kid=\"1-6-2-1-1\" data-name=\"completed step indicator icon\">\n<i class=\"ti ti-check\" data-kid=\"1-6-2-1-1-1\" data-name=\"checkmark icon\"></i>\n</span>\n<span class=\"text-[11px] leading-[14px] text-[#55627A]\" data-kid=\"1-6-2-1-2\" data-name=\"step label text (Booked)\">Booked</span>\n</div>\n<div class=\"flex flex-col items-center gap-2\" data-kid=\"1-6-2-2\" data-name=\"completed step (Picked Up)\">\n<span class=\"flex h-[24px] w-[24px] items-center justify-center rounded-full bg-[#132B55] text-[12px] text-white\" data-kid=\"1-6-2-2-1\" data-name=\"completed step indicator icon\">\n<i class=\"ti ti-check\" data-kid=\"1-6-2-2-1-1\" data-name=\"checkmark icon\"></i>\n</span>\n<span class=\"text-[11px] leading-[14px] text-[#55627A]\" data-kid=\"1-6-2-2-2\" data-name=\"step label text (Picked Up)\">Picked Up</span>\n</div>\n<div class=\"flex flex-col items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-6-2-3\" data-name=\"active step (In Transit)\" data-reason=\"highlighted as current step by styling\">\n<span class=\"flex h-[24px] w-[24px] items-center justify-center rounded-full bg-white ring-[3px] ring-[#F2761B] shadow-[0_8px_18px_-10px_rgba(242,118,27,0.9)]\" data-kid=\"1-6-2-3-1\" data-name=\"active step indicator ring\">\n<span class=\"h-[7px] w-[7px] rounded-full bg-[#F2761B]\" data-kid=\"1-6-2-3-1-1\" data-name=\"active step indicator dot\"></span>\n</span>\n<span class=\"text-[11px] font-semibold leading-[14px] text-[#F2761B]\" data-kid=\"1-6-2-3-2\" data-name=\"active step label (In Transit)\">In Transit</span>\n</div>\n<div class=\"flex flex-col items-center gap-2\" data-kid=\"1-6-2-4\" data-name=\"pending step (Delivered)\">\n<span class=\"h-[24px] w-[24px] rounded-full border-[1.5px] border-[#D3DBE6] bg-white\" data-kid=\"1-6-2-4-1\" data-name=\"empty step indicator circle\"></span>\n<span class=\"text-[11px] leading-[14px] text-[#AEB9C9]\" data-kid=\"1-6-2-4-2\" data-name=\"pending step label (Delivered)\">Delivered</span>\n</div>\n</div>\n</div>\n<div class=\"mx-5 mt-8 rounded-[20px] border border-[#E4E9F0] bg-white px-4\" data-kid=\"1-7\" data-name=\"shipment details card\">\n<div class=\"flex items-center justify-between gap-4 border-b border-[#EDF1F6] py-[13px]\" data-kid=\"1-7-1\" data-name=\"detail row (Route)\">\n<span class=\"text-[12.5px] leading-[16px] text-[#55627A]\" data-kid=\"1-7-1-1\" data-name=\"detail label (Route)\">Route</span>\n<span class=\"flex items-center gap-1.5 text-[13px] font-medium leading-[17px] text-[#0C1626]\" data-kid=\"1-7-1-2\" data-name=\"detail value (Stockholm to Tunis)\">\n        Stockholm → Tunis\n      </span>\n</div>\n<div class=\"flex items-center justify-between gap-4 border-b border-[#EDF1F6] py-[13px]\" data-kid=\"1-7-2\" data-name=\"detail row (Tracking)\">\n<span class=\"text-[12.5px] leading-[16px] text-[#55627A]\" data-kid=\"1-7-2-1\" data-name=\"detail label (Tracking)\">Tracking</span>\n<span class=\"flex items-center gap-1.5 text-[13px] font-medium leading-[17px] text-[#0C1626]\" data-kid=\"1-7-2-2\" data-name=\"detail value (tracking number)\">\n        TMT-2411504\n        <i class=\"ti ti-share text-[13px] text-[#AEB9C9]\" data-kid=\"1-7-2-2-1\" data-name=\"share icon\"></i>\n</span>\n</div>\n<div class=\"flex items-center justify-between gap-4 py-[13px]\" data-kid=\"1-7-3\" data-name=\"detail row (Shipment)\">\n<span class=\"text-[12.5px] leading-[16px] text-[#55627A]\" data-kid=\"1-7-3-1\" data-name=\"detail label (Shipment)\">Shipment</span>\n<span class=\"text-[13px] font-medium leading-[17px] text-[#0C1626]\" data-kid=\"1-7-3-2\" data-name=\"detail value (2 parcels 24 kg)\">2 parcels · 24 kg</span>\n</div>\n</div>\n<div class=\"px-5 pt-5\" data-kid=\"1-8\" data-name=\"all shipments list action container\">\n<button class=\"flex w-full items-center justify-between rounded-[18px] border border-[#E4E9F0] bg-white px-4 py-3.5 text-left transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-8-1\" data-name=\"all shipments action button\" type=\"button\">\n<span class=\"text-[13.5px] font-medium leading-[18px] text-[#0C1626]\" data-kid=\"1-8-1-1\" data-name=\"action button label text\">All shipments</span>\n<i class=\"ti ti-chevron-right text-[17px] text-[#8A97AC]\" data-kid=\"1-8-1-2\" data-name=\"action button chevron icon\"></i>\n</button>\n</div>\n<div class=\"pb-8\" data-kid=\"1-9\" data-name=\"footer bottom padding spacer\"></div>\n</div>",
