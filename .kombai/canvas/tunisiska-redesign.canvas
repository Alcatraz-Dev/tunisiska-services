      "html": "\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap');\n*{box-sizing:border-box}body{margin:0}.rk{font-family:Rubik,system-ui,sans-serif;color:#0C1626;-webkit-font-smoothing:antialiased}\n:root{--navy:#132B55;--navy2:#1E3E75;--orange:#F2761B;--ink:#0C1626;--muted:#55627A;--soft:#8A97AC;--line:#E4E9F0;--canvas:#F4F6FA;--surface:#fff;--radius:20px}\n.i{width:18px;height:18px;display:inline-block;vertical-align:middle}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8A97AC}.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:0 2px 8px rgba(6,16,31,.05)}\n</style>\n\n<div class=\"rk\" style=\"width:1280px;min-height:920px;background:#F4F6FA;padding:44px 56px 56px\" data-kid=\"1\" data-name=\"Dynamic Island and Live Activity canvas board\">\n<header style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:32px\" data-kid=\"1-1\" data-name=\"Board header\">\n<div style=\"display:flex;align-items:center;gap:14px\" data-kid=\"auto-10\"><div style=\"width:42px;height:42px;border-radius:14px;background:#132B55;display:grid;place-items:center;color:#fff\" data-kid=\"auto-11\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-12\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><div data-kid=\"auto-13\"><div style=\"font-size:18px;font-weight:700\" data-kid=\"auto-14\">Tunisiska Mega</div><div style=\"font-size:12px;color:#55627A;margin-top:2px\" data-kid=\"auto-15\">Live Activity system</div></div></div>\n<div style=\"display:flex;align-items:center;gap:8px\" data-kid=\"auto-16\"><span style=\"border-radius:99px;padding:8px 12px;background:#fff;border:1px solid #E4E9F0;font-size:11px;font-weight:600;color:#55627A\" data-kid=\"auto-17\">LOCK SCREEN</span><span style=\"border-radius:99px;padding:8px 12px;background:#FFF4EC;border:1px solid #FFE7D4;font-size:11px;font-weight:700;color:#D65E0A\" data-kid=\"auto-18\">DYNAMIC ISLAND</span></div>\n</header>\n<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:start\" data-kid=\"auto-19\">\n<section style=\"padding-top:10px\" data-kid=\"1-2\" data-name=\"Dynamic Island product story\">\n<p class=\"eyebrow\" data-kid=\"auto-20\">TRIP STATUS, ALWAYS VISIBLE</p><h1 style=\"font-size:38px;line-height:1.12;letter-spacing:-1.1px;margin:12px 0 12px;max-width:520px\" data-kid=\"auto-21\">Your next departure, right where you need it.</h1><p style=\"font-size:15px;line-height:1.65;color:#55627A;max-width:470px;margin:0\" data-kid=\"auto-22\">A real-time trip card keeps the route, departure time and vehicle at a glance on the Lock Screen and Dynamic Island.</p>\n<div style=\"display:flex;gap:10px;margin-top:22px\" data-kid=\"auto-23\"><span style=\"display:flex;align-items:center;gap:7px;background:#fff;border:1px solid #E4E9F0;border-radius:999px;padding:9px 12px;font-size:11px;font-weight:600;color:#55627A\" data-kid=\"auto-24\"><span style=\"width:7px;height:7px;background:#17865B;border-radius:50%\" data-kid=\"auto-25\"></span>Live Activity enabled</span><span style=\"display:flex;align-items:center;gap:7px;background:#fff;border:1px solid #E4E9F0;border-radius:999px;padding:9px 12px;font-size:11px;font-weight:600;color:#55627A\" data-kid=\"auto-26\">iOS 16.2+</span></div>\n<div style=\"margin-top:28px;padding:17px 18px\" class=\"card\" data-kid=\"1-2-1\" data-name=\"Trip data source card\"><div class=\"eyebrow\" data-kid=\"auto-27\">NEXT DEPARTURE</div><div style=\"display:flex;align-items:center;justify-content:space-between;margin-top:10px\" data-kid=\"auto-28\"><div data-kid=\"auto-29\"><div style=\"font-size:18px;font-weight:700\" data-kid=\"auto-30\">Sweden <span style=\"color:#F2761B\" data-kid=\"auto-31\">→</span> Tunisia</div><div style=\"font-size:12px;color:#55627A;margin-top:5px\" data-kid=\"auto-32\">Stockholm → Tunis</div></div><div style=\"text-align:right\" data-kid=\"auto-33\"><div style=\"font-size:13px;font-weight:700\" data-kid=\"auto-34\">15 Nov · 14:00</div><div style=\"font-size:11px;color:#8A97AC;margin-top:5px\" data-kid=\"auto-35\">Cargo van</div></div></div></div>\n<div style=\"margin-top:18px;display:flex;gap:10px;align-items:center\" data-kid=\"auto-36\"><div style=\"width:30px;height:30px;border-radius:10px;background:#FFF4EC;color:#F2761B;display:grid;place-items:center\" data-kid=\"auto-37\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-38\"><path d=\"M4 12h16M14 6l6 6-6 6\"/></svg></div><div data-kid=\"auto-39\"><div style=\"font-size:12px;font-weight:700\" data-kid=\"auto-40\">One activity, four presentations</div><div style=\"font-size:11px;color:#55627A;margin-top:3px\" data-kid=\"auto-41\">Expanded, compact, minimal and Lock Screen</div></div></div>\n</section>\n<section style=\"display:flex;align-items:flex-start;justify-content:center;gap:22px\" data-kid=\"1-3\" data-name=\"Device preview pair\">\n<div style=\"width:320px;background:#111827;padding:10px;border-radius:38px;box-shadow:0 24px 50px rgba(12,22,38,.18)\" data-kid=\"1-3-1\" data-name=\"Lock Screen device frame\"><div style=\"height:610px;border-radius:30px;background:linear-gradient(160deg,#9BB1C8 0%,#637D98 44%,#263B54 100%);padding:22px 16px;position:relative;overflow:hidden\" data-kid=\"auto-42\"><div style=\"display:flex;justify-content:space-between;color:#fff;font-size:11px;font-weight:600\" data-kid=\"auto-43\"><span data-kid=\"auto-44\">9:41</span><span data-kid=\"auto-45\"><svg width=\"48\" height=\"14\" viewBox=\"0 0 48 14\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M1 12V9h3v3H1Zm5 0V6h3v6H6Zm5 0V3h3v9h-3Z\"/><path d=\"M19 5.2a7.1 7.1 0 0 1 10 0M21.5 7.8a3.6 3.6 0 0 1 5 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"24\" cy=\"10.5\" r=\".9\"/><rect x=\"34\" y=\"3\" width=\"11\" height=\"8\" rx=\"1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><rect x=\"36\" y=\"5\" width=\"7\" height=\"4\"/></svg></span></div><div style=\"text-align:center;color:#fff;margin-top:56px\" data-kid=\"auto-46\"><div style=\"font-size:54px;line-height:1;font-weight:500;letter-spacing:-2px\" data-kid=\"auto-47\">9:41</div><div style=\"font-size:13px;margin-top:9px;opacity:.9\" data-kid=\"auto-48\">Saturday, 15 November</div></div>\n<div style=\"margin-top:178px;padding:15px 14px;background:rgba(255,255,255,.94);border-radius:19px;box-shadow:0 10px 24px rgba(12,22,38,.13)\" data-kid=\"1-3-1-1\" data-name=\"Lock Screen live activity card\"><div style=\"display:flex;align-items:center;gap:11px\" data-kid=\"auto-49\"><div style=\"width:38px;height:38px;border-radius:13px;background:#FFF4EC;color:#F2761B;display:grid;place-items:center\" data-kid=\"auto-50\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-51\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><div style=\"flex:1\" data-kid=\"auto-52\"><div style=\"font-size:9px;font-weight:700;letter-spacing:.1em;color:#8A97AC;text-transform:uppercase\" data-kid=\"auto-53\">NEXT DEPARTURE</div><div style=\"font-size:13px;font-weight:700;margin-top:4px\" data-kid=\"auto-54\">15 Nov · 14:00</div></div><div style=\"width:28px;height:28px;border-radius:50%;border:3px solid #FFE7D4;border-top-color:#F2761B;transform:rotate(-35deg)\" data-kid=\"auto-55\"></div></div><div style=\"font-size:12px;font-weight:700;color:#132B55;margin:12px 0 0 49px\" data-kid=\"auto-56\">Sweden → Tunisia</div><div style=\"display:flex;align-items:center;gap:6px;margin:8px 0 0 49px;font-size:10px;color:#55627A\" data-kid=\"auto-57\"><span data-kid=\"auto-58\">Stockholm → Tunis</span><span style=\"margin-left:auto;font-weight:600;color:#132B55\" data-kid=\"auto-59\">Cargo van</span></div></div>\n<div style=\"position:absolute;bottom:20px;left:35%;width:30%;height:4px;border-radius:9px;background:rgba(255,255,255,.9)\" data-kid=\"auto-60\"></div></div></div>\n<div style=\"width:360px;margin-top:35px\" data-kid=\"1-3-2\" data-name=\"Dynamic Island states\"><div class=\"eyebrow\" style=\"margin:0 0 11px 4px\" data-kid=\"auto-61\">EXPANDED</div><div style=\"background:#08080A;color:#fff;border-radius:28px;padding:13px 15px;box-shadow:0 18px 40px rgba(8,8,10,.22)\" data-kid=\"1-3-2-1\" data-name=\"Expanded Dynamic Island preview\"><div style=\"display:flex;align-items:center;gap:12px\" data-kid=\"auto-62\"><div style=\"width:34px;height:34px;border-radius:50%;background:#FFF4EC;color:#F2761B;display:grid;place-items:center\" data-kid=\"auto-63\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-64\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><div style=\"flex:1\" data-kid=\"auto-65\"><div style=\"font-size:9px;color:#8A97AC\" data-kid=\"auto-66\">Next departure</div><div style=\"font-size:12px;font-weight:700;margin-top:3px\" data-kid=\"auto-67\">Sweden → Tunisia</div></div><div style=\"text-align:right\" data-kid=\"auto-68\"><div style=\"font-size:11px;font-weight:700\" data-kid=\"auto-69\">15 Nov · 14:00</div><div style=\"font-size:9px;color:#8A97AC;margin-top:4px\" data-kid=\"auto-70\">in 5 days</div></div></div><div style=\"height:1px;background:#25272D;margin:12px 0 10px\" data-kid=\"auto-71\"></div><div style=\"display:flex;align-items:center;gap:7px;font-size:10px;color:#AEB9C9\" data-kid=\"auto-72\"><svg class=\"i\" style=\"width:14px;height:14px;color:#6A85B4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-73\"><path d=\"M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg><span data-kid=\"auto-74\">Stockholm → Tunis</span><span style=\"margin-left:auto;color:#fff;font-weight:600\" data-kid=\"auto-75\">Cargo van</span><span style=\"width:20px;height:20px;border-radius:50%;border:2px solid #F2761B;display:grid;place-items:center;color:#fff;font-size:10px\" data-kid=\"auto-76\">↑</span></div></div>\n<div class=\"eyebrow\" style=\"margin:24px 0 11px 4px\" data-kid=\"auto-77\">COMPACT AND MINIMAL</div><div style=\"display:flex;align-items:center;gap:12px\" data-kid=\"auto-78\"><div style=\"height:42px;min-width:180px;background:#08080A;border-radius:99px;display:flex;align-items:center;padding:0 12px;gap:9px;color:white\" data-kid=\"auto-79\"><div style=\"color:#F2761B\" data-kid=\"auto-80\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-81\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><span style=\"font-size:10px;font-weight:600\" data-kid=\"auto-82\">Sweden → Tunisia</span><span style=\"margin-left:auto;font-size:10px;color:#F2761B\" data-kid=\"auto-83\">14:00</span></div><div style=\"width:42px;height:42px;border-radius:50%;background:#08080A;color:#F2761B;display:grid;place-items:center\" data-kid=\"auto-84\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-85\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div></div></div>\n</section></div>\n<div style=\"margin-top:28px;padding-top:16px;border-top:1px solid #E4E9F0;display:flex;justify-content:space-between;color:#8A97AC;font-size:10px\" da