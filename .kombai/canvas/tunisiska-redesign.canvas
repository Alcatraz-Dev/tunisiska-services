      "html": "<style data-kid=\"1-1\" data-name=\"style element\">@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");.rk{font-family:'Rubik',system-ui,sans-serif;-webkit-font-smoothing:antialiased}</style><main class=\"rk mx-auto flex min-h-[852px] w-full max-w-[393px] flex-col overflow-hidden bg-[#F7F9FC]\" data-kid=\"1-2\" data-name=\"mobile app screen container\"><div class=\"flex items-center justify-between px-7 pt-3.5 pb-1 text-[15px] font-semibold text-[#0C1626]\" data-kid=\"1-3\" data-name=\"layout container\"><span data-kid=\"1-4\" data-name=\"visual detail\">9:41</span><span class=\"flex gap-1.5\" data-kid=\"1-5\" data-name=\"visual detail\"><i class=\"ti ti-antenna-bars-5\" data-kid=\"1-6\" data-name=\"interface icon\"></i><i class=\"ti ti-wifi\" data-kid=\"1-7\" data-name=\"interface icon\"></i><i class=\"ti ti-battery-3\" data-kid=\"1-8\" data-name=\"interface icon\"></i></span></div><header class=\"flex items-center gap-3 px-5 pt-3 pb-4\" data-kid=\"1-9\" data-name=\"screen header\"><span class=\"flex h-10 w-10 items-center justify-center rounded-full border border-[#E4E9F0] bg-white text-[#132B55]\" data-kid=\"1-10\" data-name=\"visual detail\"><i class=\"ti ti-chevron-left\" data-kid=\"1-11\" data-name=\"interface icon\"></i></span><div data-kid=\"1-12\" data-name=\"layout container\"><h1 class=\"text-[20px] font-bold text-[#0C1626]\" data-kid=\"1-13\" data-name=\"screen title\">Notification preferences</h1><p class=\"mt-0.5 text-[12px] text-[#55627A]\" data-kid=\"1-14\" data-name=\"supporting text\">Alerts for your account</p></div></header><div class=\"flex-1 space-y-3.5 overflow-hidden px-5 pb-5\" data-kid=\"1-15\" data-name=\"layout container\"><section class=\"rounded-[18px] border border-[#E4E9F0] bg-white p-4 shadow-[0_10px_26px_-20px_rgba(12,22,38,0.45)]\" data-kid=\"1-16\" data-name=\"content card\"><div class=\"flex items-center gap-3\" data-kid=\"1-17\" data-name=\"layout container\"><span class=\"flex h-10 w-10 items-center justify-center rounded-[13px] bg-[#F2F5FA] text-[#132B55]\" data-kid=\"1-18\" data-name=\"visual detail\"><i class=\"ti ti-bell text-[19px]\" data-kid=\"1-19\" data-name=\"interface icon\"></i></span><div class=\"flex-1\" data-kid=\"1-20\" data-name=\"layout container\"><p class=\"text-[14px] font-bold\" data-kid=\"1-21\" data-name=\"supporting text\">Push notifications</p><p class=\"mt-0.5 text-[11px] text-[#55627A]\"] data-kid=\"1-22\" data-name=\"supporting text\">Allow alerts on this device</p></div><span class=\"h-6 w-11 rounded-full bg-[#132B55] p-1\" data-kid=\"1-23\" data-name=\"visual detail\"><span class=\"ml-auto block h-4 w-4 rounded-full bg-white\" data-kid=\"1-24\" data-name=\"visual detail\"></span></span></div></section><p class=\"px-1 text-[12px] leading-5 text-[#55627A]\"] data-kid=\"1-25\" data-name=\"supporting text\">Receive updates about bookings, shipments and departures. You can also manage notification permission in your device settings.</p></div></main>",
