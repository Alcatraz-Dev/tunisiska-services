      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n*{box-sizing:border-box}body{margin:0}.tm{font-family:Rubik,system-ui,sans-serif;color:#0C1626;background:#F4F6FA;-webkit-font-smoothing:antialiased;--navy:#132B55;--navy-dark:#0B1B33;--orange:#F2761B;--ink:#0C1626;--muted:#55627A;--soft:#606F87;--line:#E4E9F0;--surface:#fff;--ground:#F4F6FA;--r:18px}\n.tm a{color:inherit;text-decoration:none}.shell{width:min(1200px,calc(100% - 64px));margin:auto}.site-head{height:82px;display:flex;align-items:center;background:#fff;border-bottom:1px solid var(--line)}.head-inner{display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:12px;min-width:245px}.brand-mark{height:42px;width:42px;border-radius:13px;background:#132B55;color:#FFFFFF;display:grid;place-items:center;font-size:21px}.brand strong{display:block;font-size:16px;line-height:1.1;font-weight:800}.brand small{display:block;margin-top:4px;color:var(--muted);font-size:12px}.nav{display:flex;align-items:center;gap:32px;color:#34435D;font-size:14px;font-weight:600}.nav a:hover{color:var(--orange)}.head-actions{display:flex;align-items:center;gap:12px}.lang{font-size:13px;color:var(--muted);padding:10px}.btn{height:48px;border:0;border-radius:12px;padding:0 20px;display:inline-flex;align-items:center;justify-content:center;gap:9px;font:700 14px Rubik, sans-serif;cursor:pointer}.btn-orange{background:#F2761B;color:#0C1626}.btn-navy{background:#132B55;color:#FFFFFF}.btn-white{background:#fff;color:var(--navy)}.btn-outline{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.54)}.hero{background:var(--navy-dark);color:white;position:relative;overflow:hidden}.hero-grid{min-height:510px;display:grid;grid-template-columns:1.04fr .96fr;align-items:center;gap:56px;padding-top:54px;paddi