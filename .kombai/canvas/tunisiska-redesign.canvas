:264px;height:470px;border:7px solid #080D16;border-radius:38px;background:#080D16;padding:4px;transform:rotate(2deg);box-shadow:0 24px 54px rgba(0,0,0,.28);position:relative;z-index:1}.phone-screen{height:100%;width:100%;border-radius:28px;overflow:hidden;background:#F4F6FA;padding:0 13px;position:relative}.phone-top{height:24px;display:flex;align-items:center;justify-content:center}.phone-island{width:72px;height:16px;border-radius:99px;background:#080D16}.phone-app-brand{display:flex;align-items:center;gap:8px;margin:0 2px 12px}.phone-app-brand img{height:30px;width:30px;border-radius:8px}.phone-app-brand span{display:flex;flex-direction:column;gap:2px;flex:1}.phone-app-brand strong{font-size:11px;color:#0C1626}.phone-app-brand small{font-size:8px;color:#606F87}.phone-app-brand>i{font-size:16px;color:#132B55}.phone-welcome{height:126px;border-radius:15px;background:#132B55;padding:13px 12px;color:#fff;display:flex;flex-direction:column;justify-content:center;gap:5px}.phone-welcome small{font-size:8px;color:#CFD8E8;font-weight:700;letter-spacing:.08em}.phone-welcome strong{font-size:17px;line-height:1.12;letter-spacing:-.3px}.phone-welcome span{font-size:9px;color:#D4DCE9}.phone-section-title{display:flex;justify-content:space-between;align-items:center;margin:15px 1px 9px;font-size:10px;font-weight:700;color:#0C1626}.phone-section-title i{color:#F2761B;font-size:14px}.phone-route{height:45px;margin:6px 0;padding:5px 7px;border-radius:10px;border:1px solid #E4E9F0;background:#fff;display:flex;align-items:center;gap:5px}.phone-route>span:not(.flag-dot){display:flex;flex-direction:column;gap:1px;flex:1}.phone-route small{font-size:7px;color:#606F87;font-weight:600}.phone-route strong{font-size:9px;color:#0C1626}.phone-route>i{font-size:13px;color:#F2761B}.flag-dot{width:22px;height:22px;border-radius:7px;background:#E8EDF5;color:#132B55;display:grid;place-items:center;font-size:7px;font-weight:800;flex:none}.flag-tn{background:#FFF0E5;color:#A94400}.phone-next{height:43px;margin-top:10px;background:#fff;border:1px solid #E4E9F0;border-radius:10px;display:flex;align-items:center;gap:8px;padding:6px 8px}.phone-calendar{width:28px;height:28px;border-radius:8px;background:#F2F5FA;color:#132B55;display:grid;place-items:center}.phone-calendar i{font-size:15px}.phone-next>span:nth-child(2){display:flex;flex-direction:column;gap:2px;flex:1}.phone-next small{font-size:7px;color:#606F87}.phone-next strong{font-size:9px;color:#0C1626}.phone-next>i{font-size:13px;color:#8A97AC}.phone-tabbar{position:absolute;bottom:0;left:0;right:0;height:45px;border-top:1px solid #E4E9F0;background:#fff;display:flex;align-items:center;justify-content:space-around}.phone-tabbar span{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:7px;color:#606F87}.phone-tabbar i{font-size:13px}.phone-tabbar .active{color:#F2761B;font-weight:700}.phone-float{position:absolute;z-index:2;left:0;bottom:78px;width:228px;min-height:72px;padding:12px;border-radius:15px;background:#fff;color:#0C1626;display:flex;align-items:center;gap:10px;box-shadow:0 10px 28px rgba(6,16,31,.18)}.float-icon{width:38px;height:38px;border-radius:11px;background:#FFF1E7;color:#E45D08;display:grid;place-items:center;font-size:18px}.phone-float>span:nth-child(2){display:flex;flex-direction:column;gap:4px;flex:1}.phone-float strong{font-size:11px}.phone-float small{font-size:9px;color:#55627A}.phone-float>i{font-size:14px;color:#606F87}.phone-caption{position:absolute;right:46px;bottom:2px;color:#CFD8E8;font-size:10px;font-weight:600;letter-spacing:.02em}.hero-download{margin-top:26px}.hero-secondary{display:inline-flex;align-items:center;gap:7px;margin-top:18px;color:#E4E9F0;font-size:13px;font-weight:600}.hero-secondary:hover{color:#fff}\n</style><div class=\"tm\" style=\"width:1440px;min-height:100vh;background:#F4F6FA\"><div id=\"top\"><header class=\"site-head\"><div class=\"shell head-inner\"><a class=\"brand\" href=\"#top\"><img class=\"brand-logo\" src=\"data:image/png;base64,\" alt=\"Tunisiska Mega logo\"/><span><strong>Tunisiska Mega</strong><small>Transport</small></span></a><nav class=\"nav\"><a href=\"#trips\">Trips</a><a href=\"#services\">Services</a><a href=\"#how\">How it works</a><a href=\"#contact\">Contact</a></nav><div class=\"head-actions\"><span class=\"lang\">EN&nbsp;⌄</span><a class=\"btn btn-navy\" href=\"#download\">Get the app&nbsp; <i class=\"ti ti-arrow-up-right\"></i></a></div></div></header></div><main>\n<section class=\"page-hero\"><div class=\"shell page-hero-grid\"><div><h1>One place for trips,<br>shipping, and more.</h1><p>Explore the services available in the Tunisiska app and choose the next step that fits your plans.</p><div class=\"actions\"><a class=\"btn btn-orange\" href=\"#service-list\">Browse services <i class=\"ti ti-arrow-down\"></i></a><a class=\"btn btn-outline\" href=\"#download\">Get the app</a></div><div class=\"hero-download\"><div class=\"store-badges\" aria-label=\"Download the app\"><a class=\"store-badge\" href=\"https://apps.apple.com/tn/app/tunsiska-mega-services/id6765942795\" aria-label=\"Download Tunisiska Mega on the App Store\"><i class=\"ti ti-brand-apple\" aria-hidden=\"true\"></i><span><small>Download on the</small><strong>App Store</strong></span></a><a class=\"store-badge\" href=\"https://play.google.com/store/apps/details?id=com.alcatrazdev.tunisiskaservices\" aria-label=\"Get Tunisiska Mega on Google Play\"><i class=\"ti ti-brand-google-play\" aria-hidden=\"true\"></i><span><small>Get it on</small><strong>Google Play</strong></span></a></div></div></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px\"><div style=\"background:#fff;border-radius:16px;padding:22px;color:#0C1626\"><i class=\"ti ti-package\" style=\"font-size:22px;color:#F2761B\"></i><h2 style=\"font-size:16px;margin:16px 0 6px\">Ship a parcel</h2><p style=\"font-size:13px;line-height:1.5;color:#55627A;margin:0\">Between Sweden and Tunisia</p></div><div style=\"background:#E8EDF5;border-radius:16px;padding:22px;color:#0C1626\"><i class=\"ti ti-truck-delivery\" style=\"font-size:22px;color:#132B55\"></i><h2 style=\"font-size:16px;margin:16px 0 6px\">Book a trip</h2><p style=\"font-size:13px;line-height:1.5;color:#55627A;margin:0\">Check scheduled departures</p></div><div style=\"grid-column:1/-1;background:#F2761B;border-radius:16px;padding:22px;color:#0C1626;display:flex;align-items:center;justify-content:space-between\"><div><strong style=\"font-size:16px\">Keep a shipment in view</strong><div style=\"font-size:13px;margin-top:6px;color:#0C1626\">Use the tracking number in the app.</div></div><i class=\"ti ti-map-pin-check\" style=\"font-size:25px\"></i></div></div></div></section>\n<section class=\"section\" id=\"service-list\"><div class=\"shell service-layout\"><div class=\"service-intro\"><h2>Choose what you need.</h2><p class=\"section-lede\">Start with the service, then follow its booking flow in the app.</p><div style=\"margin-top:26px;padding:18px 0;border-top:1px solid #E4E9F0;border-bottom:1px solid #E4E9F0\"><div style=\"font-size:16px;font-weight:700;margin-top:8px\">Scheduled cargo van trips</div><a class=\"text-link\" href=\"#trips\" style=\"margin-top:11px\">Explore departures <i class=\"ti ti-arrow-right\"></i></a></div></div><div class=\"service-list\" style=\"grid-template-columns:1fr\"><a class=\"service-row\" href=\"#download\"><span class=\"service-icon\"><i class=\"ti ti-package\"></i></span><div><h3>Parcel shipping</h3><p>Send a package between Sweden and Tunisia. Add shipment details and choose a pickup and delivery location.</p><span class=\"text-link\" style=\"margin-top:13px\">Explore parcel shipping <i class=\"ti ti-arrow-right\"></i></span></div><i class=\"ti ti-arrow-up-right go\"></i></a><a class=\"service-row\" href=\"#download\"><span class=\"service-icon\"><i class=\"ti ti-box\"></i></span><div><h3>Container shipping</h3><p>Plan a larger shipment and review container schedule information.</p><span class=\"text-link\" style=\"margin-top:13px\">Explore containers <i class=\"ti ti-arrow-right\"></i></span></div><i class=\"ti ti-arrow-up-right go\"></i></a><a class=\"service-row\" href=\"#download\"><span class=\"service-icon\"><i class=\"ti ti-truck\"></i></span><div><h3>Moving</h3><p>Share pickup and destination details to request moving service.</p><span class=\"text-link\" style=\"margin-top:13px\">Plan a move <i class=\"ti ti-arrow-right\"></i></span></div><i class=\"ti ti-arrow-up-right go\"></i></a><a class=\"service-row\" href=\"#download\"><span class=\"service-icon\"><i class=\"ti ti-sparkles\"></i></span><div><h3>Moving &amp; cleaning</h3><p>Arrange a move and cleaning through a single service flow.</p><span class=\"text-link\" style=\"margin-top:13px\">Explore the service <i class=\"ti ti-arrow-right\"></i></span></div><i class=\"ti ti-arrow-up-right go\"></i></a><a class=\"service-row\" href=\"#download\"><span class=\"service-icon\"><i class=\"ti ti-car\"></i></span><div><h3>Airport taxi</h3><p>Enter your pickup, destination, and travel details to request a transfer.</p><span class=\"text-link\" style=\"margin-top:13px\">Arrange an airport taxi <i class=\"ti ti-arrow-right\"></i></span></div><i class=\"ti ti-arrow-up-right go\"></i></a></div></div></section>\n<section class=\"section section-white\" id=\"trips\"><div class=\"shell info-row\"><div class=\"capacity-panel\" style=\"background:#F0F4FA;color:#0C1626\"><h3 style=\"font-size:22px\">Need a trip instead?</h3><p style=\"color:#55627A\">Browse scheduled cargo van departures between Sweden and Tunisia.</p><div style=\"display:flex;gap:10px;align-items:center;margin-top:24px;padding-top:18px;border-top:1px solid #D8E0EC;font-size:14px;font-weight:700\"><span>Sweden</span><i class=\"ti ti-arrow-right\" style=\"color:#F2761B\"></i><span>Tunisia</span></div><div style=\"display:flex;gap:10px;align-items:center;margin-top:14px;font-size:14px;font-weight:700\"><span>Tunisia</span><i class=\"ti ti-arrow-right\" style=\"color:#F2761B\"></i><span>Sweden</span></div></div><div class=\"info-copy\"><h2>See the route before you book.</h2><p>Compare the two directions and check the current departure schedule in the app. You can also review trip capacity and details there.</p><a class=\"btn btn-navy\" href=\"#download\">Explore trips <i class=\"ti ti-arrow-up-right\"></i></a></div></div></section>\n<section class=\"section\"><div class=\"shell faq\"><div><h2>Questions before you start?</h2><p class=\"section-lede\">Find service details and current booking information in the app.</p></div><div><div class=\"faq-item\"><h3>Where do I check departure dates?</h3><p>Open Trips in the app to see the current schedule and departure details.</p></div><div class=\"faq-item\"><h3>Can I follow a shipment?</h3><p>Yes. Use the shipment tracking option and enter your tracking number.</p></div><div class=\"faq-item\"><h3>Where do I complete a booking?</h3><p>Choose a service in the app and follow its booking steps.</p></div></div></div></section>\n<section class=\"section\" id=\"download\" style=\"padding-top:0\"><div class=\"shell\"><div class=\"cta-band\"><div><h2>Choose a service and continue in the app.</h2><p>See trip schedules, booking details, and shipment updates in one place.</p></div><div class=\"store-badges\" aria-label=\"Download the app\"><a class=\"store-badge\" href=\"https://apps.apple.com/tn/app/tunsiska-mega-services/id6765942795\" aria-label=\"Download Tunisiska Mega on the App Store\"><i class=\"ti ti-brand-apple\" aria-hidden=\"true\"></i><span><small>Download on the</small><strong>App Store</strong></span></a><a class=\"store-badge\" href=\"https://play.google.com/store/apps/details?id=com.alcatrazdev.tunisiskaservices\" aria-label=\"Get Tunisiska Mega on Google Play\"><i class=\"ti ti-brand-google-play\" aria-hidden=\"true\"></i><span><small>Get it on</small><strong>Google Play</strong></span></a></div></div></div></section>\n</main><footer class=\"site-foot\" id=\"contact\"><div class=\"shell\"><div class=\"foot-top\"><div class=\"foot-brand\"><a class=\"brand\" href=\"#top\"><img class=\"brand-logo-footer\" src=\"data:image/png;base64,\" alt=\"Tunisiska Mega logo\"/><span><strong style=\"color:#fff\">Tunisiska Mega</strong><small style=\"color:#C7D3E6\">Transport</small></span></a><p>Explore trips and services between Sweden and Tunisia, then manage your booking in the app.</p></div><div class=\"foot-links\"><div><strong>Explore</strong><a href=\"#trips\">Trips</a><a href=\"#services\">Services</a><a href=\"#download\">Get the app</a></div><div><strong>Information</strong><a href=\"#contact\">Contact</a><a href=\"#\">Privacy policy</a><a href=\"#\">Terms of service</a></div></div></div><div class=\"foot-bottom\"><span>© 2026 Tunisiska Mega Transport</span><span>Sweden&nbsp; ↔ &nbsp;Tunisia</span></div></div></footer></div>"
    },
    "var_56274e756ea6": {
      "type": "variant",
      "label": "Press & Media — app style with back navigation",
