      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .rk{font-family:'Rubik',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;}\n</style>\n<div class=\"rk w-full max-w-[393px] mx-auto min-h-[852px] bg-[#F7F9FC] flex flex-col overflow-hidden\" data-kid=\"1\" data-name=\"mobile app screen container\">\n<div class=\"flex items-center justify-between px-7 pt-3.5 pb-1\" data-kid=\"1-1\" data-name=\"status bar with time and icons\">\n<span class=\"text-[15px] font-semibold tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-1-1\" data-name='status bar clock time \"9:41\"'>9:41</span>\n<div class=\"flex items-center gap-1.5 text-[#0C1626] text-[15px] leading-none\" data-kid=\"1-1-2\" data-name=\"system status icons group\">\n<i class=\"ti ti-antenna-bars-5\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\"></i>\n<i class=\"ti ti-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\"></i>\n<i class=\"ti ti-battery-3\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<header class=\"flex items-start justify-between px-5 pt-2\" data-kid=\"1-2\" data-name=\"page header with title and notifications\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1\" data-name=\"company logo group\">\n<svg aria-hidden=\"true\" data-kid=\"1-2-1-1\" data-name=\"custom road-and-arrow logo SVG\" fill=\"none\" height=\"30\" viewbox=\"0 0 48 36\" width=\"40\">\n<path d=\"M6 27C9 13 23 5 37 7.5\" stroke=\"#132B55\" stroke-linecap=\"round\" stroke-width=\"6\"></path>\n<path d=\"M31.5 1.5 43.5 6.4 37.8 17.2Z\" fill=\"#132B55\"></path>\n<path d=\"M9.5 30.5C18 24.5 29 22.2 39.5 22.4\" stroke=\"#F2761B\" stroke-linecap=\"round\" stroke-width=\"5\"></path>\n</svg>\n<div class=\"leading-none\" data-kid=\"1-2-1-2\" data-name=\"brand text container\">\n<p class=\"text-[16px] font-bold tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-2-1-2-1\" data-name=\"brand name text\">Tunisiska Mega</p>\n<p class=\"mt-1 text-[13px] font-normal tracking-[0.1px] text-[#55627A]\" data-kid=\"1-2-1-2-2\" data-name=\"brand descriptor text\">Transport</p>\n</div>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-2\" data-name=\"service and notification actions\">\n<button aria-label=\"Browse services\" class=\"flex h-10 w-10 items-center justify-center rounded-full border border-[#E4E9F0] bg-white text-[19px] text-[#132B55] shadow-[0_6px_16px_-10px_rgba(12,22,38,0.45)]\" data-kid=\"1-2-2-1\" data-name=\"services button\" type=\"button\"><i class=\"ti ti-layout-grid\" data-kid=\"1-2-2-1-1\" data-name=\"services icon\"></i></button>\n<button aria-label=\"Notifications\" class=\"relative flex h-10 w-10 items-center justify-center rounded-full border border-[#E4E9F0] bg-white text-[19px] text-[#132B55] shadow-[0_6px_16px_-10px_rgba(12,22,38,0.45)] transition-colors duration-200 hover:bg-[#F2F5FA]\" data-kid=\"1-2-2-2\" data-name=\"notifications button with badge\" type=\"button\">\n<i class=\"ti ti-bell\" data-kid=\"1-2-2-2-1\" data-name=\"bell icon\"></i>\n<span class=\"absolute right-2.5 top-2.5 h-2 w-2 rounded-full bg-[#F2761B] ring-2 ring-white\" data-kid=\"1-2-2-2-2\" data-name=\"notification indicator dot\"></span>\n</button>\n</div>\n</header>\n<div class=\"relative px-5 pt-6\" data-kid=\"1-3\" data-name=\"headline section\">\n<h1 class=\"max-w-[262px] text-[30px] font-extrabold leading-[35px] tracking-[-0.9px] text-[#0C1626]\" data-kid=\"1-3-1\" data-name=\"page headline text\">\n      Your transport between Sweden and Tunisia\n    </h1>\n</div>\n<div class=\"relative mt-4\" data-kid=\"1-4\" data-name=\"hero image with fade edges\">\n<img alt=\"Semi trucks on the Sweden to Tunisia route, photo by Quintin Gellar on Pexels\" class=\"h-[206px] w-full object-cover object-center\" data-kid=\"1-4-1\" data-name=\"hero photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/2199293/pexels-photo-2199293.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n<div class=\"pointer-events-none absolute inset-y-0 left-0 w-10 bg-gradient-to-r from-[#F7F9FC] to-transparent\" data-kid=\"1-4-2\" data-name=\"left edge fade gradient\"></div>\n<div class=\"pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#F7F9FC] via-[#F7F9FC]/45 to-transparent\" data-kid=\"1-4-3\" data-name=\"bottom edge fade gradient\"></div>\n<div class=\"pointer-events-none absolute inset-x-0 top-0 h-8 bg-gradient-to-b from-[#F7F9FC] to-transparent\" data-kid=\"1-4-4\" data-name=\"top edge fade gradient\"></div>\n</div>\n<div class=\"relative z-10 -mt-8 grid grid-cols-2 gap-3 px-5\" data-kid=\"1-5\" data-name=\"route selection grid container\">\n<button class=\"group flex flex-col rounded-[20px] border border-[#E4E9F0] bg-white p-4 text-left shadow-[0_16px_32px_-22px_rgba(12,22,38,0.5)] transition-transform duration-200 ease-out active:scale-[0.985]\" data-kid=\"1-5-1\" data-name=\"Sweden to Tunisia route button\" type=\"button\">\n<img alt=\"Flag of Sweden\" class=\"h-[22px] w-[32px] rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-5-1-1\" data-name=\"Sweden flag image\" decoding=\"async\" height=\"22\" loading=\"lazy\" src=\"https://flagcdn.com/w80/se.png\" width=\"32\"/>\n<p class=\"mt-3.5 text-[19px] font-bold leading-[23px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-5-1-2\" data-name=\"origin country name\">Sweden</p>\n<p class=\"my-0.5 text-[15px] leading-[18px] text-[#AEB9C9]\" data-kid=\"1-5-1-3\" data-name=\"route direction indicator\">→</p>\n<p class=\"text-[19px] font-bold leading-[23px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-5-1-4\" data-name=\"destination country name\">Tunisia</p>\n<span class=\"mt-4 flex h-9 w-9 items-center justify-center self-end rounded-full bg-[#132B55] text-[16px] text-white shadow-[0_8px_18px_-10px_rgba(19,43,85,0.9)]\" data-kid=\"1-5-1-5\" data-name=\"route action button icon\">\n<i class=\"ti ti-arrow-right\" data-kid=\"1-5-1-5-1\" data-name=\"arrow-right icon\"></i>\n</span>\n</button>\n<button class=\"group flex flex-col rounded-[20px] border border-[#E4E9F0] bg-white p-4 text-left shadow-[0_16px_32px_-22px_rgba(12,22,38,0.5)] transition-transform duration-200 ease-out active:scale-[0.985]\" data-kid=\"1-5-2\" data-name=\"Tunisia to Sweden route button\" type=\"button\">\n<img alt=\"Flag of Tunisia\" class=\"h-[22px] w-[32px] rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-5-2-1\" data-name=\"Tunisia flag image\" decoding=\"async\" height=\"22\" loading=\"lazy\" src=\"https://flagcdn.com/w80/tn.png\" width=\"32\"/>\n<p class=\"mt-3.5 text-[19px] font-bold leading-[23px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-5-2-2\" data-name=\"origin country name\">Tunisia</p>\n<p class=\"my-0.5 text-[15px] leading-[18px] text-[#AEB9C9]\" data-kid=\"1-5-2-3\" data-name=\"route direction indicator\">→</p>\n<p class=\"text-[19px] font-bold leading-[23px] tracking-[-0.4px] text-[#0C1626]\" data-kid=\"1-5-2-4\" data-name=\"destination country name\">Sweden</p>\n<span class=\"mt-4 flex h-9 w-9 items-center justify-center self-end rounded-full bg-[#132B55] text-[16px] text-white shadow-[0_8px_18px_-10px_rgba(19,43,85,0.9)]\" data-kid=\"1-5-2-5\" data-name=\"route action button icon\">\n<i class=\"ti ti-arrow-right\" data-kid=\"1-5-2-5-1\" data-name=\"arrow-right icon\"></i>\n</span>\n</button>\n</div>\n<button class=\"mx-5 mt-4 flex items-center gap-3.5 rounded-[20px] border border-[#E4E9F0] bg-white p-3.5 text-left shadow-[0_16px_32px_-24px_rgba(12,22,38,0.45)] transition-colors duration-200 hover:bg-[#FCFDFF]\" data-kid=\"1-6\" data-name=\"next departure info card\" type=\"button\">\n<span class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-[13px] bg-[#F2F5FA] text-[20px] text-[#132B55]\" data-kid=\"1-6-1\" data-name=\"calendar icon container\">\n<i class=\"ti ti-calendar\" data-kid=\"1-6-1-1\" data-name=\"calendar icon\"></i>\n</span>\n<span class=\"flex-1\" data-kid=\"1-6-2\" data-name=\"departure details text\">\n<span class=\"block text-[12.5px] leading-[16px] text-[#55627A]\" data-kid=\"1-6-2-1\" data-name=\"departure label text\">Next departure</span>\n<span class=\"mt-0.5 block text-[17px] font-bold leading-[22px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-6-2-2\" data-name=\"departure date and time\">15 November · 14:00</span>\n<span class=\"mt-0.5 block text-[12.5px] leading-[16px] text-[#55627A]\" data-kid=\"1-6-2-3\" data-name=\"departure route text\">Sweden → Tunisia</span>\n</span>\n<i class=\"ti ti-chevron-right text-[18px] text-[#8A97AC]\" data-kid=\"1-6-3\" data-name=\"go-to-details chevron icon\"></i>\n</button>\n<nav class=\"mt-auto border-t border-[#E4E9F0] bg-white px-2 pb-6 pt-3\" data-kid=\"1-7\" data-name=\"bottom navigation bar\">\n<div class=\"grid grid-cols-4\" data-kid=\"1-7-1\" data-name=\"navigation tabs grid\">\n<a class=\"flex flex-col items-center gap-1.5 text-[#F2761B]\" data-kid=\"1-7-1-1\" data-name=\"home navigation tab (active)\" href=\"#\">\n<i class=\"ti ti-home text-[22px] leading-none\" data-kid=\"1-7-1-1-1\" data-name=\"home icon\"></i>\n<span class=\"text-[10.5px] font-semibold leading-none\" data-kid=\"1-7-1-1-2\" data-name=\"home tab label text\">Home</span>\n</a>\n<a class=\"flex flex-col items-center gap-1.5 text-[#8A97AC]\" data-kid=\"1-7-1-2\" data-name=\"triips navigation tab\" href=\"#\">\n<i class=\"ti ti-calendar text-[22px] leading-none\" data-kid=\"1-7-1-2-1\" data-name=\"calendar icon\"></i>\n<span class=\"text-[10.5px] font-medium leading-none\" data-kid=\"1-7-1-2-2\" data-name=\"triips tab label text\">Trips</span>\n</a>\n<a class=\"flex flex-col items-center gap-1.5 text-[#8A97AC]\" data-kid=\"1-7-1-3\" data-name=\"news navigation tab\" href=\"#\">\n<i class=\"ti ti-file-text text-[22px] leading-none\" data-kid=\"1-7-1-3-1\" data-name=\"file-text icon\"></i>\n<span class=\"text-[10.5px] font-medium leading-none\" data-kid=\"1-7-1-3-2\" data-name=\"news tab label text\">News</span>\n</a>\n<a class=\"flex flex-col items-center gap-1.5 text-[#8A97AC]\" data-kid=\"1-7-1-4\" data-name=\"profile navigation tab\" href=\"#\">\n<i class=\"ti ti-user text-[22px] leading-none\" data-kid=\"1-7-1-4-1\" data-name=\"user icon\"></i>\n<span class=\"text-[10.5px] font-medium leading-none\" data-kid=\"1-7-1-4-2\" data-name=\"profile tab label text\">Profile</span>\n</a>\n</div>\n</nav>\n</div>",
