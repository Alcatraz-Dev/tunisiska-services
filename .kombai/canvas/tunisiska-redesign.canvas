      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .rk{font-family:'Rubik',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;}\n</style>\n<div class=\"rk relative w-full max-w-[393px] mx-auto min-h-[852px] bg-[#F7F9FC] overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n<section class=\"relative h-[272px]\" data-kid=\"1-1\" data-name=\"hero image section with status bar\">\n<img alt=\"Stockholm City Hall across the water at dusk, photo by Dawid Tkocz on Pexels\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-1-1\" data-name=\"hero background photo of Stockholm City Hall\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35015237/pexels-photo-35015237.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1000&amp;q=80\"/>\n<div class=\"pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0B1B33]/60 via-[#0B1B33]/15 to-transparent\" data-kid=\"1-1-2\" data-name=\"gradient overlay for top readability\"></div>\n<div class=\"absolute inset-x-0 top-0 flex items-center justify-between px-7 pt-3.5\" data-kid=\"1-1-3\" data-name=\"device status bar row\">\n<span class=\"text-[15px] font-semibold tracking-[-0.2px] text-white\" data-kid=\"1-1-3-1\" data-name=\"clock time text\">9:41</span>\n<div class=\"flex items-center gap-1.5 text-white text-[15px] leading-none\" data-kid=\"1-1-3-2\" data-name=\"device signal indicators group\">\n<i class=\"ti ti-antenna-bars-5\" data-kid=\"1-1-3-2-1\" data-name=\"antenna signal bars icon\"></i>\n<i class=\"ti ti-wifi\" data-kid=\"1-1-3-2-2\" data-name=\"wifi signal icon\"></i>\n<i class=\"ti ti-battery-3\" data-kid=\"1-1-3-2-3\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<div class=\"absolute inset-x-0 top-12 flex items-center justify-between px-4\" data-kid=\"1-1-4\" data-name=\"back and share action bar\">\n<button aria-label=\"Back\" class=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-[20px] text-[#0C1626] backdrop-blur transition-colors duration-200 hover:bg-white\" data-kid=\"1-1-4-1\" data-name=\"back navigation button\" type=\"button\">\n<i class=\"ti ti-chevron-left\" data-kid=\"1-1-4-1-1\" data-name=\"left chevron back icon\"></i>\n</button>\n<button aria-label=\"Share departure\" class=\"flex h-9 w-9 items-center justify-center rounded-full bg-white/85 text-[17px] text-[#0C1626] backdrop-blur transition-colors duration-200 hover:bg-white\" data-kid=\"1-1-4-2\" data-name=\"share button\" type=\"button\">\n<i class=\"ti ti-share\" data-kid=\"1-1-4-2-1\" data-name=\"share icon\"></i>\n</button>\n</div>\n</section>\n<div class=\"relative -mt-7 rounded-t-[26px] bg-[#F7F9FC] px-5 pb-8 pt-7\" data-kid=\"1-2\" data-name=\"main content card container\">\n<span class=\"absolute -top-[18px] left-5 rounded-full bg-white px-3.5 py-[7px] text-[12.5px] font-semibold leading-[16px] text-[#0C1626] shadow-[0_10px_22px_-14px_rgba(12,22,38,0.7)]\" data-kid=\"1-2-1\" data-name=\"departure date badge\">15 November 2025</span>\n<h1 class=\"text-[26px] font-extrabold leading-[32px] tracking-[-0.8px] text-[#0C1626]\" data-kid=\"1-2-2\" data-name=\"route title headline\">Sweden → Tunisia</h1>\n<div class=\"mt-4 rounded-[20px] border border-[#E4E9F0] bg-white px-4 py-4\" data-kid=\"1-2-3\" data-name=\"route summary card\">\n<div class=\"flex gap-3.5\" data-kid=\"1-2-3-1\" data-name=\"route card row with timeline\">\n<div class=\"flex flex-col items-center pt-2\" data-kid=\"1-2-3-1-1\" data-name=\"vertical route timeline connector\">\n<span class=\"h-[10px] w-[10px] shrink-0 rounded-full bg-[#F2761B]\" data-kid=\"1-2-3-1-1-1\" data-name=\"departure origin dot\"></span>\n<span class=\"my-1 w-px flex-1 bg-[#E4E9F0]\" data-kid=\"1-2-3-1-1-2\" data-name=\"timeline connecting line\"></span>\n<span class=\"h-[10px] w-[10px] shrink-0 rounded-full border-2 border-[#132B55] bg-white\" data-kid=\"1-2-3-1-1-3\" data-name=\"destination endpoint dot\"></span>\n</div>\n<div class=\"flex-1 space-y-[22px]\" data-kid=\"1-2-3-1-2\" data-name=\"route stops content column\">\n<div data-kid=\"1-2-3-1-2-1\" data-name=\"departure stop row\">\n<p class=\"text-[18px] font-bold leading-[23px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"departure time text\">14:00</p>\n<p class=\"mt-0.5 flex items-center gap-1.5 text-[13px] leading-[17px] text-[#55627A]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"departure city label with pin\">\n<i class=\"ti ti-map-pin text-[14px] text-[#AEB9C9]\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"map pin location icon\"></i>\n              Stockholm\n            </p>\n</div>\n<div data-kid=\"1-2-3-1-2-2\" data-name=\"arrival stop row\">\n<p class=\"text-[18px] font-bold leading-[23px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"arrival time placeholder dash\">—</p>\n<p class=\"mt-0.5 flex items-center gap-1.5 text-[13px] leading-[17px] text-[#55627A]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"arrival city label with pin\">\n<i class=\"ti ti-map-pin text-[14px] text-[#AEB9C9]\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"map pin location icon\"></i>\n              Tunis\n            </p>\n</div>\n</div>\n<span class=\"flex h-[26px] items-center rounded-full bg-[#F2F5FA] px-2.5 text-[11px] font-semibold leading-none text-[#132B55]\" data-kid=\"1-2-3-1-3\" data-name=\"truck delivery mode badge\">\n<i class=\"ti ti-truck mr-1.5 text-[13px]\" data-kid=\"1-2-3-1-3-1\" data-name=\"truck vehicle icon\"></i> Truck\n        </span>\n</div>\n</div>\n<section class=\"mt-4 rounded-[20px] border border-[#E4E9F0] bg-white p-4\" data-kid=\"1-2-4\" data-name=\"parcel delivery details card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-4-1\" data-name=\"parcel delivery header row\">\n<span class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#FFF4EC] text-[20px] text-[#F2761B]\" data-kid=\"1-2-4-1-1\" data-name=\"parcel icon container\">\n<i class=\"ti ti-package\" data-kid=\"1-2-4-1-1-1\" data-name=\"package box icon\"></i>\n</span>\n<h2 class=\"text-[17px] font-bold leading-[22px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-2-4-1-2\" data-name='section title \"Parcel Delivery\"'>Parcel Delivery</h2>\n</div>\n<p class=\"mt-4 text-[12.5px] leading-[16px] text-[#55627A]\" data-kid=\"1-2-4-2\" data-name='subheading \"In Tunisia:\"'>In Tunisia:</p>\n<button class=\"mt-1.5 flex h-11 w-full items-center justify-between rounded-[12px] bg-[#F2F5FA] px-3.5 text-[13px] text-[#55627A] transition-colors duration-200 hover:bg-[#EDF1F6]\" data-kid=\"1-2-4-3\" data-name=\"governorate selector dropdown button\" type=\"button\">\n        Select your governorate\n        <i class=\"ti ti-chevron-down text-[15px] text-[#8A97AC]\" data-kid=\"1-2-4-3-1\" data-name=\"chevron down dropdown indicator\"></i>\n</button>\n<div class=\"mt-2 divide-y divide-[#EDF1F6]\" data-kid=\"1-2-4-4\" data-name=\"governorate options list\">\n<label class=\"flex cursor-pointer items-center justify-between py-[11px]\" data-kid=\"1-2-4-4-1\" data-name=\"Tunis option row\">\n<span class=\"text-[13.5px] leading-[18px] text-[#0C1626]\" data-kid=\"1-2-4-4-1-1\" data-name=\"option label Tunis\">Tunis</span>\n<span class=\"h-[18px] w-[18px] rounded-full border-[1.5px] border-[#D3DBE6]\" data-kid=\"1-2-4-4-1-2\" data-name=\"radio selection circle\"></span>\n</label>\n<label class=\"flex cursor-pointer items-center justify-between py-[11px]\" data-kid=\"1-2-4-4-2\" data-name=\"Sousse option row\">\n<span class=\"text-[13.5px] leading-[18px] text-[#0C1626]\" data-kid=\"1-2-4-4-2-1\" data-name=\"option label Sousse\">Sousse</span>\n<span class=\"h-[18px] w-[18px] rounded-full border-[1.5px] border-[#D3DBE6]\" data-kid=\"1-2-4-4-2-2\" data-name=\"radio selection circle\"></span>\n</label>\n<label class=\"flex cursor-pointer items-center justify-between py-[11px]\" data-kid=\"1-2-4-4-3\" data-name=\"Sfax option row\">\n<span class=\"text-[13.5px] leading-[18px] text-[#0C1626]\" data-kid=\"1-2-4-4-3-1\" data-name=\"option label Sfax\">Sfax</span>\n<span class=\"h-[18px] w-[18px] rounded-full border-[1.5px] border-[#D3DBE6]\" data-kid=\"1-2-4-4-3-2\" data-name=\"radio selection circle\"></span>\n</label>\n</div>\n<button class=\"mt-2.5 h-12 w-full rounded-full bg-[#132B55] text-[15px] font-semibold text-white shadow-[0_14px_28px_-16px_rgba(19,43,85,0.95)] transition-colors duration-200 hover:bg-[#0B1B33]\" data-kid=\"1-2-4-5\" data-name='primary \"View Details\" call-to-action button' type=\"button\">View Details</button>\n</section>\n</div>\n</div>",
