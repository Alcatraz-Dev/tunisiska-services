      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n  .rk{font-family:'Rubik',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;}\n</style>\n<div class=\"rk min-h-[1000px] w-full bg-gradient-to-b from-[#E7E4F4] via-[#F4F2FB] to-[#E9EEF8] px-10 pb-16 pt-12\" data-kid=\"1\" data-name=\"page layout container with gradient background\">\n<div class=\"mx-auto flex w-[298px] items-center gap-3 rounded-full bg-[#08080A] px-2.5 py-2.5 shadow-[0_26px_50px_-24px_rgba(8,8,10,0.75)]\" data-kid=\"1-1\" data-name=\"departure status pill card\">\n<img alt=\"Tunisiska Mega Transport truck, photo by R9 Media Photo Collective on Pexels\" class=\"h-[42px] w-[42px] rounded-full object-cover\" data-kid=\"1-1-1\" data-name=\"brand truck thumbnail avatar\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/40292015/pexels-photo-40292015.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200&amp;q=80\"/>\n<div class=\"flex-1 leading-none\" data-kid=\"1-1-2\" data-name=\"departure details text block\">\n<p class=\"text-[10px] font-medium uppercase tracking-[0.08em] text-white/50\" data-kid=\"1-1-2-1\" data-name=\"departure status label\">Next departure</p>\n<p class=\"mt-1.5 text-[13px] font-semibold leading-none text-white\" data-kid=\"1-1-2-2\" data-name=\"departure date and time\">15 Nov · 14:00</p>\n<p class=\"mt-1 text-[10.5px] leading-none text-white/60\" data-kid=\"1-1-2-3\" data-name=\"route origin destination text\">Sweden → Tunisia</p>\n</div>\n<svg aria-hidden=\"true\" class=\"mr-1 h-[34px] w-[34px] -rotate-90\" data-kid=\"1-1-3\" data-name=\"orange progress ring icon\" viewbox=\"0 0 44 44\">\n<circle cx=\"22\" cy=\"22\" fill=\"none\" r=\"18\" stroke=\"#2C2C2E\" stroke-width=\"4\"></circle>\n<circle cx=\"22\" cy=\"22\" fill=\"none\" r=\"18\" stroke=\"#F2761B\" stroke-dasharray=\"113\" stroke-dashoffset=\"40\" stroke-linecap=\"round\" stroke-width=\"4\"></circle>\n</svg>\n</div>\n<div class=\"mt-10 flex items-start justify-center gap-16\" data-kid=\"1-2\" data-name=\"phone mockup row container\">\n<!-- Expanded presentation over Home -->\n<div class=\"relative h-[700px] w-[338px] rounded-[54px] bg-[#0A1A2F] p-[9px] shadow-[0_50px_80px_-40px_rgba(11,27,51,0.65)]\" data-kid=\"1-2-1\" data-name=\"phone frame mockup false\">\n<div class=\"relative h-full w-full overflow-hidden rounded-[45px] bg-[#F7F9FC]\" data-kid=\"1-2-1-1\" data-name=\"phone screen container\">\n<div class=\"pt-[112px]\" data-kid=\"1-2-1-1-1\" data-name=\"app screen content area\">\n<div class=\"flex items-start justify-between px-4\" data-kid=\"1-2-1-1-1-1\" data-name=\"app top header bar\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"brand logo group\">\n<svg aria-hidden=\"true\" data-kid=\"1-2-1-1-1-1-1-1\" data-name=\"plane trajectory logo icon\" fill=\"none\" height=\"26\" viewbox=\"0 0 48 36\" width=\"34\">\n<path d=\"M6 27C9 13 23 5 37 7.5\" stroke=\"#132B55\" stroke-linecap=\"round\" stroke-width=\"6\"></path>\n<path d=\"M31.5 1.5 43.5 6.4 37.8 17.2Z\" fill=\"#132B55\"></path>\n<path d=\"M9.5 30.5C18 24.5 29 22.2 39.5 22.4\" stroke=\"#F2761B\" stroke-linecap=\"round\" stroke-width=\"5\"></path>\n</svg>\n<div class=\"leading-none\" data-kid=\"1-2-1-1-1-1-1-2\" data-name=\"brand name text block\">\n<p class=\"text-[14px] font-bold tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-2-1-1-1-1-1-2-1\" data-name=\"brand company name\">Tunisiska Mega</p>\n<p class=\"mt-1 text-[11.5px] text-[#55627A]\" data-kid=\"1-2-1-1-1-1-1-2-2\" data-name=\"brand service subtitle\">Transport</p>\n</div>\n</div>\n<span class=\"flex h-8 w-8 items-center justify-center rounded-full border border-[#E4E9F0] bg-white text-[16px] text-[#132B55]\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"notification bell button\">\n<i class=\"ti ti-bell\" data-kid=\"1-2-1-1-1-1-2-1\" data-name=\"bell icon\"></i>\n</span>\n</div>\n<div class=\"relative px-4 pt-4\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline section\">\n<h1 class=\"max-w-[218px] text-[25px] font-extrabold leading-[29px] tracking-[-0.7px] text-[#0C1626]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"hero headline text\">Your transport between Sweden and Tunisia</h1>\n<span class=\"absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-[#E4E9F0] bg-white text-[17px] text-[#132B55]\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"plane status button\">\n<i class=\"ti ti-plane-tilt -rotate-12\" data-kid=\"1-2-1-1-1-2-2-1\" data-name=\"tilted plane icon\"></i>\n</span>\n</div>\n<div class=\"relative mt-3\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero image container\">\n<img alt=\"Tunisiska Mega Transport truck on the road, photo by R9 Media Photo Collective on Pexels\" class=\"h-[148px] w-full object-cover\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"hero truck image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/40292015/pexels-photo-40292015.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=700&amp;q=80\"/>\n<div class=\"pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-[#F7F9FC] via-[#F7F9FC]/45 to-transparent\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"hero image bottom fade gradient\"></div>\n</div>\n<div class=\"relative z-10 -mt-6 grid grid-cols-2 gap-2.5 px-4\" data-kid=\"1-2-1-1-1-4\" data-name=\"route options grid\">\n<div class=\"rounded-[18px] border border-[#E4E9F0] bg-white p-3 shadow-[0_14px_26px_-20px_rgba(12,22,38,0.55)]\" data-kid=\"1-2-1-1-1-4-1\" data-name=\"Sweeden to Tunisia route card\">\n<img alt=\"Flag of Sweden\" class=\"h-[19px] w-[28px] rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-2-1-1-1-4-1-1\" data-name=\"Swedish flag image\" decoding=\"async\" height=\"19\" loading=\"lazy\" src=\"https://flagcdn.com/w80/se.png\" width=\"28\"/>\n<p class=\"mt-2.5 text-[16px] font-bold leading-[19px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-2-1-1-1-4-1-2\" data-name=\"origin country name\">Sweden</p>\n<p class=\"text-[12px] leading-[15px] text-[#AEB9C9]\" data-kid=\"1-2-1-1-1-4-1-3\" data-name=\"route direction arrow text\">→</p>\n<p class=\"text-[16px] font-bold leading-[19px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-2-1-1-1-4-1-4\" data-name=\"destination country name\">Tunisia</p>\n<span class=\"mt-2.5 flex h-[30px] w-[30px] items-center justify-center self-end rounded-full bg-[#132B55] text-[13px] text-white\" data-kid=\"1-2-1-1-1-4-1-5\" data-name=\"route card call-to-action button\">\n<i class=\"ti ti-arrow-right\" data-kid=\"1-2-1-1-1-4-1-5-1\" data-name=\"arrow right icon\"></i>\n</span>\n</div>\n<div class=\"rounded-[18px] border border-[#E4E9F0] bg-white p-3 shadow-[0_14px_26px_-20px_rgba(12,22,38,0.55)]\" data-kid=\"1-2-1-1-1-4-2\" data-name=\"Tunisia to Sweden route card\">\n<img alt=\"Flag of Tunisia\" class=\"h-[19px] w-[28px] rounded-[3px] object-cover ring-1 ring-black/5\" data-kid=\"1-2-1-1-1-4-2-1\" data-name=\"Tunisian flag image\" decoding=\"async\" height=\"19\" loading=\"lazy\" src=\"https://flagcdn.com/w80/tn.png\" width=\"28\"/>\n<p class=\"mt-2.5 text-[16px] font-bold leading-[19px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-2-1-1-1-4-2-2\" data-name=\"origin country name\">Tunisia</p>\n<p class=\"text-[12px] leading-[15px] text-[#AEB9C9]\" data-kid=\"1-2-1-1-1-4-2-3\" data-name=\"route direction arrow text\">→</p>\n<p class=\"text-[16px] font-bold leading-[19px] tracking-[-0.3px] text-[#0C1626]\" data-kid=\"1-2-1-1-1-4-2-4\" data-name=\"destination country name\">Sweden</p>\n<span class=\"mt-2.5 flex h-[30px] w-[30px] items-center justify-center self-end rounded-full bg-[#132B55] text-[13px] text-white\" data-kid=\"1-2-1-1-1-4-2-5\" data-name=\"route card call-to-action button\">\n<i class=\"ti ti-arrow-right\" data-kid=\"1-2-1-1-1-4-2-5-1\" data-name=\"arrow right icon\"></i>\n</span>\n</div>\n</div>\n<div class=\"mx-4 mt-3 flex items-center gap-3 rounded-[18px] border border-[#E4E9F0] bg-white p-3\" data-kid=\"1-2-1-1-1-5\" data-name=\"next departure info card\">\n<span class=\"flex h-9 w-9 items-center justify-center rounded-[11px] bg-[#F2F5FA] text-[17px] text-[#132B55]\" data-kid=\"1-2-1-1-1-5-1\" data-name=\"calendar icon container\">\n<i class=\"ti ti-calendar\" data-kid=\"1-2-1-1-1-5-1-1\" data-name=\"calendar icon\"></i>\n</span>\n<span class=\"flex-1 leading-none\" data-kid=\"1-2-1-1-1-5-2\" data-name=\"departure info text block\">\n<span class=\"block text-[11.5px] leading-[14px] text-[#55627A]\" data-kid=\"1-2-1-1-1-5-2-1\" data-name=\"departure info label\">Next departure</span>\n<span class=\"mt-1 block text-[14px] font-bold leading-[18px] tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-2-1-1-1-5-2-2\" data-name=\"departure date and time text\">15 November · 14:00</span>\n</span>\n<i class=\"ti ti-chevron-right text-[16px] text-[#8A97AC]\" data-kid=\"1-2-1-1-1-5-3\" data-name=\"chevron right icon\"></i>\n</div>\n</div>\n<div class=\"absolute inset-x-0 bottom-0 border-t border-[#E4E9F0] bg-white px-2 pb-4 pt-2.5\" data-kid=\"1-2-1-1-2\" data-name=\"bottom navigation bar\">\n<div class=\"grid grid-cols-4\" data-kid=\"1-2-1-1-2-1\" data-name=\"bottom nav item grid\">\n<div class=\"flex flex-col items-center gap-1.5 text-[#F2761B]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"home navigation item\">\n<i class=\"ti ti-home text-[19px] leading-none\" data-kid=\"1-2-1-1-2-1-1-1\" data-name=\"home icon\"></i>\n<span class=\"text-[9.5px] font-semibold leading-none\" data-kid=\"1-2-1-1-2-1-1-2\" data-name=\"home navigation label\">Home</span>\n</div>\n<div class=\"flex flex-col items-center gap-1.5 text-[#8A97AC]\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"triips navigation item\">\n<i class=\"ti ti-calendar text-[19px] leading-none\" data-kid=\"1-2-1-1-2-1-2-1\" data-name=\"calendar icon\"></i>\n<span class=\"text-[9.5px] font-medium leading-none\" data-kid=\"1-2-1-1-2-1-2-2\" data-name=\"triips navigation label\">Trips</span>\n</div>\n<div class=\"flex flex-col items-center gap-1.5 text-[#8A97AC]\" data-kid=\"1-2-1-1-2-1-3\" data-name=\"news navigation item\">\n<i class=\"ti ti-file-text text-[19px] leading-none\" data-kid=\"1-2-1-1-2-1-3-1\" data-name=\"document icon\"></i>\n<span class=\"text-[9.5px] font-medium leading-none\" data-kid=\"1-2-1-1-2-1-3-2\" data-name=\"news navigation label\">News</span>\n</div>\n<div class=\"flex flex-col items-center gap-1.5 text-[#8A97AC]\" data-kid=\"1-2-1-1-2-1-4\" data-name=\"profile navigation item\">\n<i class=\"ti ti-user text-[19px] leading-none\" data-kid=\"1-2-1-1-2-1-4-1\" data-name=\"user icon\"></i>\n<span class=\"text-[9.5px] font-medium leading-none\" data-kid=\"1-2-1-1-2-1-4-2\" data-name=\"profile navigation label\">Profile</span>\n</div>\n</div>\n</div>\n<!-- Expanded Dynamic Island -->\n<div class=\"absolute left-1/2 top-2.5 w-[304px] -translate-x-1/2 rounded-[34px] bg-[#08080A] p-3.5 shadow-[0_30px_60px_-25px_rgba(8,8,10,0.8)]\" data-kid=\"1-2-1-1-3\" data-name=\"expanded dynamic island widget\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-3-1\" data-name=\"dynamic island content row\">\n<img alt=\"Tunisiska Mega Transport truck, photo by R9 Media Photo Collective on Pexels\" class=\"h-[46px] w-[46px] rounded-[12px] object-cover\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"brand truck thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/40292015/pexels-photo-40292015.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200&amp;q=80\"/>\n<div class=\"flex-1 leading-none\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"dynamic island departure info\">\n<p class=\"text-[10px] font-medium uppercase tracking-[0.08em] text-white/45\" data-kid=\"1-2-1-1-3-1-2-1\" data-name=\"dynamic island status label\">Next departure</p>\n<p class=\"mt-1.5 text-[15px] font-semibold leading-none tracking-[-0.2px] text-white\" data-kid=\"1-2-1-1-3-1-2-2\" data-name=\"dynamic island departure time\">15 Nov · 14:00</p>\n<p class=\"mt-1.5 flex items-center gap-1.5 text-[11px] leading-none text-white/55\" data-kid=\"1-2-1-1-3-1-2-3\" data-name=\"dynamic island route with location\">\n<i class=\"ti ti-map-pin text-[12px]\" data-kid=\"1-2-1-1-3-1-2-3-1\" data-name=\"map pin icon\"></i>\n                Stockholm → Tunis\n              </p>\n</div>\n<svg aria-hidden=\"true\" class=\"h-[40px] w-[40px] -rotate-90\" data-kid=\"1-2-1-1-3-1-3\" data-name=\"orange progress ring icon\" viewbox=\"0 0 52 52\">\n<circle cx=\"26\" cy=\"26\" fill=\"none\" r=\"21\" stroke=\"#2C2C2E\" stroke-width=\"4.5\"></circle>\n<circle cx=\"26\" cy=\"26\" fill=\"none\" r=\"21\" stroke=\"#F2761B\" stroke-dasharray=\"132\" stroke-dashoffset=\"47\" stroke-linecap=\"round\" stroke-width=\"4.5\"></circle>\n</svg>\n</div>\n</div>\n</div>\n</div>\n<!-- Lock Screen presentation -->\n<div class=\"relative h-[700px] w-[338px] rounded-[54px] bg-[#0A1A2F] p-[9px] shadow-[0_50px_80px_-40px_rgba(11,27,51,0.65)]\" data-kid=\"1-2-2\" data-name=\"lock screen phone mockup\">\n<div class=\"relative h-full w-full overflow-hidden rounded-[45px]\" data-kid=\"1-2-2-1\" data-name=\"lock screen background and content\">\n<img alt=\"Stockholm skyline at dusk, photo by Damir K on Pexels\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-2-2-1-1\" data-name=\"lock screen wallpaper image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/38776778/pexels-photo-38776778.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n<div class=\"absolute inset-0 bg-gradient-to-b from-[#050B14]/60 via-[#050B14]/30 to-[#050B14]/80\" data-kid=\"1-2-2-1-2\" data-name=\"lock screen darkening overlay\"></div>\n<div class=\"absolute inset-x-0 top-0 flex items-center justify-between px-6 pt-3.5\" data-kid=\"1-2-2-1-3\" data-name=\"status bar row\">\n<span class=\"text-[14px] font-semibold tracking-[-0.2px] text-white\" data-kid=\"1-2-2-1-3-1\" data-name=\"status bar clock time\">22:41</span>\n<div class=\"flex items-center gap-1.5 text-white text-[14px] leading-none\" data-kid=\"1-2-2-1-3-2\" data-name=\"system status icons group\">\n<i class=\"ti ti-antenna-bars-5\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"mobile signal icon\"></i>\n<i class=\"ti ti-wifi\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"wifi icon\"></i>\n<i class=\"ti ti-battery-3\" data-kid=\"1-2-2-1-3-2-3\" data-name=\"battery icon\"></i>\n</div>\n</div>\n<div class=\"absolute inset-x-0 top-[86px] flex flex-col items-center\" data-kid=\"1-2-2-1-4\" data-name=\"lock screen clock widget\">\n<i class=\"ti ti-lock text-[15px] leading-none text-white/70\" data-kid=\"1-2-2-1-4-1\" data-name=\"lock padlock icon\"></i>\n<p class=\"mt-2 text-[64px] font-light leading-[66px] tracking-[-1.5px] text-white\" data-kid=\"1-2-2-1-4-2\" data-name=\"lock screen large time\">22:41</p>\n<p class=\"mt-1 text-[14px] leading-[18px] text-white/85\" data-kid=\"1-2-2-1-4-3\" data-name=\"lock screen date\">Saturday, 15 November</p>\n</div>\n<div class=\"absolute inset-x-3.5 top-[352px] rounded-[24px] bg-white/92 p-3.5 shadow-[0_30px_60px_-30px_rgba(5,11,20,0.9)] backdrop-blur\" data-kid=\"1-2-2-1-5\" data-name=\"lock screen departure notification card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-5-1\" data-name=\"notification primary row\">\n<img alt=\"Tunisiska Mega Transport truck, photo by R9 Media Photo Collective on Pexels\" class=\"h-[42px] w-[42px] rounded-[11px] object-cover\" data-kid=\"1-2-2-1-5-1-1\" data-name=\"brand truck thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/40292015/pexels-photo-40292015.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200&amp;q=80\"/>\n<div class=\"flex-1 leading-none\" data-kid=\"1-2-2-1-5-1-2\" data-name=\"notification departure details\">\n<p class=\"text-[10px] font-semibold uppercase tracking-[0.08em] text-[#8A97AC]\" data-kid=\"1-2-2-1-5-1-2-1\" data-name=\"notification status label\">Next departure</p>\n<p class=\"mt-1.5 text-[15px] font-bold leading-none tracking-[-0.2px] text-[#0C1626]\" data-kid=\"1-2-2-1-5-1-2-2\" data-name=\"notification departure time\">15 Nov · 14:00</p>\n<p class=\"mt-1.5 text-[11.5px] leading-none text-[#55627A]\" data-kid=\"1-2-2-1-5-1-2-3\" data-name=\"notification route text\">Sweden → Tunisia</p>\n</div>\n<svg aria-hidden=\"true\" class=\"h-[36px] w-[36px] -rotate-90\" data-kid=\"1-2-2-1-5-1-3\" data-name=\"orange progress ring icon\" viewbox=\"0 0 48 48\">\n<circle cx=\"24\" cy=\"24\" fill=\"none\" r=\"19\" stroke=\"#E4E9F0\" stroke-width=\"4.5\"></circle>\n<circle cx=\"24\" cy=\"24\" fill=\"none\" r=\"19\" stroke=\"#F2761B\" stroke-dasharray=\"119\" stroke-dashoffset=\"43\" stroke-linecap=\"round\" stroke-width=\"4.5\"></circle>\n</svg>\n</div>\n<div class=\"mt-3 flex items-center justify-between rounded-[13px] bg-[#F2F5FA] px-3 py-2\" data-kid=\"1-2-2-1-5-2\" data-name=\"notification route and mode bar\">\n<span class=\"flex items-center gap-1.5 text-[10.5px] leading-none text-[#55627A]\" data-kid=\"1-2-2-1-5-2-1\" data-name=\"route endpoints text\">\n<i class=\"ti ti-map-pin text-[12px]\" data-kid=\"1-2-2-1-5-2-1-1\" data-name=\"map pin icon\"></i>\n              Stockholm → Tunis\n            </span>\n<span class=\"flex items-center gap-1.5 text-[10.5px] font-semibold leading-none text-[#132B55]\" data-kid=\"1-2-2-1-5-2-2\" data-name=\"transport mode label\">\n<i class=\"ti ti-truck text-[12px]\" data-kid=\"1-2-2-1-5-2-2-1\" data-name=\"truck icon\"></i>\n              Truck\n            </span>\n</div>\n</div>\n<div class=\"absolute inset-x-4 bottom-8 flex items-center justify-between\" data-kid=\"1-2-2-1-6\" data-name=\"lock screen quick action buttons\">\n<span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-[17px] text-white backdrop-blur\" data-kid=\"1-2-2-1-6-1\" data-name=\"flight action button\">\n<i class=\"ti ti-plane-tilt\" data-kid=\"1-2-2-1-6-1-1\" data-name=\"plane icon\"></i>\n</span>\n<span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-[17px] text-white backdrop-blur\" data-kid=\"1-2-2-1-6-2\" data-name=\"package action button\">\n<i class=\"ti ti-package\" data-kid=\"1-2-2-1-6-2-1\" data-name=\"package icon\"></i>\n</span>\n</div>\n<div class=\"absolute inset-x-0 bottom-2.5 flex justify-center\" data-kid=\"1-2-2-1-7\" data-name=\"home indicator container\">\n<span class=\"h-[4px] w-[110px] rounded-full bg-white/80\" data-kid=\"1-2-2-1-7-1\" data-name=\"home indicator bar\"></span>\n</div>\n</div>\n</div>\n</div>\n</div>",
