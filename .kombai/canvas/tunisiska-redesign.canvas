      "html": "\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap');\n*{box-sizing:border-box}body{margin:0}.rk{font-family:Rubik,system-ui,sans-serif;color:#0C1626;-webkit-font-smoothing:antialiased}\n:root{--navy:#132B55;--navy2:#1E3E75;--orange:#F2761B;--ink:#0C1626;--muted:#55627A;--soft:#8A97AC;--line:#E4E9F0;--canvas:#F4F6FA;--surface:#fff;--radius:20px}\n.i{width:18px;height:18px;display:inline-block;vertical-align:middle}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8A97AC}.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:0 2px 8px rgba(6,16,31,.05)}\n</style>\n\n<div class=\"rk\" style=\"width:393px;height:852px;background:#F4F6FA;display:flex;flex-direction:column;overflow:hidden\" data-kid=\"1\" data-name=\"Tunisiska app landing screen\">\n<div style=\"height:31px;padding:9px 25px 0;display:flex;justify-content:space-between;color:#0C1626;font-size:12px;font-weight:700\" data-kid=\"1-1\" data-name=\"Status bar\"><span data-kid=\"auto-10\">9:41</span><span data-kid=\"auto-11\"><svg width=\"48\" height=\"14\" viewBox=\"0 0 48 14\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M1 12V9h3v3H1Zm5 0V6h3v6H6Zm5 0V3h3v9h-3Z\"/><path d=\"M19 5.2a7.1 7.1 0 0 1 10 0M21.5 7.8a3.6 3.6 0 0 1 5 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"24\" cy=\"10.5\" r=\".9\"/><rect x=\"34\" y=\"3\" width=\"11\" height=\"8\" rx=\"1.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><rect x=\"36\" y=\"5\" width=\"7\" height=\"4\"/></svg></span></div>\n<header style=\"padding:15px 21px 12px;display:flex;align-items:center;justify-content:space-between\" data-kid=\"1-2\" data-name=\"Landing header\"><div style=\"display:flex;align-items:center;gap:10px\" data-kid=\"auto-12\"><div style=\"width:36px;height:36px;border-radius:12px;background:#132B55;color:#fff;display:grid;place-items:center\" data-kid=\"auto-13\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-14\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><div data-kid=\"auto-15\"><div style=\"font-size:14px;font-weight:700\" data-kid=\"auto-16\">Tunisiska Mega</div><div style=\"font-size:10px;color:#55627A;margin-top:2px\" data-kid=\"auto-17\">Transport</div></div></div><button style=\"width:40px;height:40px;border:1px solid #E4E9F0;border-radius:50%;background:#fff;color:#132B55;display:grid;place-items:center\" data-kid=\"auto-18\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-19\"><path d=\"M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4\"/></svg></button></header>\n<main style=\"flex:1;overflow:hidden;padding:6px 20px 8px\" data-kid=\"1-3\" data-name=\"Landing page main content\">\n<section style=\"border-radius:22px;background:linear-gradient(135deg,#132B55,#0B1B33);padding:21px 20px;color:white;position:relative;overflow:hidden\" data-kid=\"1-3-1\" data-name=\"Welcome hero\"><div style=\"position:absolute;width:185px;height:185px;border-radius:50%;border:1px solid rgba(255,255,255,.12);right:-66px;top:-79px\" data-kid=\"auto-20\"></div><div style=\"font-size:10px;font-weight:700;letter-spacing:.12em;color:#C7D3E6\" data-kid=\"auto-21\">SWEDEN ↔ TUNISIA</div><h1 style=\"font-size:24px;line-height:1.2;letter-spacing:-.5px;margin:11px 0 7px;max-width:245px\" data-kid=\"auto-22\">Your journey starts here.</h1><p style=\"font-size:11px;line-height:1.5;color:#D9E2F1;margin:0;max-width:250px\" data-kid=\"auto-23\">Book transport, follow shipments and keep every trip in view.</p><div style=\"display:flex;gap:8px;margin-top:17px\" data-kid=\"auto-24\"><button style=\"height:36px;padding:0 13px;border:0;border-radius:12px;background:#F2761B;color:#fff;font-size:11px;font-weight:700\" data-kid=\"auto-25\">Explore trips</button><button style=\"height:36px;padding:0 13px;border:1px solid rgba(255,255,255,.3);border-radius:12px;background:transparent;color:#fff;font-size:11px;font-weight:600\" data-kid=\"auto-26\">Our services</button></div><svg style=\"position:absolute;right:17px;bottom:16px;width:62px;height:44px;color:rgba(255,255,255,.26)\" viewBox=\"0 0 64 44\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"auto-27\"><path d=\"M3 34h58l-7-19H15L3 34Z\"/><path d=\"M15 15l6-9h22l11 9M15 34v5m35-5v5\"/><circle cx=\"18\" cy=\"36\" r=\"4\"/><circle cx=\"47\" cy=\"36\" r=\"4\"/></svg></section>\n<div style=\"display:flex;justify-content:space-between;align-items:center;margin:20px 1px 10px\" data-kid=\"auto-28\"><div data-kid=\"auto-29\"><div style=\"font-size:16px;font-weight:700\" data-kid=\"auto-30\">Choose your direction</div><div style=\"font-size:10px;color:#55627A;margin-top:3px\" data-kid=\"auto-31\">Scheduled trips between both countries</div></div><span style=\"font-size:10px;font-weight:700;color:#F2761B\" data-kid=\"auto-32\">View all</span></div>\n<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px\" data-kid=\"1-3-2\" data-name=\"Direction selector cards\"><div class=\"card\" style=\"padding:13px\" data-kid=\"auto-33\"><div style=\"width:29px;height:29px;border-radius:10px;background:#F2F5FA;color:#132B55;display:grid;place-items:center;font-size:15px;font-weight:700\" data-kid=\"auto-34\">SE</div><div style=\"font-size:12px;font-weight:700;margin-top:10px\" data-kid=\"auto-35\">Sweden <span style=\"color:#F2761B\" data-kid=\"auto-36\">→</span> Tunisia</div><div style=\"font-size:10px;color:#55627A;margin-top:4px\" data-kid=\"auto-37\">From Stockholm</div></div><div class=\"card\" style=\"padding:13px\" data-kid=\"auto-38\"><div style=\"width:29px;height:29px;border-radius:10px;background:#FFF4EC;color:#D65E0A;display:grid;place-items:center;font-size:15px;font-weight:700\" data-kid=\"auto-39\">TN</div><div style=\"font-size:12px;font-weight:700;margin-top:10px\" data-kid=\"auto-40\">Tunisia <span style=\"color:#F2761B\" data-kid=\"auto-41\">→</span> Sweden</div><div style=\"font-size:10px;color:#55627A;margin-top:4px\" data-kid=\"auto-42\">From Tunis</div></div></div>\n<div style=\"display:flex;justify-content:space-between;align-items:center;margin:19px 1px 9px\" data-kid=\"auto-43\"><div style=\"font-size:16px;font-weight:700\" data-kid=\"auto-44\">Next departure</div><span style=\"font-size:10px;font-weight:700;color:#F2761B\" data-kid=\"auto-45\">Departure board</span></div>\n<section style=\"padding:14px;border-radius:18px;background:white;border:1px solid #E4E9F0;box-shadow:0 2px 8px rgba(6,16,31,.05)\" data-kid=\"1-3-3\" data-name=\"Next departure feature card\"><div style=\"display:flex;align-items:center;gap:7px\" data-kid=\"auto-46\"><span style=\"width:7px;height:7px;border-radius:50%;background:#F2761B\" data-kid=\"auto-47\"></span><span style=\"font-size:9px;font-weight:700;letter-spacing:.1em;color:#8A97AC\" data-kid=\"auto-48\">SATURDAY · 15 NOVEMBER</span><span style=\"margin-left:auto;padding:5px 8px;border-radius:99px;background:#E7F5EE;color:#147A48;font-size:9px;font-weight:700\" data-kid=\"auto-49\">24 SPACES</span></div><div style=\"font-size:16px;font-weight:700;margin-top:9px\" data-kid=\"auto-50\">Sweden <span style=\"color:#F2761B\" data-kid=\"auto-51\">→</span> Tunisia</div><div style=\"display:flex;align-items:center;font-size:10px;color:#55627A;margin-top:5px\" data-kid=\"auto-52\"><span data-kid=\"auto-53\">Stockholm → Tunis</span><span style=\"margin-left:auto;color:#132B55;font-weight:700\" data-kid=\"auto-54\">14:00</span></div><div style=\"height:1px;background:#E4E9F0;margin:11px 0 8px\" data-kid=\"auto-55\"></div><div style=\"display:flex;align-items:center;gap:6px;font-size:10px;color:#55627A\" data-kid=\"auto-56\"><svg class=\"i\" style=\"width:14px;height:14px;color:#132B55\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-57\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg><span data-kid=\"auto-58\">Cargo van</span><span style=\"margin-left:auto;font-weight:700;color:#132B55\" data-kid=\"auto-59\">View trip <span style=\"color:#F2761B\" data-kid=\"auto-60\">›</span></span></div></section>\n<div style=\"display:flex;justify-content:space-between;align-items:center;margin:18px 1px 9px\" data-kid=\"auto-61\"><div style=\"font-size:16px;font-weight:700\" data-kid=\"auto-62\">Services</div><span style=\"font-size:10px;color:#F2761B;font-weight:700\" data-kid=\"auto-63\">See all</span></div><div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:8px\" data-kid=\"1-3-4\" data-name=\"Service shortcuts\"><div class=\"card\" style=\"padding:11px 5px;text-align:center\" data-kid=\"auto-64\"><div style=\"color:#132B55\" data-kid=\"auto-65\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-66\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><path d=\"M6 16v2m12-2v2M7 10l2-4h7l3 4\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><div style=\"font-size:9px;font-weight:600;margin-top:7px\" data-kid=\"auto-67\">Shipping</div></div><div class=\"card\" style=\"padding:11px 5px;text-align:center\" data-kid=\"auto-68\"><div style=\"color:#F2761B\" data-kid=\"auto-69\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-70\"><path d=\"M5 20V8l7-5 7 5v12M3 20h18M9 20v-6h6v6\"/></svg></div><div style=\"font-size:9px;font-weight:600;margin-top:7px\" data-kid=\"auto-71\">Moving</div></div><div class=\"card\" style=\"padding:11px 5px;text-align:center\" data-kid=\"auto-72\"><div style=\"color:#132B55\" data-kid=\"auto-73\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-74\"><path d=\"M3 16h18l-2-6H6l-3 6Z\"/><circle cx=\"7\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg></div><div style=\"font-size:9px;font-weight:600;margin-top:7px\" data-kid=\"auto-75\">Taxi</div></div><div class=\"card\" style=\"padding:11px 5px;text-align:center\" data-kid=\"auto-76\"><div style=\"color:#F2761B\" data-kid=\"auto-77\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-78\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg></div><div style=\"font-size:9px;font-weight:600;margin-top:7px\" data-kid=\"auto-79\">More</div></div></div>\n</main>\n<nav style=\"height:67px;flex-shrink:0;background:#fff;border-top:1px solid #E4E9F0;display:flex;justify-content:space-around;align-items:center;padding-bottom:8px\" data-kid=\"1-4\" data-name=\"Bottom tab navigation\"><div style=\"display:grid;justify-items:center;gap:4px;color:#F2761B;font-size:9px;font-weight:700\" data-kid=\"auto-80\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" data-kid=\"auto-81\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z\"/></svg>Home</div><div style=\"display:grid;justify-items:center;gap:4px;color:#8A97AC;font-size:9px;font-weight:600\" data-kid=\"auto-82\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-83\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 9h18\"/></svg>Trips</div><div style=\"display:grid;justify-items:center;gap:4px;color:#8A97AC;font-size:9px;font-weight:600\" data-kid=\"auto-84\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-85\"><path d=\"M4 5h16v14H4zM8 9h8M8 13h8\"/></svg>News</div><div style=\"display:grid;justify-items:center;gap:4px;color:#8A97AC;font-size:9px;font-weight:600\" data-kid=\"auto-86\"><svg class=\"i\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" data-kid=\"auto-87\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/></svg>Profile</div></nav></div>\n",
