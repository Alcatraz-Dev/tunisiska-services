      "html": "<div class=\"flex min-h-[844px] w-full flex-col bg-[#F4F6FA] text-[#0C1626] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Rubik',ui-sans-serif,system-ui,sans-serif\">\n<style>@import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800&display=swap');</style>\n<style>@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");</style>\n<style>@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css\");</style>\n<!-- status bar -->\n<div class=\"flex items-center justify-between px-5 pb-1 pt-3.5\" data-kid=\"1-1\" data-name=\"status bar with time and indicators\">\n<span class=\"text-[15px] font-bold tracking-[-0.2px]\" data-kid=\"1-1-1\" data-name=\"status bar clock time\">9:41</span>\n<div class=\"flex items-center gap-1.5\" data-kid=\"1-1-2\" data-name=\"status bar system icons group\">\n<span class=\"flex items-end gap-[2px]\" data-kid=\"1-1-2-1\" data-name=\"cellular signal bar chart\">\n<span class=\"h-[4px] w-[3px] rounded-[1px] bg-[#0C1626]\" data-kid=\"1-1-2-1-1\" data-name=\"signal bar (low)\"></span>\n<span class=\"h-[6px] w-[3px] rounded-[1px] bg-[#0C1626]\" data-kid=\"1-1-2-1-2\" data-name=\"signal bar (medium low)\"></span>\n<span class=\"h-[8px] w-[3px] rounded-[1px] bg-[#0C1626]\" data-kid=\"1-1-2-1-3\" data-name=\"signal bar (medium high)\"></span>\n<span class=\"h-[10px] w-[3px] rounded-[1px] bg-[#0C1626]/25\" data-kid=\"1-1-2-1-4\" data-name=\"signal bar (unreached)\"></span>\n</span>\n<i class=\"ph ph-wifi-high text-[15px] text-[#0C1626]\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\"></i>\n<span class=\"ml-0.5 flex h-[11px] w-[23px] items-center rounded-[3px] border border-[#0C1626]/30 p-[1.5px]\" data-kid=\"1-1-2-3\" data-name=\"battery indicator with fill\">\n<span class=\"block h-full w-[72%] rounded-[1.5px] bg-[#0C1626]\" data-kid=\"1-1-2-3-1\" data-name=\"battery charge fill level\"></span>\n</spa